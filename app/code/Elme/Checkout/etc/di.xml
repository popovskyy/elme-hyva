<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <preference for="Elme\Checkout\Api\CheckoutManagementInterface" type="Elme\Checkout\Model\CheckoutManagement"/>
    <preference for="Elme\Checkout\Api\Data\CheckoutStateInterface" type="Elme\Checkout\Model\CheckoutState"/>

    <!-- Sections of the checkout state; the item name is the section code. See README.md -->
    <type name="Elme\Checkout\Model\StateBuilder">
        <arguments>
            <argument name="providers" xsi:type="array">
                <item name="summary" xsi:type="array">
                    <item name="sortOrder" xsi:type="number">10</item>
                    <item name="provider" xsi:type="object">Elme\Checkout\Model\Section\SummaryProvider</item>
                </item>
                <item name="address" xsi:type="array">
                    <item name="sortOrder" xsi:type="number">20</item>
                    <item name="provider" xsi:type="object">Elme\Checkout\Model\Section\AddressProvider</item>
                </item>
                <item name="delivery" xsi:type="array">
                    <item name="sortOrder" xsi:type="number">30</item>
                    <item name="provider" xsi:type="object">Elme\Checkout\Model\Section\DeliveryProvider</item>
                </item>
                <item name="payment" xsi:type="array">
                    <item name="sortOrder" xsi:type="number">40</item>
                    <item name="provider" xsi:type="object">Elme\Checkout\Model\Section\PaymentProvider</item>
                </item>
                <item name="details" xsi:type="array">
                    <item name="sortOrder" xsi:type="number">50</item>
                    <item name="provider" xsi:type="object">Elme\Checkout\Model\Section\DetailsProvider</item>
                </item>
            </argument>
        </arguments>
    </type>

    <type name="Magento\Quote\Api\CartRepositoryInterface">
        <plugin name="elme_checkout_quote_details_extension" type="Elme\Checkout\Plugin\QuoteDetailsExtensionPlugin"/>
    </type>
    <type name="Magento\Sales\Api\OrderRepositoryInterface">
        <plugin name="elme_checkout_order_details_extension" type="Elme\Checkout\Plugin\OrderDetailsExtensionPlugin"/>
    </type>

    <!-- The order grid table is filled from sales_order -->
    <virtualType name="Magento\Sales\Model\ResourceModel\Order\Grid" type="Magento\Sales\Model\ResourceModel\Grid">
        <arguments>
            <argument name="columns" xsi:type="array">
                <item name="customer_reference" xsi:type="string">sales_order.customer_reference</item>
                <item name="delivery_instructions" xsi:type="string">sales_order.delivery_instructions</item>
            </argument>
        </arguments>
    </virtualType>

    <!-- Checks before place order; the item name identifies the check. See README.md -->
    <type name="Elme\Checkout\Model\PlaceOrderValidatorPool">
        <arguments>
            <argument name="validators" xsi:type="array">
                <item name="logged_in" xsi:type="object">Elme\Checkout\Model\Validator\CustomerLoggedIn</item>
                <item name="addresses" xsi:type="object">Elme\Checkout\Model\Validator\AddressesComplete</item>
                <item name="delivery_method" xsi:type="object">Elme\Checkout\Model\Validator\DeliveryMethodSelected</item>
                <item name="payment_method" xsi:type="object">Elme\Checkout\Model\Validator\PaymentMethodSelected</item>
                <item name="agreements" xsi:type="object">Elme\Checkout\Model\Validator\AgreementsAccepted</item>
            </argument>
        </arguments>
    </type>

    <!-- Total segments with their own row block in checkout_index_index.xml; others use the generic row -->
    <type name="Elme\Checkout\Model\Section\TotalsMapper">
        <arguments>
            <argument name="rowTitles" xsi:type="array">
                <item name="subtotal" xsi:type="string">Subtotal (ex GST)</item>
                <item name="shipping" xsi:type="string">Shipping</item>
                <item name="tax" xsi:type="string">GST</item>
                <item name="grand_total" xsi:type="string">Total (incl GST)</item>
            </argument>
        </arguments>
    </type>
</config>
