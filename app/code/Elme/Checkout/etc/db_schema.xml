<?xml version="1.0"?>
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
    <table name="quote" resource="checkout">
        <column xsi:type="varchar" name="customer_reference" nullable="true" length="30"
                comment="Customer order reference / PO number"/>
        <column xsi:type="varchar" name="delivery_instructions" nullable="true" length="250"
                comment="Delivery instructions"/>
    </table>
    <table name="sales_order" resource="sales">
        <column xsi:type="varchar" name="customer_reference" nullable="true" length="30"
                comment="Customer order reference / PO number"/>
        <column xsi:type="varchar" name="delivery_instructions" nullable="true" length="250"
                comment="Delivery instructions"/>
    </table>
    <table name="sales_order_grid" resource="sales">
        <column xsi:type="varchar" name="customer_reference" nullable="true" length="30"
                comment="Customer order reference / PO number"/>
        <column xsi:type="varchar" name="delivery_instructions" nullable="true" length="250"
                comment="Delivery instructions"/>
    </table>
</schema>
