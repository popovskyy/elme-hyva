<?php

declare(strict_types=1);

use Elme\Checkout\ViewModel\OrderDetails;
use Magento\Backend\Block\Template;
use Magento\Framework\Escaper;

/** @var Template $block */
/** @var Escaper $escaper */
/** @var OrderDetails $viewModel */

$viewModel = $block->getData('view_model');
$reference = $viewModel->getCustomerReference();
$instructions = $viewModel->getDeliveryInstructions();

// Rows of the Account Information table
?>
<?php if ($reference !== ''): ?>
    <tr>
        <th><?= $escaper->escapeHtml(__('Customer reference / PO')) ?></th>
        <td><?= $escaper->escapeHtml($reference) ?></td>
    </tr>
<?php endif; ?>
<?php if ($instructions !== ''): ?>
    <tr>
        <th><?= $escaper->escapeHtml(__('Delivery instructions')) ?></th>
        <td><?= /* @noEscape */ nl2br($escaper->escapeHtml($instructions)) ?></td>
    </tr>
<?php endif; ?>
