<?php

declare(strict_types=1);

use Elme\Checkout\ViewModel\OrderDetails;
use Hyva\Theme\Model\ViewModelRegistry;
use Magento\Framework\Escaper;

/** @var Escaper $escaper */
/** @var ViewModelRegistry $viewModels */

$details = $viewModels->require(OrderDetails::class);
$instructions = $details->getDeliveryInstructions();

if ($instructions === '') {
    return;
}
?>
<dl class="min-w-0 pt-4" data-order-details>
    <dt class="mb-1 font-semibold"><?= $escaper->escapeHtml(__('Delivery instructions')) ?></dt>
    <dd class="break-words whitespace-pre-line"><?= $escaper->escapeHtml($instructions) ?></dd>
</dl>
