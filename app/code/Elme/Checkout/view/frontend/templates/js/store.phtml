<?php

declare(strict_types=1);

use Hyva\Theme\ViewModel\HyvaCsp;
use Magento\Framework\Escaper;

/** @var Escaper $escaper */
/** @var HyvaCsp $hyvaCsp */
?>
<script>
    /**
     * Alpine.store('elmeCheckout'): the checkout state and the one way to change it. Section components only read
     * from here; call() posts to elme_checkout/action/<action> and replaces the whole state with the answer.
     */
    function elmeCheckoutStore() {
        const root = document.getElementById('elme-checkout');
        const state = JSON.parse(root.dataset.state);

        return {
            state,
            actionUrl: root.dataset.actionUrl,
            loading: {},
            queue: Promise.resolve(),
            picks: {},
            sectionErrors: state.errors,
            fieldErrors: {},
            message: '',
            errorSection: '',
            acceptedAgreements: {},
            beforePlaceOrderChecks: [],
            placing: false,
            leaving: false,

            section(code) {
                return this.state.sections[code] || null;
            },
            sectionError(code) {
                return this.sectionErrors[code] || '';
            },
            fieldError(field) {
                return this.fieldErrors[field] || '';
            },
            clearFieldError(field) {
                delete this.fieldErrors[field];
            },
            clearSectionError(code) {
                delete this.sectionErrors[code];
            },
            isAgreementAccepted(id) {
                return Boolean(this.acceptedAgreements[id]);
            },
            setAgreementAccepted(id, accepted) {
                this.acceptedAgreements[id] = accepted;
            },
            isPlacing() {
                return this.placing;
            },
            isLoading(code) {
                return Boolean(this.loading[code]);
            },

            pickedCode(sectionCode) {
                return this.picks[sectionCode]?.code;
            },

            /**
             * Runs one action at a time: every answer is a full state, so the answer to the last change must land last.
             *
             * @param {string} action e.g. "state", the last part of the controller URL
             * @param {Object} data sent as JSON in the "data" field
             * @param {string} sectionCode section that shows the loading flag and takes the errors
             * @returns {Promise<boolean>} true when the server accepted the change
             */
            call(action, data = {}, sectionCode = '') {
                // A change after Place order would land on a cart that is an order by then.
                // state is allowed while placing: recovery after a lost place-order answer.
                if (this.placing && action !== 'placeorder' && action !== 'state') {
                    return Promise.resolve(false);
                }

                return this.enqueue(action, data, sectionCode);
            },

            enqueue(action, data, sectionCode) {
                const result = this.queue.then(() => this.send(action, data, sectionCode));
                this.queue = result;

                return result;
            },

            /**
             * For a section that saves while the customer types: its last change must reach the order.
             *
             * @param {function(): Promise<boolean>} check runs with the placing flag up, so it sends with enqueue();
             *     false stops the order and the section shows why
             */
            onBeforePlaceOrder(check) {
                this.beforePlaceOrderChecks.push(check);
            },

            /**
             * For a radio list that saves on every pick: arrow keys walk through the radios and each step is a pick.
             * While one save runs only the latest pick is kept, so the last one always wins.
             *
             * @param {string} action
             * @param {string} code what the list shows as checked until the save is done, see pickedCode()
             * @param {Object} data
             * @param {string} sectionCode
             */
            async pick(action, code, data, sectionCode) {
                const isSaving = Boolean(this.picks[sectionCode]);
                this.picks[sectionCode] = {code, data};
                if (isSaving) {
                    return;
                }

                let current;
                let saved;
                do {
                    current = this.picks[sectionCode];
                    saved = await this.call(action, current.data, sectionCode);
                } while (saved && this.picks[sectionCode] !== current);

                delete this.picks[sectionCode];
            },

            /**
             * The flag goes up before anything else, so double clicks and Enter spam send one request. It stays up while
             * the browser goes to the success page. Changes made just before still go first, through the queue of call().
             */
            async placeOrder() {
                if (this.placing) {
                    return;
                }
                this.placing = true;

                const checks = await Promise.all(this.beforePlaceOrderChecks.map((check) => check()));
                if (checks.every(Boolean)) {
                    const agreements = Object.keys(this.acceptedAgreements).filter((id) => this.acceptedAgreements[id]);
                    const placed = await this.call('placeorder', {agreements}, 'placeorder');
                    // Answer lost after the order was created: state redirects to success when the session has it
                    if (!placed && !this.leaving) {
                        const message = this.message;
                        const fieldErrors = this.fieldErrors;
                        const sectionErrors = this.sectionErrors;
                        const errorSection = this.errorSection;
                        await this.call('state');
                        if (!this.leaving) {
                            this.message = message;
                            this.fieldErrors = fieldErrors;
                            this.sectionErrors = sectionErrors;
                            this.errorSection = errorSection;
                        }
                    }
                }

                if (!this.leaving) {
                    this.placing = false;
                    this.showError();
                }
            },

            /**
             * Takes the customer to what the server refused: the first invalid field of the section (else its first
             * control, else the section itself), or the message at the top. x-show reveals in a timeout of its own, which
             * nextTick does not wait for, and a hidden element takes no focus: look again each frame until it is there.
             */
            showError(framesLeft = 20) {
                requestAnimationFrame(() => {
                    const root = this.errorSection
                        ? document.querySelector(`[data-checkout-section="${this.errorSection}"]`)
                        : document.getElementById('elme-checkout-message');
                    const isShown = (element) => element.getClientRects().length > 0;
                    if (!root || !isShown(root)) {
                        if (framesLeft > 0) {
                            this.showError(framesLeft - 1);
                        }
                        return;
                    }

                    const target = [...root.querySelectorAll('[aria-invalid="true"]')].find(isShown)
                        || [...root.querySelectorAll('input, select, textarea, button')].find(isShown)
                        || root;
                    if (target === root) {
                        root.setAttribute('tabindex', '-1');
                    }

                    const behavior = window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth';
                    root.scrollIntoView({block: 'start', behavior});
                    target.focus({preventScroll: true});
                });
            },

            async send(action, data, sectionCode) {
                this.loading[sectionCode] = true;
                this.fieldErrors = {};
                this.message = '';
                this.errorSection = '';

                // Place order talks to payment / ERP and may sit longer than a section save
                const timeoutMs = action === 'placeorder' ? 60000 : 20000;
                const controller = new AbortController();
                const timer = window.setTimeout(() => controller.abort(), timeoutMs);

                try {
                    const response = await fetch(`${this.actionUrl}${action}`, {
                        method: 'POST',
                        credentials: 'same-origin',
                        headers: {'Accept': 'application/json', 'X-Requested-With': 'XMLHttpRequest'},
                        body: new URLSearchParams({form_key: hyva.getFormKey(), data: JSON.stringify(data)}),
                        signal: controller.signal
                    });
                    const result = await response.json();

                    if (result.redirect) {
                        this.leaving = true;
                        window.location.assign(result.redirect);
                        return false;
                    }
                    if (result.ok) {
                        this.state = result.state;
                        this.sectionErrors = result.state.errors;
                        return true;
                    }

                    if (result.state) {
                        this.state = result.state;
                        this.sectionErrors = result.state.errors;
                    }
                    this.fieldErrors = result.field_errors || {};
                    if (result.section) {
                        this.sectionErrors = {...this.sectionErrors, [result.section]: result.message};
                        this.errorSection = result.section;
                    } else {
                        this.message = result.message;
                    }
                } catch (error) {
                    this.message = '<?= $escaper->escapeJs(__('Something went wrong. Please try again.')) ?>';
                } finally {
                    window.clearTimeout(timer);
                    this.loading[sectionCode] = false;
                }

                return false;
            }
        };
    }

    /**
     * A Place order button; there is one at the end of the sections and one in the bar for phones.
     */
    function elmeCheckoutPlaceOrderButton() {
        return {
            isPlacing() {
                return Alpine.store('elmeCheckout').isPlacing();
            },
            isIdle() {
                return !this.isPlacing();
            },
            ariaBusy() {
                return this.isPlacing() ? 'true' : 'false';
            },
            place() {
                Alpine.store('elmeCheckout').placeOrder();
            }
        };
    }

    window.addEventListener('alpine:init', () => {
        Alpine.store('elmeCheckout', elmeCheckoutStore());
        Alpine.data('elmeCheckoutPlaceOrderButton', elmeCheckoutPlaceOrderButton);
    }, {once: true});

    // A page restored from the back/forward cache may show an old cart, and may still be on its way to the success page
    window.addEventListener('pageshow', (event) => {
        if (event.persisted) {
            const store = Alpine.store('elmeCheckout');
            store.placing = false;
            store.leaving = false;
            store.call('state');
        }
    });
</script>
<?php $hyvaCsp->registerInlineScript() ?>
