/** @var HyvaCsp $hyvaCsp */
?>
<section class="elme-checkout-section scroll-mt-4"
         data-checkout-section="address"
         x-data="elmeCheckoutAddress"
         :class="busyClass"
         :aria-busy="ariaBusy">
    <div class="elme-checkout-section__loader" x-show="isBusy" x-cloak aria-hidden="true">
        <span class="elme-spinner"></span>
    </div>

    <div class="elme-checkout-section__head">
        <span class="elme-checkout-section__step" aria-hidden="true">
            <?= (int) $block->getData('number') ?>
        </span>
        <h2 class="elme-checkout-section__title"><?= $escaper->escapeHtml(__('Address')) ?></h2>
    </div>

    <p class="elme-checkout-section__error" role="alert" x-show="error" x-cloak x-text="error"></p>

    <div class="elme-checkout-section__body">
        <div class="elme-checkout-line" x-show="isShippingDone" x-cloak>
            <p class="min-w-0">
                <span class="font-semibold"><?= $escaper->escapeHtml(__('Deliver to:')) ?></span>
                <span x-text="shippingLine"></span>
            </p>
            <button type="button"
                    class="elme-checkout-link"
                    x-ref="changeShipping"
                    aria-label="<?= $escaper->escapeHtmlAttr(__('Change delivery address')) ?>"
                    @click="openShipping">
                <?= $escaper->escapeHtml(__('Change')) ?>
            </button>
        </div>

        <div x-show="isShippingOpen" x-cloak x-ref="shippingList">
            <h3 class="mb-3 font-sans text-copy font-semibold text-ink"><?= $escaper->escapeHtml(__('Delivery address')) ?></h3>
            <?= $block->getChildHtml('shipping_cards') ?>
            <div class="mt-4 flex flex-wrap items-center gap-4" x-show="canAddAddress">
                <button type="button" class="btn btn-primary" x-show="canFinishShipping" @click="closeShipping">
                    <?= $escaper->escapeHtml(__('Done')) ?>
                </button>
                <button type="button"
                        class="elme-checkout-link"
                        aria-controls="elme-checkout-address-form"
                        @click="openForm">
                    <?= $escaper->escapeHtml(__('Add a new address')) ?>
                </button>
            </div>
            <div id="elme-checkout-address-form">
                <?= $block->getChildHtml('form') ?>
            </div>
