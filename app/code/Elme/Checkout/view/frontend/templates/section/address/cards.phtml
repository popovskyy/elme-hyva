<?php

declare(strict_types=1);

use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;

/** @var Template $block */
/** @var Escaper $escaper */

$group = (string) $block->getData('group');
?>
<fieldset>
    <legend class="sr-only"><?= $escaper->escapeHtml($block->getData('legend')) ?></legend>
    <div class="elme-checkout-options elme-checkout-options--addresses">
        <template x-for="address in cards" :key="address.id" data-group="<?= $escaper->escapeHtmlAttr($group) ?>">
            <label class="elme-checkout-option">
                <input type="radio"
                       class="elme-checkout-option__control"
                       name="<?= $escaper->escapeHtmlAttr($group) ?>_address_id"
                       data-group="<?= $escaper->escapeHtmlAttr($group) ?>"
                       :value="address.id"
                       :checked="isChecked"
                       @change="pick">
                <span class="elme-checkout-option__body">
                    <span class="elme-checkout-option__title" x-text="address.name"></span>
                    <span class="block" x-show="address.company" x-text="address.company"></span>
                    <span class="block" x-text="address.street"></span>
                    <span class="block" x-text="address.locality"></span>
                    <span class="elme-checkout-option__meta" x-show="address.telephone" x-text="address.telephone"></span>
                </span>
            </label>
        </template>
    </div>
</fieldset>
