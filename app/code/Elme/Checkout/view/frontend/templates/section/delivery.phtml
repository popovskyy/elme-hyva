<?php

declare(strict_types=1);

use Elme\Theme\ViewModel\StoreContact;
use Hyva\Theme\Model\ViewModelRegistry;
use Hyva\Theme\ViewModel\HeroiconsOutline;
use Hyva\Theme\ViewModel\HyvaCsp;
use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;

/** @var Template $block */
/** @var Escaper $escaper */
/** @var ViewModelRegistry $viewModels */
/** @var HyvaCsp $hyvaCsp */

$contact = $viewModels->require(StoreContact::class);
$heroicons = $viewModels->require(HeroiconsOutline::class);
?>
<section class="elme-checkout-section scroll-mt-4"
         data-checkout-section="delivery"
         x-data="elmeCheckoutDelivery"
         :class="busyClass"
         :aria-busy="ariaBusy">
    <div class="elme-checkout-section__loader" x-show="isBusy" x-cloak aria-hidden="true">
        <span class="elme-spinner"></span>
    </div>

    <div class="elme-checkout-section__head">
        <span class="elme-checkout-section__step" :class="stepClass" aria-hidden="true">
            <span class="elme-checkout-section__step-number"><?= (int) $block->getData('number') ?></span>
            <?= $heroicons->checkHtml('elme-checkout-section__step-check', 14, 14, ['aria-hidden' => 'true']) ?>
        </span>
        <h2 class="elme-checkout-section__title"><?= $escaper->escapeHtml(__('Delivery')) ?></h2>
    </div>

    <p class="elme-checkout-section__error" role="alert" x-show="error" x-cloak x-text="error"></p>
    <p class="elme-checkout-section__hint" x-show="locked" x-cloak x-text="locked"></p>

    <p class="elme-checkout-section__body text-copy text-ink" x-show="hasNoRates" x-cloak>
        <?= $escaper->escapeHtml(__("We can't deliver to this address online, please call us")) ?>:
        <a class="elme-checkout-link" href="<?= $escaper->escapeUrl($contact->getPhoneTelHref()) ?>">
            <?= $escaper->escapeHtml($contact->getPhoneDisplay()) ?>
        </a>
    </p>

    <fieldset class="elme-checkout-section__body" x-show="hasRates" x-cloak>
        <legend class="sr-only"><?= $escaper->escapeHtml(__('Delivery method')) ?></legend>
        <div class="elme-checkout-options">
            <template x-for="rate in rates" :key="rate.code">
                <label class="elme-checkout-option">
                    <input type="radio"
                           class="elme-checkout-option__control"
                           name="delivery_method"
                           :value="rate.code"
                           :checked="isChecked"
                           @change="pick">
                    <span class="elme-checkout-option__body">
                        <span class="elme-checkout-option__title" x-text="rate.carrier_title"></span>
                        <span class="block" x-text="rate.method_title"></span>
                    </span>
                    <span class="elme-checkout-option__price">
                        <span class="elme-checkout-option__price-value" x-text="rate.price_formatted"></span>
                        <span class="elme-checkout-option__price-note"><?= $escaper->escapeHtml(__('ex GST')) ?></span>
                    </span>
                </label>
            </template>
        </div>
    </fieldset>
</section>
<script>
    function elmeCheckoutDelivery() {
        return {
            store() {
                return Alpine.store('elmeCheckout');
            },
            data() {
                return this.store().section('delivery') || {};
            },
            rates() {
                return this.data().rates || [];
            },
            error() {
                return this.store().sectionError('delivery');
            },
            locked() {
                return this.data().locked || '';
            },
            isBusy() {
                return this.store().isLoading('delivery');
            },
            ariaBusy() {
                return this.isBusy() ? 'true' : 'false';
            },
            stepClass() {
                return {'is-done': Boolean(this.data().selected)};
            },
            busyClass() {
                return {'is-busy': this.isBusy()};
            },
            hasRates() {
                return this.rates().length > 0;
            },
            hasNoRates() {
                return Boolean(this.store().section('delivery')) && !this.locked() && !this.hasRates();
            },
            isChecked() {
                return this.rate.code === (this.store().pickedCode('delivery') ?? this.data().selected);
            },
            pick() {
                this.store().pick(
                    'shippingmethod',
                    this.rate.code,
                    {carrier_code: this.rate.carrier_code, method_code: this.rate.method_code},
                    'delivery'
                );
            }
        };
    }
    window.addEventListener('alpine:init', () => Alpine.data('elmeCheckoutDelivery', elmeCheckoutDelivery), {once: true});
</script>
<?php $hyvaCsp->registerInlineScript() ?>
