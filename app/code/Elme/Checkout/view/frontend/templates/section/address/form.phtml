<?php

declare(strict_types=1);

use Elme\Checkout\ViewModel\AddressForm;
use Hyva\Theme\Model\ViewModelRegistry;
use Magento\Framework\Escaper;

/** @var Escaper $escaper */
/** @var ViewModelRegistry $viewModels */

$regions = $viewModels->require(AddressForm::class)->getRegions();

$fields = [
    ['name' => 'firstname', 'label' => __('First name'), 'autocomplete' => 'given-name', 'required' => true],
    ['name' => 'lastname', 'label' => __('Last name'), 'autocomplete' => 'family-name', 'required' => true],
    ['name' => 'company', 'label' => __('Company'), 'autocomplete' => 'organization', 'wide' => true],
    ['name' => 'street_1', 'label' => __('Street address'), 'autocomplete' => 'address-line1', 'required' => true, 'wide' => true],
    ['name' => 'street_2', 'label' => __('Street address line 2'), 'autocomplete' => 'address-line2', 'wide' => true],
    ['name' => 'city', 'label' => __('Suburb'), 'autocomplete' => 'address-level2', 'required' => true],
    ['name' => 'region_id', 'label' => __('State'), 'autocomplete' => 'address-level1', 'required' => true, 'options' => $regions],
    [
        'name' => 'postcode',
        'label' => __('Postcode'),
        'autocomplete' => 'postal-code',
        'required' => true,
        'attributes' => 'inputmode="numeric" maxlength="4" pattern="[0-9]{4}"',
    ],
    ['name' => 'telephone', 'label' => __('Phone'), 'autocomplete' => 'tel', 'required' => true, 'type' => 'tel'],
];
?>
<form class="elme-checkout-form"
      novalidate
      x-ref="addressForm"
      x-show="formOpen"
      x-cloak
      @submit.prevent="submitNew">
    <div class="grid gap-x-4 gap-y-3 md:grid-cols-2">
        <?php foreach ($fields as $field): ?>
            <?php
            $name = $escaper->escapeHtmlAttr($field['name']);
            $id = 'elme-checkout-address-' . $name;
            $required = !empty($field['required']);
            ?>
            <div class="field <?= $required ? 'required' : '' ?> <?= !empty($field['wide']) ? 'md:col-span-2' : '' ?>">
                <label class="label" for="<?= /* @noEscape */ $id ?>">
                    <?= $escaper->escapeHtml($field['label']) ?>
                </label>
                <?php if (isset($field['options'])): ?>
                    <?php // Skip the theme's custom select: browser autofill only fills a native one ?>
                    <select id="<?= /* @noEscape */ $id ?>"
                            class="form-select w-full"
                            data-elme-select-skip="1"
                            name="<?= /* @noEscape */ $name ?>"
                            autocomplete="<?= $escaper->escapeHtmlAttr($field['autocomplete']) ?>"
                            aria-describedby="<?= /* @noEscape */ $id ?>-error"
                            data-field="<?= /* @noEscape */ $name ?>"
                            :aria-invalid="fieldInvalid"
                            @change="clearFieldError"
                            required>
                        <option value=""><?= $escaper->escapeHtml(__('Please select')) ?></option>
                        <?php foreach ($field['options'] as $value => $label): ?>
                            <option value="<?= (int) $value ?>"><?= $escaper->escapeHtml($label) ?></option>
                        <?php endforeach; ?>
                    </select>
                <?php else: ?>
                    <input id="<?= /* @noEscape */ $id ?>"
                           class="form-input w-full"
                           type="<?= $escaper->escapeHtmlAttr($field['type'] ?? 'text') ?>"
                           name="<?= /* @noEscape */ $name ?>"
                           autocomplete="<?= $escaper->escapeHtmlAttr($field['autocomplete']) ?>"
                           aria-describedby="<?= /* @noEscape */ $id ?>-error"
                           data-field="<?= /* @noEscape */ $name ?>"
                           :aria-invalid="fieldInvalid"
                           @input="clearFieldError"
                           <?= /* @noEscape */ $field['attributes'] ?? '' ?>
                           <?= $required ? 'required' : '' ?>>
                <?php endif; ?>
                <p id="<?= /* @noEscape */ $id ?>-error"
                   class="field-error-message"
                   data-field="<?= /* @noEscape */ $name ?>"
                   x-show="fieldError"
                   x-text="fieldError"></p>
            </div>
        <?php endforeach; ?>
    </div>

    <div class="field choice mt-4">
        <input id="elme-checkout-address-save" type="checkbox" name="save_to_book" checked>
        <label for="elme-checkout-address-save"><?= $escaper->escapeHtml(__('Save to my address book')) ?></label>
    </div>

    <div class="mt-4 flex flex-wrap items-center gap-4">
        <button type="submit" class="btn btn-primary" :disabled="isBusy" :aria-busy="ariaBusy">
            <?= $escaper->escapeHtml(__('Use this address')) ?>
        </button>
        <button type="button" class="elme-checkout-link" x-show="canCloseForm" @click="closeForm">
            <?= $escaper->escapeHtml(__('Cancel')) ?>
        </button>
    </div>
</form>
