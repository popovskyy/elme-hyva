<?xml version="1.0"?>
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
    <table name="quick_order_list" resource="default" engine="innodb" comment="Quick Order lists of a customer">
        <column xsi:type="int" name="id" unsigned="true" nullable="false" identity="true" comment="List ID"/>
        <column xsi:type="int" name="customer_id" unsigned="true" nullable="false" identity="false"
                comment="Customer ID"/>
        <column xsi:type="varchar" name="name" nullable="false" length="255" comment="List name, cart_list is the cart"/>
        <column xsi:type="text" name="items" nullable="true" comment="JSON list of {sku, qty}"/>
        <column xsi:type="timestamp" name="created_at" nullable="false" default="CURRENT_TIMESTAMP"
                comment="Created at"/>
        <column xsi:type="timestamp" name="updated_at" nullable="false" on_update="true" default="CURRENT_TIMESTAMP"
                comment="Updated at"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="id"/>
        </constraint>
        <constraint xsi:type="unique" referenceId="QUICK_ORDER_LIST_CUSTOMER_ID_NAME">
            <column name="customer_id"/>
            <column name="name"/>
        </constraint>
        <constraint xsi:type="foreign" referenceId="QUICK_ORDER_LIST_CUSTOMER_ID_CUSTOMER_ENTITY_ENTITY_ID"
                    table="quick_order_list" column="customer_id" referenceTable="customer_entity"
                    referenceColumn="entity_id" onDelete="CASCADE"/>
    </table>
</schema>
