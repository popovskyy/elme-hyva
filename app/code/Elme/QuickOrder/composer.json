{
    "name": "elme/module-quick-order",
    "description": "Elme Living Quick Order cart: the customer's cart_list (sku + qty) is the cart, the quote is rebuilt from it at checkout",
    "type": "magento2-module",
    "require": {
        "php": "~8.3.0||~8.4.0",
        "magento/framework": "*",
        "magento/module-catalog": "*",
        "magento/module-checkout": "*",
        "magento/module-configurable-product": "*",
        "magento/module-customer": "*",
        "magento/module-inventory-sales-api": "*",
        "magento/module-quote": "*",
        "magento/module-sales": "*",
        "magento/module-store": "*",
        "magento/module-tax": "*",
        "elme/module-checkout": "*",
        "elme/module-login-only": "*",
        "elme/module-minimum-order": "*",
        "elme/module-qty-rules": "*",
        "elme/module-theme": "*"
    },
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "Elme\\QuickOrder\\": ""
        }
    }
}
