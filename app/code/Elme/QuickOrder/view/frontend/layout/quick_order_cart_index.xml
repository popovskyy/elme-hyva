<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" layout="1column"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceContainer name="content">
            <!-- Per customer, with a form key: never in the full page cache -->
            <block name="elme.quick-order.cart" template="Elme_QuickOrder::cart/page.phtml" cacheable="false">
                <block name="elme.quick-order.cart.save-status" as="save-status"
                       template="Elme_QuickOrder::cart/save-status.phtml"/>
            </block>
        </referenceContainer>
    </body>
</page>
