<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <!-- Magento's wish-list link is ifconfig=wishlist/general/active (off). Add Shopping List instead. -->
        <referenceBlock name="customer_account_navigation">
            <block class="Magento\Customer\Block\Account\SortLinkInterface"
                   name="customer-account-navigation-shopping-list-link">
                <arguments>
                    <argument name="path" xsi:type="string">quick-order/template</argument>
                    <argument name="label" xsi:type="string" translate="true">My Shopping List</argument>
                    <argument name="sortOrder" xsi:type="number">210</argument>
                </arguments>
            </block>
        </referenceBlock>
    </body>
</page>
