<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <!-- Before any component that reads window.elmeQuickOrderCart -->
        <referenceContainer name="after.body.start">
            <block name="elme.quick-order.cart-client" template="Elme_QuickOrder::js/cart-client.phtml"/>
            <!-- FE-78: window.elmeLists + window.elmeHearts, before the header and the list picker read them -->
            <block name="elme.quick-order.lists-store" template="Elme_QuickOrder::js/lists-store.phtml"/>
        </referenceContainer>
    </body>
</page>
