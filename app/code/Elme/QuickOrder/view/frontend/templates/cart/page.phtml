<?php
/**
 * Cart page on window.elmeQuickOrderCart. The save rules stay in the client and the server.
 */

declare(strict_types=1);

use Hyva\Theme\Model\ViewModelRegistry;
use Hyva\Theme\ViewModel\HyvaCsp;
use Hyva\Theme\ViewModel\LucideIcons;
use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;

/** @var Escaper $escaper */
/** @var Template $block */
/** @var ViewModelRegistry $viewModels */

/** @var HyvaCsp $hyvaCsp */
$hyvaCsp = $viewModels->require(HyvaCsp::class);
/** @var LucideIcons $lucideIcons */
$lucideIcons = $viewModels->require(LucideIcons::class);
$homeUrl = $block->getBaseUrl();
?>
<section class="elme-cart"
         x-data="initElmeQuickOrderCartPage"
         @elme-qo-cart.window="onCart"
         :class="savingClass">
    <div class="elme-cart__loading" x-show="isLoading" aria-busy="true">
        <p class="sr-only"><?= $escaper->escapeHtml(__('Loading your cart...')) ?></p>
        <div class="elme-cart__bone" aria-hidden="true">
            <span class="elme-cart__bone-photo"></span>
            <span class="elme-cart__bone-copy">
                <span class="elme-cart__bone-line"></span>
                <span class="elme-cart__bone-line"></span>
            </span>
        </div>
        <div class="elme-cart__bone" aria-hidden="true">
            <span class="elme-cart__bone-photo"></span>
            <span class="elme-cart__bone-copy">
                <span class="elme-cart__bone-line"></span>
                <span class="elme-cart__bone-line"></span>
            </span>
        </div>
    </div>
    <p class="elme-cart__error" role="alert" x-show="hasLoadError" x-text="loadError" x-cloak></p>

    <div class="elme-cart__empty" x-show="isEmpty" x-cloak>
        <p><?= $escaper->escapeHtml(__('Your cart is empty.')) ?></p>
        <a class="btn btn-primary" href="<?= $escaper->escapeUrl($homeUrl) ?>">
            <?= $escaper->escapeHtml(__('Continue shopping')) ?>
        </a>
    </div>

    <div class="elme-cart__layout" x-show="hasItems" x-cloak>
        <div>
            <div class="elme-cart__head">
                <span class="elme-cart__head-product"><?= $escaper->escapeHtml(__('Product')) ?></span>
                <span class="elme-cart__head-qty"><?= $escaper->escapeHtml(__('Qty')) ?></span>
                <span class="elme-cart__head-total"><?= $escaper->escapeHtml(__('Total')) ?></span>
            </div>
            <ul>
                <template x-for="item in items" :key="item.sku">
                    <li class="elme-cart__line">
                        <a class="elme-cart__photo" :href="item.url" x-show="hasUrl" tabindex="-1" aria-hidden="true">
                            <img :src="item.image" :alt="item.name" width="96" height="96" loading="lazy">
                        </a>
                        <div class="elme-cart__photo" x-show="hasNoUrl" aria-hidden="true">
                            <img :src="item.image" alt="" width="96" height="96" loading="lazy">
                        </div>

                        <div class="elme-cart__info">
                            <a class="elme-cart__name" :href="item.url" x-show="hasUrl" x-text="item.name"></a>
                            <p class="elme-cart__name" x-show="hasNoUrl" x-text="item.name"></p>
                            <p class="elme-cart__sku" x-text="item.sku"></p>
                            <p class="elme-cart__stock" :class="stockClass" x-show="hasStockLabel">
                                <span class="elme-cart__dot" aria-hidden="true"></span>
                                <span x-text="stockLabel"></span>
                            </p>
                            <p class="elme-cart__unit" x-show="hasPrice">
                                <span x-text="unitPrice"></span>
                                <s class="elme-cart__was" x-show="hasDiscount" x-text="regularPrice"></s>
                            </p>
                            <p class="elme-cart__message" role="alert" x-show="hasMessage" x-text="item.message"></p>
                            <div class="elme-cart__actions">
                                <button type="button" class="elme-cart__textbtn" @click="removeItem">
                                    <?= $escaper->escapeHtml(__('Remove')) ?>
                                </button>
                                <button type="button"
                                        class="elme-cart__textbtn"
                                        data-elme-qo-add-to-list
                                        :data-sku="item.sku"
                                        :data-qty="item.qty"
                                        :data-product-name="item.name">
                                    <?= $escaper->escapeHtml(__('Add to shopping list')) ?>
                                </button>
                            </div>
                        </div>

                        <div class="elme-cart__qty">
                            <div class="elme-qty">
                                <button type="button"
                                        class="elme-qty__btn"
                                        @click="decrement"
                                        :disabled="isAtMin"
                                        aria-label="<?= $escaper->escapeHtmlAttr(__('Decrease quantity')) ?>">
                                    <?= $lucideIcons->minusHtml('', 16, 16, ['aria-hidden' => 'true']) ?>
                                </button>
                                <label class="sr-only" :for="qtyId"><?= $escaper->escapeHtml(__('Qty')) ?></label>
                                <input type="number"
                                       class="elme-qty__input"
                                       inputmode="numeric"
                                       :id="qtyId"
                                       :value="item.qty"
                                       :min="item.min"
                                       :step="item.step"
                                       @change="onQtyChange">
                                <button type="button"
                                        class="elme-qty__btn"
                                        @click="increment"
                                        aria-label="<?= $escaper->escapeHtmlAttr(__('Increase quantity')) ?>">
                                    <?= $lucideIcons->plusHtml('', 16, 16, ['aria-hidden' => 'true']) ?>
                                </button>
                            </div>
                        </div>

                        <p class="elme-cart__row-total" x-text="rowTotal"></p>
                    </li>
                </template>
            </ul>
        </div>

        <aside class="elme-cart__summary">
            <h2 class="elme-cart__summary-title"><?= $escaper->escapeHtml(__('Summary')) ?></h2>
            <p class="elme-cart__summary-count" x-text="lineCountLabel"></p>
            <dl class="elme-cart__money">
                <div>
                    <dt><?= $escaper->escapeHtml(__('Subtotal (ex GST)')) ?></dt>
                    <dd x-text="totals.subtotal_formatted"></dd>
                </div>
                <div>
                    <dt><?= $escaper->escapeHtml(__('GST')) ?></dt>
                    <dd x-text="totals.gst_formatted"></dd>
                </div>
                <div class="elme-cart__money-total">
                    <dt><?= $escaper->escapeHtml(__('Total (inc GST)')) ?></dt>
                    <dd x-text="totals.total_formatted"></dd>
                </div>
            </dl>
            <p class="elme-cart__saving" aria-live="polite" x-show="saving" x-text="savingLabel" x-cloak></p>
            <button type="button"
                    class="btn btn-primary w-full justify-center"
                    @click="goToCheckout"
                    :disabled="cannotCheckout">
                <?= $escaper->escapeHtml(__('Proceed to checkout')) ?>
            </button>
            <a class="elme-cart__continue" href="<?= $escaper->escapeUrl($homeUrl) ?>">
                <?= $escaper->escapeHtml(__('Continue shopping')) ?>
            </a>
        </aside>
    </div>
</section>
<script>
    function initElmeQuickOrderCartPage() {
        return {
            cart: null,
            totals: {},
            saving: false,
            loadError: '',

            init() {
                window.elmeQuickOrderCart.load().catch((error) => {
                    this.loadError = error.message;
                });
            },

            onCart() {
                this.cart = this.$event.detail.cart;
                this.totals = (this.cart && this.cart.totals) || {};
                this.saving = this.$event.detail.saving;
            },

            items() {
                return this.cart ? this.cart.items : [];
            },
            isLoading() {
                return !this.cart && !this.loadError;
            },
            hasLoadError() {
                return Boolean(this.loadError);
            },
            isEmpty() {
                return Boolean(this.cart) && !this.cart.items.length;
            },
            hasItems() {
                return Boolean(this.cart) && this.cart.items.length > 0;
            },
            cannotCheckout() {
                return this.saving || !this.cart || !this.cart.can_checkout;
            },
            savingClass() {
                return this.saving ? 'is-saving' : '';
            },
            savingLabel() {
                return this.saving ? '<?= $escaper->escapeJs(__('Saving...')) ?>' : '';
            },
            lineCountLabel() {
                const count = this.items().length;
                return count === 1
                    ? '<?= $escaper->escapeJs(__('1 line')) ?>'
                    : hyva.str('<?= $escaper->escapeJs(__('%1 lines')) ?>', count);
            },

            qtyId() {
                return 'qo-qty-' + this.item.sku;
            },
            hasUrl() {
                return Boolean(this.item.url);
            },
            hasNoUrl() {
                return !this.item.url;
            },
            hasStockLabel() {
                return Boolean(this.item.stock && this.item.stock.qty_formatted);
            },
            stockClass() {
                const level = this.item.stock && this.item.stock.level;
                return level ? 'is-' + level : '';
            },
            stockLabel() {
                return hyva.str('<?= $escaper->escapeJs(__('%1 in stock')) ?>', this.item.stock.qty_formatted);
            },
            hasPrice() {
                return Boolean(this.item.price);
            },
            hasDiscount() {
                return Boolean(this.item.price && this.item.price.has_discount);
            },
            unitPrice() {
                return this.item.price
                    ? hyva.str('<?= $escaper->escapeJs(__('%1 each, ex GST')) ?>', this.item.price.final_formatted)
                    : '';
            },
            regularPrice() {
                return this.item.price ? this.item.price.regular_formatted : '';
            },
            hasMessage() {
                return Boolean(this.item.message);
            },
            // until the save answers, the row total follows the qty in the page
            rowTotal() {
                return this.item.price ? hyva.formatPrice(this.item.price.final * this.item.qty) : '';
            },
            isAtMin() {
                return this.item.qty <= this.item.min;
            },

            increment() {
                window.elmeQuickOrderCart.setQty(this.item.sku, this.item.qty + this.item.step);
            },
            decrement() {
                window.elmeQuickOrderCart.setQty(this.item.sku, Math.max(this.item.min, this.item.qty - this.item.step));
            },
            onQtyChange() {
                window.elmeQuickOrderCart.setQty(this.item.sku, hyva.safeParseNumber(this.$event.target.value));
            },
            removeItem() {
                window.elmeQuickOrderCart.remove(this.item.sku);
            },
            async goToCheckout() {
                const cart = await window.elmeQuickOrderCart.flush();
                if (cart && cart.can_checkout) {
                    window.location.assign('<?= $escaper->escapeJs($block->getUrl('checkout')) ?>');
                }
            }
        };
    }
    window.addEventListener('alpine:init', () => Alpine.data('initElmeQuickOrderCartPage', initElmeQuickOrderCartPage), {once: true});
</script>
<?php $hyvaCsp->registerInlineScript() ?>
