<script>
    function initElmeQuickOrderCartPage() {
        // how long "Saved" stays before the status goes back to "All changes saved"
        const SAVED_MS = 1400;
        const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
        let savedTimer = null;
        // the last cart the client sent; rows on their way out (removing) stay in the page until they collapsed
        let latest = null;

        /** The new number slides in from below (up) or above (down); fast token, ease-out-quart. */
        function tick(el, dir) {
            if (!el || !el.animate || !dir || reduceMotion.matches) {
                return;
            }
            const root = getComputedStyle(document.documentElement);
            el.animate([
                {transform: 'translateY(' + (dir > 0 ? '0.4em' : '-0.4em') + ')', opacity: 0},
                {transform: 'none', opacity: 1}
            ], {
                duration: parseFloat(root.getPropertyValue('--transition-duration-fast')) || 180,
                easing: root.getPropertyValue('--ease-out-quart').trim() || 'ease-out'
            });
        }

        return {
            cart: null,
            totals: {},
            saving: false,
            justSaved: false,
            leaving: false,
            loadError: '',
            // sku -> {item, index} of rows turning to dust
            removing: {},
            announcement: '',

            init() {
                window.elmeQuickOrderCart.load().catch((error) => {
                    this.loadError = error.message;
                });
            },

            onCart() {
                const detail = this.$event.detail;
                const wasSaving = this.saving;
                latest = detail;
                this.saving = detail.saving;

                clearTimeout(savedTimer);
                this.justSaved = false;
                if (wasSaving && !this.saving && !Object.keys(detail.errors || {}).length) {
                    this.justSaved = true;
                    savedTimer = setTimeout(() => {
                        this.justSaved = false;
                    }, SAVED_MS);
                }
                this.render();
            },

            /** The client's cart, with the rows on their way out kept in place; totals wait for the collapse. */
            render() {
                if (!latest) {
                    return;
                }
                let cart = latest.cart;
                const leaving = Object.keys(this.removing);
                if (cart && leaving.length) {
                    const items = cart.items.slice();
                    leaving.forEach((sku) => {
                        if (!items.some((item) => item.sku === sku)) {
                            const row = this.removing[sku];
                            items.splice(Math.min(row.index, items.length), 0, row.item);
                        }
                    });
                    cart = Object.assign({}, cart, {items: items});
                }
                this.cart = cart;
                if (!leaving.length) {
                    this.showTotals((cart && cart.totals) || {});
                }
            },

            showTotals(totals) {
                const before = Number(this.totals.total);
                this.totals = totals;
                const after = Number(totals.total);
                if (before && after && before !== after) {
                    this.$nextTick(() => {
                        tick(this.$refs.barTotal, after > before ? 1 : -1);
                        tick(this.$refs.summaryTotal, after > before ? 1 : -1);
                    });
                }
            },

            items() {
                return this.cart ? this.cart.items : [];
            },
            isLoading() {
                return !this.cart && !this.loadError;
            },
            hasLoadError() {
                return Boolean(this.loadError);
            },
            isEmpty() {
                return Boolean(this.cart) && !this.cart.items.length;
            },
            hasItems() {
                return Boolean(this.cart) && this.cart.items.length > 0;
            },
            cannotCheckout() {
                return this.saving || !this.cart || !this.cart.can_checkout;
            },
            checkoutBusy() {
                return this.leaving ? 'true' : false;
            },
            showMinimumOrder() {
                const mov = this.cart && this.cart.minimum_order;
                return Boolean(mov && mov.enabled && !mov.met);
            },
            minimumOrderHint() {
                const mov = this.cart && this.cart.minimum_order;
                if (!mov) {
                    return '';
                }
                return hyva.str(
                    '<?= $escaper->escapeJs(__('Add %1 more to place your order.')) ?>',
                    mov.remaining_formatted
                );
            },
            minimumOrderBarStyle() {
                const mov = this.cart && this.cart.minimum_order;
                if (!mov || !mov.minimum) {
                    return 'width: 0%';
                }
                const pct = Math.max(0, Math.min(100, Math.round((mov.subtotal / mov.minimum) * 100)));
                return 'width: ' + pct + '%';
            },
            checkoutTitle() {
                return this.showMinimumOrder() ? this.minimumOrderHint() : '';
            },
            savingClass() {
                return this.saving ? 'is-saving' : '';
            },
            saveState() {
                if (this.saving) {
                    return 'saving';
                }
                return this.justSaved ? 'saved' : 'idle';
            },
            // the live region speaks only real changes, never the idle text
            saveLabel() {
                if (this.saving) {
                    return '<?= $escaper->escapeJs(__('Saving...')) ?>';
                }
                return this.justSaved ? '<?= $escaper->escapeJs(__('Saved')) ?>' : '';
            },
            lineCountLabel() {
                const count = this.items().length;
                return count === 1
                    ? '<?= $escaper->escapeJs(__('1 line')) ?>'
                    : hyva.str('<?= $escaper->escapeJs(__('%1 lines')) ?>', count);
            },

            qtyId() {
                return 'qo-qty-' + this.item.sku;
            },
            removeLabel() {
                return hyva.str('<?= $escaper->escapeJs(__('Remove %1')) ?>', this.item.name);
            },
            hasUrl() {
                return Boolean(this.item.url);
            },
            hasNoUrl() {
                return !this.item.url;
            },
            hasStockLabel() {
                return Boolean(this.item.stock && this.item.stock.qty_formatted);
            },
            stockClass() {
                const level = this.item.stock && this.item.stock.level;
                return level ? 'is-' + level : '';
            },
            stockLabel() {
                return hyva.str('<?= $escaper->escapeJs(__('%1 in stock')) ?>', this.item.stock.qty_formatted);
            },
            hasPrice() {
                return Boolean(this.item.price);
            },
            hasDiscount() {
                return Boolean(this.item.price && this.item.price.has_discount);
            },
            unitPrice() {
                return this.item.price
                    ? hyva.str('<?= $escaper->escapeJs(__('%1 each, ex GST')) ?>', this.item.price.final_formatted)
                    : '';
            },
            regularPrice() {
                return this.item.price ? this.item.price.regular_formatted : '';
            },
            hasMessage() {
                return Boolean(this.item.message);
            },
            // until the save answers, the row total follows the qty in the page
            rowTotal() {
                return this.item.price ? hyva.formatPrice(this.item.price.final * this.item.qty) : '';
            },
            isAtMin() {
                return this.item.qty <= this.item.min;
            },

            /** Row total ticks as soon as the qty changes in the page. */
            tickRow(from, dir) {
                const row = from && from.closest('li');
                this.$nextTick(() => tick(row && row.querySelector('.elme-cart__tick'), dir));
            },

            increment() {
                this.tickRow(this.$event.currentTarget, 1);
                window.elmeQuickOrderCart.setQty(this.item.sku, this.item.qty + this.item.step);
            },
            decrement() {
                this.tickRow(this.$event.currentTarget, -1);
                window.elmeQuickOrderCart.setQty(this.item.sku, Math.max(this.item.min, this.item.qty - this.item.step));
            },
            onQtyChange() {
                const qty = hyva.safeParseNumber(this.$event.target.value);
                this.tickRow(this.$event.target, qty > this.item.qty ? 1 : -1);
                window.elmeQuickOrderCart.setQty(this.item.sku, qty);
            },
            /**
             * Asks first. The delete goes to the server at once while the row turns to dust; the row leaves the
             * list (and the totals change) after its gap has closed. A failed save brings the row back.
             */
            async removeItem() {
                const trigger = this.$event.currentTarget;
                const sku = this.item.sku;
                const name = this.item.name;
                if (this.removing[sku]) {
                    return;
                }
                const confirmed = await window.elmeConfirm({
                    title: hyva.str('<?= $escaper->escapeJs(__('Remove %1 from your cart?')) ?>', name),
                    confirmLabel: '<?= $escaper->escapeJs(__('Remove')) ?>',
                    trigger: trigger
                });
                const items = this.items();
                const index = items.findIndex((item) => item.sku === sku);
                if (!confirmed || index < 0 || this.removing[sku]) {
                    return;
                }
                this.removing[sku] = {item: JSON.parse(JSON.stringify(items[index])), index: index};
                const row = trigger.closest('.elme-cart__line');
                const gone = window.elmeDust.dissolve(row);
                window.elmeDust.focusNext(
                    row,
                    trigger.classList.contains('elme-cart__trash') ? '.elme-cart__trash' : '.elme-cart__remove-text',
                    document.querySelector('h1')
                );
                const saved = window.elmeQuickOrderCart.remove(sku);
                await gone;
                const ok = await saved;
                delete this.removing[sku];
                this.render();
                if (ok) {
                    this.announcement = hyva.str('<?= $escaper->escapeJs(__('%1 removed from your cart.')) ?>', name);
                } else {
                    await window.elmeDust.restore(row, trigger);
                }
            },
            async goToCheckout() {
                if (this.leaving) {
                    return;
                }
                this.leaving = true;
                let going = false;
                try {
                    const cart = await window.elmeQuickOrderCart.flush();
                    if (cart && cart.can_checkout) {
                        going = true;
                        window.location.assign('<?= $escaper->escapeJs($block->getUrl('checkout')) ?>');
                    }
                } finally {
                    if (!going) {
                        this.leaving = false;
                    }
                }
            }
        };
    }
    window.addEventListener('alpine:init', () => Alpine.data('initElmeQuickOrderCartPage', initElmeQuickOrderCartPage), {once: true});
</script>
<?php $hyvaCsp->registerInlineScript() ?>
