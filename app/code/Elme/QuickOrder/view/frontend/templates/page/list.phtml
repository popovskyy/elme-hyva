                                        <button type="button"
                                                class="elme-qty__btn"
                                                @click="increment"
                                                aria-label="<?= $escaper->escapeHtmlAttr(__('Increase quantity')) ?>">
                                            <?= $lucideIcons->plusHtml('', 16, 16, ['aria-hidden' => 'true']) ?>
                                        </button>
                                    </div>
                                </div>
                                <p class="elme-cart__row-total" x-text="rowTotal"></p>
                            </li>
                        </template>
                    </ul>
                </div>
                <aside class="elme-cart__summary">
                    <h2 class="elme-cart__summary-title"><?= $escaper->escapeHtml(__('List')) ?></h2>
                    <p class="elme-cart__summary-count" x-text="lineCountLabel"></p>
                    <dl class="elme-cart__money">
                        <div>
                            <dt><?= $escaper->escapeHtml(__('Subtotal (ex GST)')) ?></dt>
                            <dd x-text="totals.subtotal_formatted"></dd>
                        </div>
                        <div>
                            <dt><?= $escaper->escapeHtml(__('GST')) ?></dt>
                            <dd x-text="totals.gst_formatted"></dd>
                        </div>
                        <div class="elme-cart__money-total">
                            <dt><?= $escaper->escapeHtml(__('Total (inc GST)')) ?></dt>
                            <dd x-text="totals.total_formatted"></dd>
                        </div>
                    </dl>
                    <p class="elme-cart__saving" aria-live="polite" x-show="saving" x-text="savingLabel" x-cloak></p>
                    <button type="button"
                            class="btn btn-primary w-full justify-center"
                            @click="addAll"
                            :disabled="cannotAdd">
                        <?= $escaper->escapeHtml(__('Add to cart')) ?>
                    </button>
                    <a class="elme-cart__continue" href="<?= $escaper->escapeUrl($block->getUrl('quick_order/cart')) ?>">
                        <?= $escaper->escapeHtml(__('View cart')) ?>
                    </a>
                </aside>
            </div>
        </div>
    <?php endif; ?>
</section>
<script>
    function initElmeShoppingList() {
        const listName = '<?= $escaper->escapeJs($listName) ?>';
        const getUrl = '<?= $escaper->escapeJs($block->getUrl('quick_order/list/get')) ?>';
        const saveUrl = '<?= $escaper->escapeJs($block->getUrl('quick_order/list/save')) ?>';
        const cartSaveUrl = '<?= $escaper->escapeJs($block->getUrl('quick_order/cart/save')) ?>';
        const here = '<?= $escaper->escapeJs($block->getUrl('quick_order')) ?>';
        const failed = '<?= $escaper->escapeJs(__('Could not save the list.')) ?>';
        const added = '<?= $escaper->escapeJs(__('Added to your cart.')) ?>';
        const nameRequired = '<?= $escaper->escapeJs(__('List name is required.')) ?>';

        return {
            listName: listName,
            isNew: listName === '',
            newName: '',
            skuQuery: '',
            addQty: '1',
            list: null,
            totals: {},
            found: null,
            saving: false,
            loadError: '',
            timer: null,

            init() {
                if (!this.isNew) {
                    this.load();
                }
            },

            async load() {
                try {
                    const url = new URL(getUrl, window.location.origin);
                    url.searchParams.set('name', this.listName);
                    const response = await fetch(url.toString(), {
                        cache: 'no-store',
                        headers: {'X-Requested-With': 'XMLHttpRequest', 'Accept': 'application/json'}
                    });
                    const data = await response.json();
                    if (!data.success) {
                        throw new Error(data.message || failed);
                    }
                    this.found = !!data.found;
                    this.list = data.list || {items: [], totals: {}};
                    this.totals = this.list.totals || {};
                    this.loadError = '';
                } catch (error) {
                    this.loadError = error.message;
                    this.found = null;
                }
            },

            items() {
                return this.list && this.list.items ? this.list.items : [];
            },
            isLoading() {
                return !this.isNew && this.found === null && !this.loadError;
            },
            hasLoadError() {
                return Boolean(this.loadError);
            },
            isMissing() {
                return this.found === false;
            },
            isReady() {
                return this.found === true;
            },
            isEmpty() {
                return this.isReady() && this.items().length === 0;
            },
            hasItems() {
                return this.items().length > 0;
            },
            cannotAdd() {
                return this.saving || !this.items().some((item) => item.available);
            },
            savingClass() {
                return this.saving ? 'is-saving' : '';
            },
            savingLabel() {
                return this.saving ? '<?= $escaper->escapeJs(__('Saving...')) ?>' : '';
            },
            lineCountLabel() {
                const count = this.items().length;
                return count === 1
                    ? '<?= $escaper->escapeJs(__('1 line')) ?>'
                    : hyva.str('<?= $escaper->escapeJs(__('%1 lines')) ?>', count);
            },

            setNewName() {
                this.newName = this.$event.target.value || '';
            },
            setSkuQuery() {
                this.skuQuery = this.$event.target.value || '';
            },
            setAddQty() {
                this.addQty = this.$event.target.value || '';
            },

            qtyId() {
                return 'qo-list-qty-' + this.item.sku;
            },
            hasUrl() {
                return Boolean(this.item.url);
            },
            hasNoUrl() {
                return !this.item.url;
            },
            hasStockLabel() {
                return Boolean(this.item.stock && this.item.stock.qty_formatted);
            },
            stockClass() {
                const level = this.item.stock && this.item.stock.level;
                return level ? 'is-' + level : '';
            },
            stockLabel() {
                return hyva.str('<?= $escaper->escapeJs(__('%1 in stock')) ?>', this.item.stock.qty_formatted);
            },
            hasPrice() {
                return Boolean(this.item.price);
            },
            unitPrice() {
                return this.item.price
                    ? hyva.str('<?= $escaper->escapeJs(__('%1 each, ex GST')) ?>', this.item.price.final_formatted)
                    : '';
            },
            hasMessage() {
                return Boolean(this.item.message);
            },
            rowTotal() {
                return this.item.price ? hyva.formatPrice(this.item.price.final * this.item.qty) : '';
            },
            isAtMin() {
                return this.item.qty <= this.item.min;
            },

            increment() {
                this.item.qty = this.item.qty + this.item.step;
                this.queueSave();
            },
            decrement() {
                this.item.qty = Math.max(this.item.min, this.item.qty - this.item.step);
                this.queueSave();
            },
            onQtyChange() {
                this.item.qty = hyva.safeParseNumber(this.$event.target.value);
                this.queueSave();
            },
            removeItem() {
                const sku = this.item.sku;
                this.list.items = this.items().filter((item) => item.sku !== sku);
                this.saveNow();
            },

            addSku(event) {
                event.preventDefault();
                const sku = this.skuQuery.trim();
                const qty = hyva.safeParseNumber(this.addQty);
                if (!sku || qty <= 0 || this.saving) {
                    return;
                }
                const rows = this.items()
                    .filter((item) => item.qty > 0)
                    .map((item) => ({sku: item.sku, qty: item.qty}));
                const existing = rows.find((item) => item.sku === sku);
                if (existing) {
                    existing.qty += qty;
                } else {
                    rows.push({sku: sku, qty: qty});
                }
                this.skuQuery = '';
                this.addQty = '1';
                this.saveRows(rows);
            },

            queueSave() {
                clearTimeout(this.timer);
                this.timer = setTimeout(() => this.saveNow(), 600);
            },

            async saveNow() {
                const items = this.items()
                    .filter((item) => item.qty > 0)
                    .map((item) => ({sku: item.sku, qty: item.qty}));
                await this.saveRows(items);
            },

            async saveRows(items) {
                clearTimeout(this.timer);
                this.timer = null;
                this.saving = true;
                try {
                    const data = await this.post(saveUrl, {
                        form_key: hyva.getFormKey(),
                        name: this.listName,
                        mode: 'replace',
                        items: items
                    });
                    if (!data.success) {
                        throw new Error(data.message || failed);
                    }
                    await this.load();
                } catch (error) {
                    this.toast('error', error.message || failed);
                    await this.load();
                } finally {
                    this.saving = false;
                }
            },

            async addAll() {
                const items = this.items()
                    .filter((item) => item.available && item.qty > 0)
                    .map((item) => ({sku: item.sku, qty: item.qty}));
                if (!items.length || this.saving) {
                    return;
                }
                this.saving = true;
                try {
                    const data = await this.post(cartSaveUrl, {
                        form_key: hyva.getFormKey(),
                        mode: 'merge',
                        items: items
                    });
                    if (!data.success) {
                        throw new Error(data.message || failed);
                    }
                    const errors = data.errors || {};
                    const first = Object.keys(errors)[0];
                    this.toast(first ? 'error' : 'success', first ? errors[first] : added);
                    if (window.elmeQuickOrderCart) {
                        window.elmeQuickOrderCart.load(true);
                    }
                } catch (error) {
                    this.toast('error', error.message || failed);
                } finally {
                    this.saving = false;
                }
            },

            async createList(event) {
                event.preventDefault();
                const name = this.newName.trim();
                if (!name || name === 'cart_list') {
                    this.toast('error', nameRequired);
                    return;
                }
                this.saving = true;
                try {
                    const data = await this.post(saveUrl, {
                        form_key: hyva.getFormKey(),
                        name: name,
                        mode: 'replace',
                        items: []
                    });
                    if (!data.success) {
                        throw new Error(data.message || failed);
                    }
                    const url = new URL(here, window.location.origin);
                    url.searchParams.set('list', name);
                    window.location.assign(url.toString());
                } catch (error) {
                    this.toast('error', error.message || failed);
                    this.saving = false;
                }
            },

            async post(url, body) {
                const response = await fetch(url, {
                    method: 'POST',
                    cache: 'no-store',
                    headers: {
                        'Content-Type': 'application/json',
                        'X-Requested-With': 'XMLHttpRequest',
                        'Accept': 'application/json'
                    },
                    body: JSON.stringify(body)
                });
                const data = await response.json().catch(() => null);
                if (!data) {
                    throw new Error(failed);
                }
                return data;
            },

            toast(type, text) {
                window.dispatchEvent(new CustomEvent('elme-toast', {detail: {type: type, text: text}}));
            }
        };
    }
    window.addEventListener('alpine:init', () => Alpine.data('initElmeShoppingList', initElmeShoppingList), {once: true});
</script>
<?php $hyvaCsp->registerInlineScript() ?>
