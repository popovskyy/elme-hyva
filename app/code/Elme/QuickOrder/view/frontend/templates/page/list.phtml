<?php
/**
 * /quick-order/?list=Name — open a shopping list. Create (no ?list=) stores an empty list and returns here.
 * Qty edits save the named list. Add to cart merges the rows into the Quick Order cart.
 */

declare(strict_types=1);

use Elme\QuickOrder\Model\CartList;
use Hyva\Theme\Model\ViewModelRegistry;
use Hyva\Theme\ViewModel\HyvaCsp;
use Hyva\Theme\ViewModel\LucideIcons;
use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;

/** @var Escaper $escaper */
/** @var Template $block */
/** @var ViewModelRegistry $viewModels */

/** @var HyvaCsp $hyvaCsp */
$hyvaCsp = $viewModels->require(HyvaCsp::class);
/** @var LucideIcons $lucideIcons */
$lucideIcons = $viewModels->require(LucideIcons::class);

$listName = trim((string) $block->getRequest()->getParam('list'));
if ($listName === CartList::NAME) {
    $listName = '';
}
$listsUrl = $block->getUrl('quick_order/template');
?>
<section class="elme-cart"
         x-data="initElmeShoppingList"
         :class="savingClass">
    <a class="elme-cart__back" href="<?= $escaper->escapeUrl($listsUrl) ?>">
        <?= $escaper->escapeHtml(__('My Shopping List')) ?>
    </a>
    <h1 class="elme-cart__title"><?= $escaper->escapeHtml($listName !== '' ? $listName : (string) __('New list')) ?></h1>

    <?php if ($listName === ''): ?>
        <form class="elme-cart__create" @submit="createList">
            <label class="elme-cart__create-name">
                <span class="sr-only"><?= $escaper->escapeHtml(__('List name')) ?></span>
                <input type="text"
                       class="form-input w-full"
                       maxlength="255"
                       required
                       :value="newName"
                       @input="setNewName"
                       placeholder="<?= $escaper->escapeHtmlAttr(__('List name')) ?>">
            </label>
            <button type="submit" class="btn btn-primary" :disabled="saving">
                <?= $escaper->escapeHtml(__('Create')) ?>
            </button>
        </form>
    <?php else: ?>
        <div class="elme-cart__loading" x-show="isLoading" aria-busy="true">
            <p class="sr-only"><?= $escaper->escapeHtml(__('Loading your list...')) ?></p>
            <div class="elme-cart__bone" aria-hidden="true">
                <span class="elme-cart__bone-photo"></span>
                <span class="elme-cart__bone-copy">
                    <span class="elme-cart__bone-line"></span>
                    <span class="elme-cart__bone-line"></span>
                </span>
            </div>
        </div>
        <p class="elme-cart__error" role="alert" x-show="hasLoadError" x-text="loadError" x-cloak></p>
        <div class="elme-cart__empty" x-show="isMissing" x-cloak>
            <p><?= $escaper->escapeHtml(__('This list was not found.')) ?></p>
            <a class="btn btn-primary" href="<?= $escaper->escapeUrl($listsUrl) ?>">
                <?= $escaper->escapeHtml(__('My Shopping List')) ?>
            </a>
        </div>

        <div x-show="isReady" x-cloak>
            <form class="elme-cart__add" @submit="addSku">
                <label class="elme-cart__add-sku">
                    <span class="sr-only"><?= $escaper->escapeHtml(__('SKU')) ?></span>
                    <input type="text"
                           class="form-input w-full"
                           :value="skuQuery"
                           @input="setSkuQuery"
                           placeholder="<?= $escaper->escapeHtmlAttr(__('Add a SKU')) ?>"
                           autocomplete="off">
                </label>
                <label class="elme-cart__add-qty">
                    <span class="sr-only"><?= $escaper->escapeHtml(__('Qty')) ?></span>
                    <input type="number"
                           class="form-input w-full text-center"
                           inputmode="numeric"
                           min="1"
                           :value="addQty"
                           @input="setAddQty">
                </label>
                <button type="submit" class="btn btn-secondary" :disabled="saving">
                    <?= $escaper->escapeHtml(__('Add')) ?>
                </button>
            </form>

            <div class="elme-cart__empty" x-show="isEmpty" x-cloak>
                <p><?= $escaper->escapeHtml(__('This list has no products yet. Add a SKU above, or use the heart on a product.')) ?></p>
            </div>

            <div class="elme-cart__layout" x-show="hasItems">
                <div>
                    <div class="elme-cart__head">
                        <span class="elme-cart__head-product"><?= $escaper->escapeHtml(__('Product')) ?></span>
                        <span class="elme-cart__head-qty"><?= $escaper->escapeHtml(__('Qty')) ?></span>
                        <span class="elme-cart__head-total"><?= $escaper->escapeHtml(__('Total')) ?></span>
                    </div>
                    <ul>
                        <template x-for="item in items" :key="item.sku">
                            <li class="elme-cart__line">
                                <a class="elme-cart__photo" :href="item.url" x-show="hasUrl" tabindex="-1" aria-hidden="true">
                                    <img :src="item.image" :alt="item.name" width="96" height="96" loading="lazy">
                                </a>
                                <div class="elme-cart__photo" x-show="hasNoUrl" aria-hidden="true">
                                    <img :src="item.image" alt="" width="96" height="96" loading="lazy">
                                </div>
                                <div class="elme-cart__info">
                                    <a class="elme-cart__name" :href="item.url" x-show="hasUrl" x-text="item.name"></a>
                                    <p class="elme-cart__name" x-show="hasNoUrl" x-text="item.name"></p>
                                    <p class="elme-cart__sku" x-text="item.sku"></p>
                                    <p class="elme-cart__stock" :class="stockClass" x-show="hasStockLabel">
                                        <span class="elme-cart__dot" aria-hidden="true"></span>
                                        <span x-text="stockLabel"></span>
                                    </p>
                                    <p class="elme-cart__unit" x-show="hasPrice">
                                        <span x-text="unitPrice"></span>
                                    </p>
                                    <p class="elme-cart__message" role="alert" x-show="hasMessage" x-text="item.message"></p>
                                    <div class="elme-cart__actions">
                                        <button type="button" class="elme-cart__textbtn" @click="removeItem">
                                            <?= $escaper->escapeHtml(__('Remove')) ?>
                                        </button>
                                    </div>
                                </div>
                                <div class="elme-cart__qty">
                                    <div class="elme-qty">
                                        <button type="button"
                                                class="elme-qty__btn"
                                                @click="decrement"
                                                :disabled="isAtMin"
                                                aria-label="<?= $escaper->escapeHtmlAttr(__('Decrease quantity')) ?>">
                                            <?= $lucideIcons->minusHtml('', 16, 16, ['aria-hidden' => 'true']) ?>
                                        </button>
                                        <label class="sr-only" :for="qtyId"><?= $escaper->escapeHtml(__('Qty')) ?></label>
                                        <input type="number"
                                               class="elme-qty__input"
                                               inputmode="numeric"
                                               :id="qtyId"
                                               :value="item.qty"
                                               :min="item.min"
                                               :step="item.step"
