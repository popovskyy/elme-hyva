/**
 * /quick-order/?list=Name - open a shopping list. Create (no ?list=) stores a new empty list (a taken name is
 * refused) and returns here. Qty edits save the named list, one save at a time; the pencil renames it. Add a SKU
 * checks the SKU on the server. Add to cart merges the rows into the Quick Order cart.
 */

declare(strict_types=1);

use Elme\QuickOrder\Model\CartList;
