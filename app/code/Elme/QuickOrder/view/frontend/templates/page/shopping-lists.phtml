           x-cloak>
            <?= $lucideIcons->plusHtml('', 16, 16, ['aria-hidden' => 'true']) ?>
            <span class="lg:hidden"><?= $escaper->escapeHtml(__('New list')) ?></span>
            <span class="hidden lg:inline"><?= $escaper->escapeHtml(__('Create new list')) ?></span>
        </a>
    </div>

    <div x-show="isLoading" class="elme-sl__lists" aria-busy="true">
        <p class="sr-only"><?= $escaper->escapeHtml(__('Loading your lists...')) ?></p>
        <div class="elme-sl__bone" aria-hidden="true"></div>
        <div class="elme-sl__bone" aria-hidden="true"></div>
    </div>

    <div class="elme-sl__empty" x-show="showEmpty" x-cloak>
        <?= $lucideIcons->clipboardListHtml('', 40, 40, ['aria-hidden' => 'true']) ?>
        <h2><?= $escaper->escapeHtml(__('No lists yet')) ?></h2>
        <p><?= $escaper->escapeHtml(__('Save the products you order often, then add the whole list to your cart in one go.')) ?></p>
        <div class="elme-sl__empty-actions">
            <a class="btn btn-primary" href="<?= $escaper->escapeUrl($quickOrderUrl) ?>">
                <?= $lucideIcons->plusHtml('', 16, 16, ['aria-hidden' => 'true']) ?>
                <?= $escaper->escapeHtml(__('Create a list')) ?>
            </a>
            <a class="btn btn-link" href="<?= $escaper->escapeUrl($block->getBaseUrl()) ?>">
