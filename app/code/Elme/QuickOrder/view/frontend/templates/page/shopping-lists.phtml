                <th class="py-3 pe-4 font-medium"><?= $escaper->escapeHtml(__('List name')) ?></th>
                <th class="py-3 pe-4 font-medium"><?= $escaper->escapeHtml(__('Products')) ?></th>
                <th class="py-3 font-medium text-end"><?= $escaper->escapeHtml(__('Actions')) ?></th>
            </tr>
            </thead>
            <tbody>
            <template x-for="list in lists" :key="list.id">
                <tr class="border-b border-divider align-middle hover:bg-surface-muted/60 cursor-pointer"
                    :data-list-name="list.name"
