            <span><?= $escaper->escapeHtml(__('Products')) ?></span>
            <span></span>
        </div>
        <ul class="elme-sl__lists">
            <template x-for="list in lists" :key="list.id">
                <li class="elme-dust">
                    <div>
                        <div class="elme-sl__row" data-list-row>
