<script>
    function initElmeShoppingLists() {
        const getAllUrl = '<?= $escaper->escapeJs($getAllUrl) ?>';
        const deleteUrl = '<?= $escaper->escapeJs($deleteUrl) ?>';
        const quickOrderUrl = '<?= $escaper->escapeJs($quickOrderUrl) ?>';
        const labelOne = '<?= $escaper->escapeJs(__('1 product')) ?>';
        const labelMany = '<?= $escaper->escapeJs(__('%1 products')) ?>';
        const labelOpen = '<?= $escaper->escapeJs(__('Open list %1')) ?>';
        const labelDelete = '<?= $escaper->escapeJs(__('Delete %1')) ?>';
        const deleteFailed = '<?= $escaper->escapeJs(__('Could not delete the list.')) ?>';
        // the row leave animation (elme/shopping-lists.css), skipped with reduced motion
        const LEAVE_MS = 240;

        // the Delete button that opened the dialog: focus goes back to it on Cancel
        let trigger = null;

        return {
            lists: [],
            isLoading: true,
            showDeleteModal: false,
            isDeleting: false,
            deleteId: null,
            deleteName: '',
            leavingId: null,

            init() {
                this.fetchLists(false);
            },

            showEmpty() {
                return !this.isLoading && this.lists.length === 0;
            },

            hasLists() {
                return !this.isLoading && this.lists.length > 0;
            },

            rowClass() {
                return String(this.list.id) === String(this.leavingId) ? 'is-leaving' : '';
            },

            hasNoThumbnail() {
                return !this.item.thumbnail_url;
            },

            editUrl(name) {
                const sep = quickOrderUrl.indexOf('?') >= 0 ? '&' : '?';
                return quickOrderUrl + sep + 'list=' + encodeURIComponent(name);
            },

            mapList(list) {
                const count = list.item_count || 0;
                const preview = Array.isArray(list.preview) ? list.preview : [];
                const more = Math.max(0, count - preview.length);
                return Object.assign({}, list, {
                    preview: preview,
                    more: more,
                    more_label: '+' + more,
                    products_label: count === 1 ? labelOne : hyva.str(labelMany, count),
                    open_label: hyva.str(labelOpen, list.name),
                    delete_label: hyva.str(labelDelete, list.name),
                    edit_url: this.editUrl(list.name)
                });
            },

            /**
             * @param {boolean} silent keep the rows while asking again (no skeleton flash)
             */
            async fetchLists(silent) {
                if (!silent) {
                    this.isLoading = true;
                }
                try {
                    const response = await fetch(getAllUrl, {
                        method: 'GET',
                        cache: 'no-store',
                        headers: {'X-Requested-With': 'XMLHttpRequest'}
                    });
                    const data = await response.json();
                    const raw = (data.success && Array.isArray(data.lists)) ? data.lists : [];
                    this.lists = raw.map((list) => this.mapList(list));
                } catch (e) {
                    console.error(e);
                    if (!silent) {
                        this.lists = [];
                    }
                } finally {
                    this.isLoading = false;
                }
            },

            confirmDelete() {
                const btn = this.$event.currentTarget;
                trigger = btn;
                this.deleteId = parseInt(btn.getAttribute('data-list-id'), 10) || null;
                this.deleteName = btn.getAttribute('data-list-name') || '';
                this.showDeleteModal = !!this.deleteId;
                if (this.showDeleteModal) {
                    // Tab and Shift+Tab stay between Cancel and Delete while the dialog is open
                    this.$nextTick(() => {
                        hyva.trapFocus(this.$refs.deleteDialog);
                        this.$refs.cancelDelete.focus();
                    });
                }
            },

            closeDeleteModal() {
                if (this.isDeleting) {
                    return;
                }
                hyva.releaseFocus(this.$refs.deleteDialog);
                this.showDeleteModal = false;
                this.deleteId = null;
                this.deleteName = '';
                if (trigger) {
                    trigger.focus();
                    trigger = null;
                }
            },

            async deleteList() {
                if (!this.deleteId || this.isDeleting) {
                    return;
                }
                const id = this.deleteId;
                this.isDeleting = true;
                hyva.releaseFocus(this.$refs.deleteDialog);
                this.showDeleteModal = false;
                trigger = null;
                this.leavingId = id;
                const request = fetch(deleteUrl, {
                    method: 'POST',
                    cache: 'no-store',
                    headers: {
                        'Content-Type': 'application/json',
                        'X-Requested-With': 'XMLHttpRequest'
                    },
                    body: JSON.stringify({form_key: hyva.getFormKey(), id: id})
                });
                // handled below, after the row has left
                request.catch(() => {});
                if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
                    await new Promise((resolve) => setTimeout(resolve, LEAVE_MS));
                }
                this.lists = this.lists.filter((list) => String(list.id) !== String(id));
                this.leavingId = null;

                try {
                    const response = await request;
                    const data = await response.json();
                    if (!data.success) {
                        throw new Error(data.message || deleteFailed);
                    }
                    // the row is already gone here: our own listener skips this one
                    window.dispatchEvent(new CustomEvent('elme:saved-lists-changed', {
                        detail: {source: 'shopping-lists'}
                    }));
                    document.body.dispatchEvent(new CustomEvent('reload-customer-section-data'));
                } catch (e) {
                    window.dispatchEvent(new CustomEvent('elme-toast', {
                        detail: {type: 'error', text: e.message || deleteFailed}
                    }));
                    await this.fetchLists(true);
                } finally {
                    this.isDeleting = false;
                    this.deleteId = null;
                    this.deleteName = '';
                }
            },

            eventListeners: {
                ['@elme:saved-lists-changed.window'](event) {
                    if (event.detail && event.detail.source === 'shopping-lists') {
                        return;
                    }
                    this.fetchLists(true);
                },
                ['@keydown.escape.window']() {
                    if (this.showDeleteModal) {
                        this.closeDeleteModal();
                    }
                }
            }
        };
    }
    window.addEventListener('alpine:init', () => Alpine.data('initElmeShoppingLists', initElmeShoppingLists), {once: true});
</script>
<?php $hyvaCsp->registerInlineScript() ?>
