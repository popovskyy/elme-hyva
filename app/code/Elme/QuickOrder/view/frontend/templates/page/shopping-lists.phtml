                            <span class="text-note text-ink-muted" x-text="list.products_label"></span>
                        </div>
                    </td>
                    <td class="py-4 text-end whitespace-nowrap">
                        <a class="btn btn-secondary btn-sm me-2"
                           :href="list.edit_url"
                           @click.stop>
                            <?= $escaper->escapeHtml(__('Edit')) ?>
                        </a>
                        <button type="button"
                                class="btn btn-secondary btn-sm"
                                :data-list-id="list.id"
                                :data-list-name="list.name"
