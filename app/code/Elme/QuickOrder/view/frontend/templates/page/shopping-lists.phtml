 * FE-76: cards on the phone, ruled rows with real links on desktop, empty state with a CTA (elme/shopping-lists.css).
 * FE-75: Delete asks in the shared confirm dialog, then the row turns to dust (elme/dust.phtml).
 *
 * @var \Magento\Framework\View\Element\Template $block
 * @var \Magento\Framework\Escaper $escaper
 * @var \Hyva\Theme\Model\ViewModelRegistry $viewModels
 */

declare(strict_types=1);

