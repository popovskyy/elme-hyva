                            <div class="elme-sl__thumbs" aria-hidden="true">
                                <template x-for="item in list.preview" :key="list.id + '-' + item.sku">
                                    <span class="elme-sl__thumb" :title="item.name">
                                        <img x-show="item.thumbnail_url"
                                             :src="item.thumbnail_url"
                                             alt=""
                                             width="56"
                                             height="56"
                                             loading="lazy">
                                        <span x-show="hasNoThumbnail">
                                            <?= $lucideIcons->imageHtml('', 20, 20, ['aria-hidden' => 'true']) ?>
                                        </span>
                                    </span>
                                </template>
                                <span class="elme-sl__thumb elme-sl__thumb--more" x-show="list.more" x-text="list.more_label"></span>
                            </div>
