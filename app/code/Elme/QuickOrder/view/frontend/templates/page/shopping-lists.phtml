    <p class="sr-only" role="status" x-text="announcement"></p>
</div>

<script>
    function initElmeShoppingLists() {
        const getAllUrl = '<?= $escaper->escapeJs($getAllUrl) ?>';
        const deleteUrl = '<?= $escaper->escapeJs($deleteUrl) ?>';
        const quickOrderUrl = '<?= $escaper->escapeJs($quickOrderUrl) ?>';
        const labelOne = '<?= $escaper->escapeJs(__('1 product')) ?>';
        const labelMany = '<?= $escaper->escapeJs(__('%1 products')) ?>';
        const labelOpen = '<?= $escaper->escapeJs(__('Open list %1')) ?>';
        const labelDelete = '<?= $escaper->escapeJs(__('Delete %1')) ?>';
        const deleteFailed = '<?= $escaper->escapeJs(__('Could not delete the list.')) ?>';

        return {
            lists: [],
            isLoading: true,
            // ids of lists turning to dust
            deleting: {},
            announcement: '',

            init() {
                this.fetchLists(false);
            },

            showEmpty() {
                return !this.isLoading && this.lists.length === 0;
            },

            hasLists() {
                return !this.isLoading && this.lists.length > 0;
            },

            hasNoThumbnail() {
                return !this.item.thumbnail_url;
            },

            editUrl(name) {
                const sep = quickOrderUrl.indexOf('?') >= 0 ? '&' : '?';
                return quickOrderUrl + sep + 'list=' + encodeURIComponent(name);
            },

            mapList(list) {
                const count = list.item_count || 0;
                const preview = Array.isArray(list.preview) ? list.preview : [];
                const more = Math.max(0, count - preview.length);
                return Object.assign({}, list, {
                    preview: preview,
                    more: more,
                    more_label: '+' + more,
                    products_label: count === 1 ? labelOne : hyva.str(labelMany, count),
                    open_label: hyva.str(labelOpen, list.name),
                    delete_label: hyva.str(labelDelete, list.name),
                    edit_url: this.editUrl(list.name)
                });
            },

            /**
             * @param {boolean} silent keep the rows while asking again (no skeleton flash)
             */
            async fetchLists(silent) {
                if (!silent) {
                    this.isLoading = true;
                }
                try {
                    const response = await fetch(getAllUrl, {
                        method: 'GET',
                        cache: 'no-store',
                        headers: {'X-Requested-With': 'XMLHttpRequest'}
                    });
                    const data = await response.json();
                    const raw = (data.success && Array.isArray(data.lists)) ? data.lists : [];
                    this.lists = raw.map((list) => this.mapList(list));
                } catch (e) {
                    console.error(e);
                    if (!silent) {
                        this.lists = [];
                    }
                } finally {
                    this.isLoading = false;
                }
            },

            /**
             * Asks first. The delete goes to the server at once while the row turns to dust; the list leaves the
             * page after its gap has closed. A failed delete brings the row back with a toast.
             */
            async confirmDelete() {
                const trigger = this.$event.currentTarget;
                const id = parseInt(trigger.getAttribute('data-list-id'), 10) || null;
                const name = trigger.getAttribute('data-list-name') || '';
                if (!id || this.deleting[id]) {
                    return;
                }
                const confirmed = await window.elmeConfirm({
                    title: hyva.str('<?= $escaper->escapeJs(__('Delete %1?')) ?>', name),
                    text: '<?= $escaper->escapeJs(__('This cannot be undone.')) ?>',
                    confirmLabel: '<?= $escaper->escapeJs(__('Delete')) ?>',
                    trigger: trigger
                });
                if (!confirmed || this.deleting[id]) {
                    return;
                }
                this.deleting[id] = true;
                const request = fetch(deleteUrl, {
                    method: 'POST',
                    cache: 'no-store',
                    headers: {
                        'Content-Type': 'application/json',
                        'X-Requested-With': 'XMLHttpRequest'
                    },
                    body: JSON.stringify({form_key: hyva.getFormKey(), id: id})
                }).then((response) => response.json()).then((data) => {
                    if (!data.success) {
                        throw new Error(data.message || deleteFailed);
                    }
                });
                // handled below, after the row has turned to dust
                request.catch(() => {});
                const row = trigger.closest('.elme-sl__row');
                const gone = window.elmeDust.dissolve(row);
                window.elmeDust.focusNext(row, '.elme-ib--danger', this.$refs.title);

                await gone;
                try {
                    await request;
                    this.lists = this.lists.filter((list) => String(list.id) !== String(id));
                    this.announcement = hyva.str('<?= $escaper->escapeJs(__('%1 deleted.')) ?>', name);
                    // the row is already gone here: our own listener skips this one
                    window.dispatchEvent(new CustomEvent('elme:saved-lists-changed', {
                        detail: {source: 'shopping-lists'}
                    }));
                    // Hyva private-content listens on window (not body); without this the section stays stale
                    window.dispatchEvent(new CustomEvent('reload-customer-section-data'));
                } catch (e) {
                    window.dispatchEvent(new CustomEvent('elme-toast', {
                        detail: {type: 'error', text: (e && e.message) || deleteFailed}
                    }));
                    await window.elmeDust.restore(row, trigger);
                } finally {
                    delete this.deleting[id];
                }
            },

            eventListeners: {
                ['@elme:saved-lists-changed.window'](event) {
                    if (event.detail && event.detail.source === 'shopping-lists') {
                        return;
                    }
                    this.fetchLists(true);
                }
            }
        };
    }
    window.addEventListener('alpine:init', () => Alpine.data('initElmeShoppingLists', initElmeShoppingLists), {once: true});
</script>
<?php $hyvaCsp->registerInlineScript() ?>
