                    <td class="py-4 pe-4 font-medium text-ink" x-text="list.name"></td>
                    <td class="py-4 pe-4">
                        <div class="flex items-center gap-3">
                            <div class="flex -space-x-2" x-show="list.has_preview">
                                <template x-for="item in list.preview" :key="list.id + '-' + item.sku">
                                    <span class="inline-flex size-12 rounded-sm border border-divider bg-surface overflow-hidden shrink-0"
                                          :title="item.name">
                                        <img class="size-full object-contain"
                                             x-show="item.thumbnail_url"
                                             :src="item.thumbnail_url"
                                             :alt="item.name"
                                             width="48"
                                             height="48"
                                             loading="lazy"/>
                                    </span>
                                </template>
