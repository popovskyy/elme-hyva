            <h2 id="elme-sl-delete-title" class="font-heading text-h4 text-ink mb-3">
                <?= $escaper->escapeHtml(__('Delete list?')) ?>
            </h2>
            <p class="text-body text-ink-muted mb-6">
                <?= $escaper->escapeHtml(__('This cannot be undone.')) ?>
                <span class="block mt-1 font-medium text-ink" x-text="deleteName"></span>
            </p>
