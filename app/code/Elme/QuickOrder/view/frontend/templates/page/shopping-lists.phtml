        <a href="<?= $escaper->escapeUrl($quickOrderUrl) ?>"
           class="btn btn-secondary self-start sm:self-auto">
            <?= $escaper->escapeHtml(__('Create new list')) ?>
        </a>
    </div>

    <div x-show="isLoading" class="space-y-3" aria-busy="true" aria-live="polite">
        <div class="h-16 rounded-sm bg-surface-muted animate-pulse"></div>
        <div class="h-16 rounded-sm bg-surface-muted animate-pulse"></div>
        <div class="h-16 rounded-sm bg-surface-muted animate-pulse"></div>
    </div>

    <p x-show="showEmpty"
       class="text-ink-muted text-body py-10 text-center border border-dashed border-divider rounded-sm"
       x-cloak>
        <?= $escaper->escapeHtml(__('No saved lists found')) ?>
    </p>

    <div x-show="showTable" class="overflow-x-auto" x-cloak>
