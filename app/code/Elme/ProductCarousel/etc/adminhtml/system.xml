<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <section id="elme_catalog">
            <group id="product_carousel" translate="label" sortOrder="30"
                   showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Product carousel (FE-17)</label>
                <field id="trending_category_id" translate="label comment" type="text" sortOrder="10"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Trending products category ID</label>
                    <comment>The "Trending" carousel shows the products of this category, in the position set in Catalog > Categories > Products in Category. Empty: the Trending carousel stays hidden.</comment>
                    <validate>validate-digits</validate>
                </field>
            </group>
        </section>
    </system>
</config>
