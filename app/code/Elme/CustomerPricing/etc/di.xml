<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <preference for="Elme\LoginOnly\Api\CustomerPriceProviderInterface"
                type="Elme\CustomerPricing\Model\ProntoPriceProvider"/>

    <type name="Magento\Framework\Console\CommandListInterface">
        <arguments>
            <argument name="commands" xsi:type="array">
                <item name="elme_customer_pricing_import" xsi:type="object">Elme\CustomerPricing\Console\Command\ImportCsv</item>
            </argument>
        </arguments>
    </type>
    <type name="Elme\CustomerPricing\Console\Command\ImportCsv">
        <arguments>
            <argument name="loader" xsi:type="object">Elme\CustomerPricing\Model\Import\CsvLoader\Proxy</argument>
        </arguments>
    </type>
</config>
