<?xml version="1.0"?>
<!--
  FE-54: one theme/module bootstrap before body end — not pasted into CMS HTML.
  Also runs on /checkout (own Elme_Checkout on this theme); hiding the chat there is UX-06.
-->
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceContainer name="before.body.end">
            <block name="elme.thirdparty.bootstrap"
                   template="Elme_ThirdParty::bootstrap.phtml"
                   after="-">
                <arguments>
                    <argument name="view_model" xsi:type="object">Elme\ThirdParty\ViewModel\Config</argument>
                </arguments>
            </block>
        </referenceContainer>
    </body>
</page>
