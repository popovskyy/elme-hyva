<?php
/**
 * The logged-in customer's own price. The HTML only holds a placeholder (it is cached per customer group);
 * the price loads per customer from /customer-price/prices once the page is rendered.
 * Needs Elme_LoginOnly::js/customer-price.phtml once per page (added for logged-in customers on every page).
 *
 * Block data: product_id (or a block with getProduct()), show_tax_label, pdp (bool: large PDP row).
 * No itemprop/offers (FE-27 SEO): Pronto prices must not enter Offer microdata or server HTML numbers.
 *
 * What shows (FE-106, same rules as the old site):
 * - Agreed price under the list price ("trade"): PDP "List price" line (hidden when the price list has none) and
 *   "Trade price" line; cards a "Trade" label. A sale under the trade price strikes the trade price through.
 * - No agreed price, on sale: the list price struck through, then the price.
 * - Otherwise the price alone.
 */

declare(strict_types=1);

use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;

/** @var Template $block */
/** @var Escaper $escaper */

$productId = (int) ($block->getData('product_id') ?: $block->getProduct()?->getId());
if (!$productId) {
    return;
}
$isPdp = (bool) $block->getData('pdp');
$showTax = (bool) $block->getData('show_tax_label');
$boxClass = $isPdp
    ? 'price-box elme-customer-price elme-pdp__price'
    : 'price-box elme-customer-price flex flex-wrap items-baseline gap-x-2 min-h-6';
$skeletonClass = $isPdp
    ? 'elme-skeleton elme-pdp__price-skeleton'
    : 'elme-skeleton h-5 w-20 self-center';
$rowClass = $isPdp ? 'elme-pdp__price-row' : 'm-0 flex flex-wrap items-baseline gap-x-2';
?>
<div class="<?= $escaper->escapeHtmlAttr($boxClass) ?>"
     x-data="initElmeCustomerPrice"
     @configurable-selection-changed.window="onOptionsChanged"
     data-product-id="<?= /* @noEscape */ $productId ?>"
     data-pdp="<?= $isPdp ? '1' : '0' ?>"
>
    <span class="<?= $escaper->escapeHtmlAttr($skeletonClass) ?>" x-show="isLoading" aria-hidden="true"></span>
    <span class="sr-only" x-show="isLoading"><?= $escaper->escapeHtml(__('Loading your price')) ?></span>

    <?php if ($isPdp): ?>
        <template x-if="hasTrade">
            <div class="elme-pdp__price-lines">
                <template x-if="hasList">
                    <p class="elme-pdp__price-row elme-pdp__price-row--list">
                        <span class="elme-pdp__price-label"><?= $escaper->escapeHtml(__('List price')) ?></span>
                        <span class="price" x-text="listPrice"></span>
                        <?php if ($showTax): ?>
                            <span class="elme-pdp__ex-gst"><?= $escaper->escapeHtml(__('ex. GST')) ?></span>
                        <?php endif; ?>
                    </p>
                </template>
                <p class="elme-pdp__price-row elme-pdp__price-row--trade">
                    <span class="elme-pdp__price-label"><?= $escaper->escapeHtml(__('Trade price')) ?></span>
                    <template x-if="hasWas">
                        <span class="old-price">
                            <span class="sr-only"><?= $escaper->escapeHtml(__('Was')) ?></span>
                            <s class="price" x-text="wasPrice"></s>
                        </span>
                    </template>
                    <span class="final-price">
                        <span class="sr-only" x-show="hasWas"><?= $escaper->escapeHtml(__('Now')) ?></span>
                        <span class="price" x-text="finalPrice"></span>
                        <?php if ($showTax): ?>
                            <span class="elme-pdp__ex-gst"><?= $escaper->escapeHtml(__('ex. GST')) ?></span>
                        <?php endif; ?>
                    </span>
                </p>
            </div>
        </template>
    <?php else: ?>
        <template x-if="hasTrade">
            <p class="<?= $escaper->escapeHtmlAttr($rowClass) ?>">
                <span class="elme-price-label"><?= $escaper->escapeHtml(__('Trade')) ?></span>
                <template x-if="hasWas">
                    <span class="old-price">
                        <span class="sr-only"><?= $escaper->escapeHtml(__('Was')) ?></span>
                        <s class="price" x-text="wasPrice"></s>
                    </span>
                </template>
                <span class="final-price">
                    <span class="sr-only" x-show="hasWas"><?= $escaper->escapeHtml(__('Now')) ?></span>
                    <span class="price" x-text="finalPrice"></span>
                    <?php if ($showTax): ?>
                        <span class="elme-pdp__ex-gst"><?= $escaper->escapeHtml(__('ex. GST')) ?></span>
                    <?php endif; ?>
                </span>
            </p>
        </template>
    <?php endif; ?>

    <template x-if="isSale">
        <p class="<?= $escaper->escapeHtmlAttr($rowClass) ?>">
            <span class="old-price">
                <span class="sr-only"><?= $escaper->escapeHtml(__('Was')) ?></span>
                <s class="price" x-text="wasPrice"></s>
            </span>
            <span class="final-price">
                <span class="sr-only"><?= $escaper->escapeHtml(__('Now')) ?></span>
                <span class="price" x-text="finalPrice"></span>
                <?php if ($showTax): ?>
                    <span class="elme-pdp__ex-gst"><?= $escaper->escapeHtml(__('ex. GST')) ?></span>
                <?php endif; ?>
            </span>
        </p>
    </template>

    <template x-if="isPlainPrice">
        <p class="<?= $escaper->escapeHtmlAttr($rowClass) ?>">
            <span class="final-price">
                <span class="price" x-text="finalPrice"></span>
                <?php if ($showTax): ?>
                    <span class="elme-pdp__ex-gst"><?= $escaper->escapeHtml(__('ex. GST')) ?></span>
                <?php endif; ?>
            </span>
        </p>
    </template>
</div>
