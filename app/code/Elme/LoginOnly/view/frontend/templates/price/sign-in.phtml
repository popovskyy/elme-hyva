<?php
/**
 * UX-02: short guest price line on cards (and anywhere PriceRenderPlugin swaps the final price).
 * Also the PDP price block for guests. "Log in" keeps data-elme-sign-in for the referer cookie.
 */

declare(strict_types=1);

use Elme\LoginOnly\ViewModel\LoginOnly;
use Hyva\Theme\Model\ViewModelRegistry;
use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;

/** @var Template $block */
/** @var Escaper $escaper */
/** @var ViewModelRegistry $viewModels */

/** @var LoginOnly $loginOnly */
$loginOnly = $viewModels->require(LoginOnly::class);
$logInLink = sprintf(
    '<a href="%s" class="font-bold underline underline-offset-2 hover:text-link-hover" data-elme-sign-in>%s</a>',
    $escaper->escapeUrl($loginOnly->getLoginUrl()),
    $escaper->escapeHtml(__('Log in'))
);
?>
<p class="elme-sign-in-price text-copy text-ink">
    <?= /* @noEscape */ __('%1 for price', $logInLink) ?>
</p>
