<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <type name="Magento\Framework\Pricing\Render">
        <plugin name="elme_login_only_price" type="Elme\LoginOnly\Plugin\PriceRenderPlugin"/>
    </type>

    <type name="Hyva\Theme\ViewModel\ProductListItem">
        <plugin name="elme_login_only_cache_key" type="Elme\LoginOnly\Plugin\ProductListItemCacheKeyPlugin"/>
    </type>

    <type name="Magento\ConfigurableProduct\Block\Product\View\Type\Configurable">
        <plugin name="elme_login_only_strip_prices" type="Elme\LoginOnly\Plugin\StripConfigurablePricesPlugin"/>
    </type>
    <type name="Magento\Swatches\Block\Product\Renderer\Listing\Configurable">
        <plugin name="elme_login_only_strip_prices" type="Elme\LoginOnly\Plugin\StripConfigurablePricesPlugin"/>
    </type>

    <type name="Magento\Catalog\Model\Layer\FilterList">
        <plugin name="elme_login_only_price_filter" type="Elme\LoginOnly\Plugin\HidePriceSortingAndFilterPlugin"/>
    </type>
    <type name="Magento\Catalog\Block\Product\ProductList\Toolbar">
        <plugin name="elme_login_only_price_sort" type="Elme\LoginOnly\Plugin\HidePriceSortingAndFilterPlugin"/>
    </type>

    <type name="Elme\LoginOnly\Observer\RedirectGuests">
        <arguments>
            <argument name="gatedActions" xsi:type="array">
                <!-- cart, mini cart actions, add to cart, checkout -->
                <item name="checkout" xsi:type="string">checkout</item>
                <item name="multishipping" xsi:type="string">multishipping</item>
                <item name="wishlist" xsi:type="string">wishlist</item>
                <!-- route id of the Quick Order module (ElmeLiving_QuickOrder used quick_order / quick-order) -->
                <item name="quick_order" xsi:type="string">quick_order</item>
                <item name="compare" xsi:type="string">catalog_product_compare_index</item>
            </argument>
            <argument name="gatedCmsPages" xsi:type="array">
                <item name="virtual_catalogues" xsi:type="string">virtual-catalogues</item>
            </argument>
        </arguments>
    </type>
</config>
