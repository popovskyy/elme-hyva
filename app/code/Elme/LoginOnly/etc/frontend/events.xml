<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Event/etc/events.xsd">
    <event name="controller_action_predispatch">
        <observer name="elme_login_only_redirect_guests" instance="Elme\LoginOnly\Observer\RedirectGuests"/>
    </event>
    <event name="layout_load_before">
        <observer name="elme_login_only_layout_handle" instance="Elme\LoginOnly\Observer\AddLoginStateHandle"/>
    </event>
    <!-- Lists only: on the PDP the price block must still render (it shows "Sign in to see pricing") -->
    <event name="catalog_product_collection_load_after">
        <observer name="elme_login_only_hide_price" instance="Elme\LoginOnly\Observer\HideProductPriceForGuests"/>
    </event>
</config>
