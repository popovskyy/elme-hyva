<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <type name="Magento\Framework\Webapi\Authorization">
        <plugin name="elme_login_only_close_anonymous" type="Elme\LoginOnly\Plugin\CloseAnonymousWebapiPlugin"/>
    </type>
    <type name="Elme\LoginOnly\Plugin\CloseAnonymousWebapiPlugin">
        <arguments>
            <argument name="request" xsi:type="object">Magento\Framework\Webapi\Rest\Request</argument>
            <argument name="allowedPaths" xsi:type="array">
                <!-- Integrations log in here, before they have a token -->
                <item name="admin_token" xsi:type="string">/V1/integration/admin/token</item>
            </argument>
        </arguments>
    </type>
</config>
