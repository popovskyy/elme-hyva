<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <!-- View models of Elme Content Studio types (etc/content_types.xml), keyed by type code.
         Global, not frontend: the admin grid preview and the Page Builder stage render the same
         templates. -->
    <type name="Bart\ContentStudio\Block\Entry">
        <arguments>
            <argument name="typeViewModels" xsi:type="array">
                <item name="hero" xsi:type="object">Elme\Theme\ViewModel\Hero</item>
                <item name="category_tiles" xsi:type="object">Elme\Theme\ViewModel\CategoryTiles</item>
                <item name="catalogue_covers" xsi:type="object">Elme\Theme\ViewModel\CatalogueCovers</item>
                <item name="virtual_catalogues" xsi:type="object">Elme\Theme\ViewModel\VirtualCatalogues</item>
                <item name="usp_strip" xsi:type="object">Elme\Theme\ViewModel\UspStrip</item>
                <item name="store_visit" xsi:type="object">Elme\Theme\ViewModel\StoreVisit</item>
                <item name="faq_list" xsi:type="object">Elme\Theme\ViewModel\FaqList</item>
                <item name="vacancies" xsi:type="object">Elme\Theme\ViewModel\Vacancies</item>
                <item name="team" xsi:type="object">Elme\Theme\ViewModel\Team</item>
                <item name="events" xsi:type="object">Elme\Theme\ViewModel\Events</item>
            </argument>
        </arguments>
    </type>
</config>
