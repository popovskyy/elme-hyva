<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Store:etc/config.xsd">
    <default>
        <!-- Core wishlist and product reviews stay off. Elme replaces them with its own features. -->
        <wishlist>
            <general>
                <active>0</active>
            </general>
        </wishlist>
        <!-- Braintree keeps these modules loaded. The features themselves stay off. -->
        <sales>
            <instant_purchase>
                <active>0</active>
            </instant_purchase>
            <msrp>
                <enabled>0</enabled>
            </msrp>
            <gift_options>
                <allow_order>0</allow_order>
                <allow_items>0</allow_items>
            </gift_options>
        </sales>
        <multishipping>
            <options>
                <checkout_multiple>0</checkout_multiple>
            </options>
        </multishipping>
        <catalog>
            <productalert>
                <allow_price>0</allow_price>
                <allow_stock>0</allow_stock>
            </productalert>
            <review>
                <active>0</active>
            </review>
        </catalog>
        <elme_catalog>
            <plp>
                <quick_order>1</quick_order>
            </plp>
        </elme_catalog>
    </default>
</config>
