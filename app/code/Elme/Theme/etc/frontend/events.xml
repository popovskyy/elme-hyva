<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Event/etc/events.xsd">
    <event name="layout_load_before">
        <observer name="elme_theme_help_page_handle" instance="Elme\Theme\Observer\AddHelpPageHandle"/>
    </event>
    <!-- FE-20: out-of-range ?p= → 302 to last page (never empty 200 grid). -->
    <event name="controller_action_predispatch_catalog_category_view">
        <observer name="elme_theme_clamp_category_page" instance="Elme\Theme\Observer\ClampCategoryPage"/>
    </event>
</config>
