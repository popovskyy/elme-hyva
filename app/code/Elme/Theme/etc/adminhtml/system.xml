<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <tab id="elme" translate="label" sortOrder="400">
            <label>Elme</label>
        </tab>
        <section id="elme_catalog" translate="label" type="text" sortOrder="20"
                 showInDefault="1" showInWebsite="1" showInStore="1">
            <label>Catalog</label>
            <tab>elme</tab>
            <resource>Magento_Catalog::config_catalog</resource>
            <group id="plp" translate="label" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Product card (FE-19)</label>
                <field id="quick_order" translate="label comment" type="select" sortOrder="10"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Quick order on PLP</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment>Logged-in customers get a qty stepper (MOQ multiples) next to Add to Cart on product cards. No: Add to Cart adds the MOQ.</comment>
                </field>
            </group>
        </section>
    </system>
</config>
