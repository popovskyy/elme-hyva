        <script>
            function initLookbookGallery() {
                return {
                    room: '',
                    addingLook: false,
                    addAllByLook: [],

                    init() {
                        const node = document.getElementById(this.$root.id + '-add-all');
                        try {
                            this.addAllByLook = node ? JSON.parse(node.textContent || '[]') : [];
                        } catch (e) {
                            this.addAllByLook = [];
                        }
                    },

                    roomFilter() {
                        return this.room;
                    },

                    isAddingLook() {
                        return this.addingLook;
                    },

                    isNotAddingLook() {
                        return !this.addingLook;
                    },

                    setRoom() {
                        this.room = this.$event.currentTarget.dataset.room || '';
                        window.dispatchEvent(new CustomEvent('lookbook-close-pin'));
                    },

                    openPin() {
                        const el = this.$event.currentTarget;
                        window.dispatchEvent(new CustomEvent('lookbook-open-pin', {
                            detail: {
                                look: parseInt(el.dataset.lookIndex, 10),
                                pin: parseInt(el.dataset.pinIndex, 10)
                            }
                        }));
                    },

                    async addLook() {
                        if (this.addingLook) {
                            return;
                        }
                        const lookIndex = parseInt(this.$event.currentTarget.dataset.lookIndex, 10);
                        const items = this.addAllByLook[lookIndex] || [];
                        if (!items.length || typeof hyva === 'undefined') {
                            return;
                        }
                        this.addingLook = true;
                        const formKey = hyva.getFormKey();
                        try {
                            for (const item of items) {
                                const body = new URLSearchParams();
                                body.set('product', String(item.product_id));
                                body.set('qty', String(item.qty));
                                body.set('form_key', formKey);
                                await fetch(item.add_url, {
                                    method: 'POST',
                                    headers: {
                                        'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8',
                                        'X-Requested-With': 'XMLHttpRequest'
                                    },
                                    body: body.toString(),
                                    credentials: 'same-origin'
                                });
                            }
                            window.dispatchEvent(new CustomEvent('reload-customer-section-data'));
                        } finally {
                            this.addingLook = false;
                        }
                    }
                };
            }

            function initLookbookDialog() {
                return {
                    open: false,
                    look: -1,
                    pin: -1,

                    init() {
                        this.look = parseInt(this.$root.dataset.lookIndex, 10);
                        this.pin = parseInt(this.$root.dataset.pinIndex, 10);
                    },

                    isOpen() {
                        return this.open;
                    },

                    onOpen() {
                        const detail = this.$event.detail || {};
                        this.open = detail.look === this.look && detail.pin === this.pin;
                        if (this.open) {
                            document.documentElement.classList.add('overflow-hidden');
                        }
                    },

                    onClose() {
                        this.open = false;
                        document.documentElement.classList.remove('overflow-hidden');
                    },

                    onEscape() {
                        if (!this.open) {
                            return;
                        }
                        this.close();
                    },

                    close() {
                        this.open = false;
                        document.documentElement.classList.remove('overflow-hidden');
                        window.dispatchEvent(new CustomEvent('lookbook-close-pin'));
                    }
                };
            }

            window.addEventListener(
                'alpine:init',
                () => {
                    Alpine.data('initLookbookGallery', initLookbookGallery);
                    Alpine.data('initLookbookDialog', initLookbookDialog);
                },
                { once: true }
            );
        </script>
