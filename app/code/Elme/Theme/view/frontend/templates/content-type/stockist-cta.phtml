<?php
/**
 * Content Studio type `stockist_cta` (FE-61): Become a stockist dual CTA.
 * Guests: Create an Account (primary) + Talk to our team (secondary).
 * Logged-in: My Account (primary) + Talk to our team — same footprint to avoid CLS.
 *
 * @var \Bart\ContentStudio\Block\Entry $block
 * @var \Magento\Framework\Escaper $escaper
 * @var \Hyva\Theme\Model\ViewModelRegistry $viewModels
 */

use Elme\LoginOnly\ViewModel\LoginOnly;
use Elme\Theme\ViewModel\StockistCta;

$cta = $block->getTypeViewModel();
if (!$cta instanceof StockistCta) {
    return;
}

$content = $block->getContent();
$heading = $cta->getHeading($content);
$text = $cta->getText($content);
$guestPrimary = $cta->getPrimaryButton($content);
$secondary = $cta->getSecondaryButton($content);

if ($heading === '' || ($guestPrimary === null && $secondary === null)) {
    return;
}

/** @var LoginOnly $loginOnly */
$loginOnly = $viewModels->require(LoginOnly::class);

$primary = null;
if ($loginOnly->isLoggedIn()) {
    if ($guestPrimary !== null) {
        $primary = [
            'label' => (string) __('My Account'),
            'link' => $block->getUrl('customer/account'),
        ];
    }
} else {
    $primary = $guestPrimary;
}

$headingId = 'stockist-cta-' . preg_replace('/[^a-z0-9_-]/i', '-', $block->getIdentifier());
?>
<section class="elme-stockist-cta mb-10 px-5 text-center lg:mb-15"
         aria-labelledby="<?= $escaper->escapeHtmlAttr($headingId) ?>">
    <h2 id="<?= $escaper->escapeHtmlAttr($headingId) ?>"
        class="mb-4 text-title-section text-ink lg:mb-5 lg:text-title-section-desktop">
        <?= $escaper->escapeHtml($heading) ?>
    </h2>
    <?php if ($text !== ''): ?>
        <p class="mx-auto mb-6 max-w-150 text-copy text-ink-muted lg:mb-8 lg:text-copy-desktop">
            <?= $escaper->escapeHtml($text) ?>
        </p>
    <?php endif; ?>
    <?php // Fixed min-height so guest ↔ logged-in primary swap does not shift the page. ?>
    <div class="flex min-h-12 flex-col items-center justify-center gap-3 sm:flex-row sm:flex-wrap">
        <?php if ($primary !== null): ?>
            <a href="<?= $escaper->escapeUrl($primary['link']) ?>"
               class="btn btn-primary w-full sm:w-auto sm:min-w-54">
                <?= $escaper->escapeHtml($primary['label']) ?>
            </a>
        <?php endif; ?>
        <?php if ($secondary !== null): ?>
            <a href="<?= $escaper->escapeUrl($secondary['link']) ?>"
               class="btn btn-secondary w-full sm:w-auto sm:min-w-54">
                <?= $escaper->escapeHtml($secondary['label']) ?>
            </a>
        <?php endif; ?>
    </div>
</section>
