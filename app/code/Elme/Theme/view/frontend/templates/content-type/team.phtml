<?php
/**
 * Content Studio type `team` (etc/content_types.xml, FE-65): Meet the Team body.
 * H1 + intro, region chips (CSP Alpine visibility only), then a card grid. Every person is in the
 * initial HTML for crawlers; chips never remove nodes or change the URL.
 *
 * @var \Bart\ContentStudio\Block\Entry $block
 * @var \Magento\Framework\Escaper $escaper
 * @var \Hyva\Theme\Model\ViewModelRegistry $viewModels
 */

use Elme\Theme\ViewModel\Team;
use Hyva\Theme\ViewModel\HyvaCsp;

$team = $block->getTypeViewModel();

if (!$team instanceof Team) {
    return;
}

$content = $block->getContent();
$people = $team->getPeople($content);
$title = $team->getTitle($content);
$intro = $team->getIntro($content);
$heading = $team->getHeading($content);
$chips = $team->getChips();
$present = $team->getPresentRegions($people);
$sectionId = 'team-' . preg_replace('/[^a-z0-9_-]/i', '-', $block->getIdentifier());
$titleId = $sectionId . '-title';
$headingId = $sectionId . '-heading';
$toolbarId = $sectionId . '-regions';
$introTags = ['p', 'br', 'strong', 'b', 'em', 'i', 'u', 'a', 'ul', 'ol', 'li'];

/** @var HyvaCsp $hyvaCsp */
$hyvaCsp = $viewModels->require(HyvaCsp::class);

$chipClass = 'inline-flex min-h-11 items-center justify-center border border-border
              bg-surface px-3.5 text-note font-medium text-ink
              transition-colors duration-(--transition-duration-fast)
              hover:border-ink hover:bg-surface-muted
              focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink';
$chipSelectedClass = 'border-ink bg-primary text-on-primary hover:border-ink hover:bg-primary';
$contactClass = 'inline-flex min-h-11 min-w-11 items-center text-copy text-ink underline
                 underline-offset-4 break-all hover:text-link-hover
                 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink
                 lg:text-copy-desktop';
?>
<div id="<?= $escaper->escapeHtmlAttr($sectionId) ?>"
     class="elme-team mx-auto mb-12 w-full max-w-480 px-5 text-ink md:px-10 lg:mb-20"
     x-data="initElmeTeamFilter"
     data-present="<?= $escaper->escapeHtmlAttr(json_encode($present, JSON_UNESCAPED_SLASHES)) ?>"
     data-chip-selected="<?= $escaper->escapeHtmlAttr($chipSelectedClass) ?>">

    <h1 id="<?= $escaper->escapeHtmlAttr($titleId) ?>"
        class="mb-6 text-center font-heading text-h1 font-normal text-balance text-ink
               lg:mb-8 lg:text-h1-desktop">
        <?= $escaper->escapeHtml($title) ?>
    </h1>

    <?php if ($intro !== ''): ?>
        <div class="mx-auto mb-8 max-w-2xl text-center text-copy text-pretty lg:mb-10 lg:text-copy-desktop
                    [&_a]:font-bold [&_a]:underline [&_a]:underline-offset-4 [&_li]:my-1 [&_p]:m-0 [&_p]:text-ink
                    [&_p+p]:mt-4 [&_ul]:my-4 [&_ul]:list-inside [&_ul]:list-disc">
            <?= /* @noEscape */ $escaper->escapeHtml($intro, $introTags) ?>
        </div>
    <?php endif; ?>

    <?php if ($people): ?>
        <div id="<?= $escaper->escapeHtmlAttr($toolbarId) ?>"
             class="mb-8 flex flex-wrap justify-center gap-2 lg:mb-10"
             role="toolbar"
             aria-label="<?= $escaper->escapeHtmlAttr(__('Filter by region')) ?>"
             @keydown="onToolbarKeydown">
            <?php foreach ($chips as $chip): ?>
                <button type="button"
                        class="<?= /* @noEscape */ $chipClass ?>"
                        data-region="<?= $escaper->escapeHtmlAttr($chip['code']) ?>"
                        @click="setRegion"
                        :aria-pressed="isRegionPressed"
                        :class="chipSelectedClass">
                    <?= $escaper->escapeHtml($chip['label']) ?>
                </button>
            <?php endforeach; ?>
        </div>

        <?php if ($heading !== ''): ?>
            <h2 id="<?= $escaper->escapeHtmlAttr($headingId) ?>"
                class="mb-6 text-center font-heading text-title-section font-normal text-balance text-ink
                       lg:mb-8 lg:text-title-section-desktop">
                <?= $escaper->escapeHtml($heading) ?>
            </h2>
        <?php endif; ?>

        <ul class="elme-team__grid m-0 grid list-none grid-cols-1 gap-8 p-0 md:grid-cols-2 lg:grid-cols-4
                   lg:gap-x-6 lg:gap-y-10"
            aria-labelledby="<?= $escaper->escapeHtmlAttr($heading !== '' ? $headingId : $titleId) ?>">
            <?php foreach ($people as $index => $person): ?>
                <li class="elme-team__card flex flex-col text-center"
                    data-region="<?= $escaper->escapeHtmlAttr($person['region']) ?>"
                    x-show="showsPerson">
                    <?php if ($person['photo'] !== null): ?>
                        <img src="<?= $escaper->escapeUrl($person['photo']['src']) ?>"
                             alt="<?= $escaper->escapeHtmlAttr($person['name']) ?>"
                             width="<?= (int)$person['photo']['width'] ?>"
                             height="<?= (int)$person['photo']['height'] ?>"
                             class="mb-4 aspect-square w-full object-cover object-top bg-surface-muted"
                             loading="<?= $index < 4 ? 'eager' : 'lazy' ?>"
                             decoding="async"/>
                    <?php else: ?>
                        <div class="mb-4 aspect-square w-full bg-surface-muted" aria-hidden="true"></div>
                    <?php endif; ?>

                    <p class="m-0 mb-1 text-note uppercase tracking-wide text-ink-muted">
                        <?= $escaper->escapeHtml($person['role']) ?>
                    </p>
                    <h3 class="m-0 mb-1 font-heading text-h3 font-normal text-ink lg:text-h3-desktop">
                        <?= $escaper->escapeHtml($person['name']) ?>
                    </h3>
                    <p class="m-0 mb-3 text-note text-ink-subtle">
                        <?= $escaper->escapeHtml($person['region_label']) ?>
                    </p>

                    <?php if ($person['email'] !== ''): ?>
                        <a href="<?= $escaper->escapeUrl($person['mailto']) ?>"
                           class="<?= /* @noEscape */ $contactClass ?>"
                           aria-label="<?= $escaper->escapeHtmlAttr(__('Email %1', $person['name'])) ?>">
                            <?= $escaper->escapeHtml($person['email']) ?>
                        </a>
                    <?php endif; ?>
                    <?php if ($person['tel'] !== ''): ?>
                        <a href="<?= $escaper->escapeUrl('tel:' . $person['tel']) ?>"
                           class="<?= /* @noEscape */ $contactClass ?> mt-1"
                           aria-label="<?= $escaper->escapeHtmlAttr(__('Call %1', $person['name'])) ?>">
                            <?= $escaper->escapeHtml($person['phone']) ?>
                        </a>
                    <?php endif; ?>
                </li>
            <?php endforeach; ?>
        </ul>

        <p class="mx-auto mt-8 max-w-md text-center text-copy text-ink-muted lg:text-copy-desktop"
           x-show="isEmpty"
           x-cloak
           role="status">
            <?= $escaper->escapeHtml(__('No team members in this region right now.')) ?>
        </p>
    <?php endif; ?>
</div>
<script>
    function initElmeTeamFilter() {
        return {
            region: 'all',
            present: [],
            selectedClass: '',

            init() {
                try {
                    this.present = JSON.parse(this.$root.dataset.present || '[]');
                } catch (e) {
                    this.present = [];
                }
                this.selectedClass = this.$root.dataset.chipSelected || '';
            },

            setRegion() {
                const code = this.$event.currentTarget.dataset.region;
                if (typeof code === 'string' && code !== '') {
                    this.region = code;
                }
            },

            isRegionPressed() {
                return this.region === this.$el.dataset.region;
            },

            chipSelectedClass() {
                return this.isRegionPressed() ? this.selectedClass : '';
            },

            showsPerson() {
                return this.region === 'all' || this.region === this.$el.dataset.region;
            },

            isEmpty() {
                return this.region !== 'all' && this.present.indexOf(this.region) === -1;
            },

            onToolbarKeydown() {
                const key = this.$event.key;
                if (key !== 'ArrowRight' && key !== 'ArrowLeft' && key !== 'Home' && key !== 'End') {
                    return;
                }

                const buttons = Array.from(this.$event.currentTarget.querySelectorAll('button[data-region]'));
                if (!buttons.length) {
                    return;
                }

                const current = this.$event.target.closest('button[data-region]');
                let index = buttons.indexOf(current);
                if (index < 0) {
                    return;
                }

                this.$event.preventDefault();

                if (key === 'Home') {
                    index = 0;
                } else if (key === 'End') {
                    index = buttons.length - 1;
                } else if (key === 'ArrowRight') {
                    index = (index + 1) % buttons.length;
                } else {
                    index = (index - 1 + buttons.length) % buttons.length;
                }

                buttons[index].focus();
                this.region = buttons[index].dataset.region;
            }
        }
    }
    window.addEventListener(
        'alpine:init',
        () => Alpine.data('initElmeTeamFilter', initElmeTeamFilter),
        {once: true}
    );
</script>
<?php $hyvaCsp->registerInlineScript() ?>
