<?php
/**
 * Content Studio type `welcome_cta` (etc/content_types.xml, FE-16), "Statement"
 * (docs/design/home-middle-options.html, 1): the wholesale H1 as a large statement, words in *stars*
 * set in italic, then a rule with the text on the left and the two guest choices (apply = the content
 * button, or log in) on the right; stacked on phones. On home this is the page's only visible H1 (hero
 * stays is_page_title off). Logged-in customers already have an account, so both buttons are omitted.
 *
 * Look "intro" (home "Calm gallery", docs/design/homepage-review-options.html): the hero holds the H1, so
 * this is a short lead under it: the heading as an H2 at lead size, the text, and up to four trade facts
 * on sage rules. No buttons (the Become a Stockist block further down has the apply button).
 *
 * @var \Bart\ContentStudio\Block\Entry $block
 * @var \Magento\Framework\Escaper $escaper
 * @var \Hyva\Theme\Model\ViewModelRegistry $viewModels
 */

use Elme\LoginOnly\ViewModel\LoginOnly;

$content = $block->getContent();
$heading = trim((string)($content['heading'] ?? ''));
$text = trim((string)($content['text'] ?? ''));
$buttonLabel = trim((string)($content['button_label'] ?? ''));
$buttonLink = trim((string)($content['button_link'] ?? ''));

if ($heading === '') {
    return;
}

/** @var LoginOnly $loginOnly */
$loginOnly = $viewModels->require(LoginOnly::class);
$isGuest = !$loginOnly->isLoggedIn();
$showButton = $isGuest && $buttonLabel !== '' && $buttonLink !== '';
// *home decor* -> italic accent; escaped first, so editors cannot inject markup
$headingHtml = preg_replace('/\*([^*]+)\*/', '<em class="italic">$1</em>', (string)$escaper->escapeHtml($heading));
$headingId = 'welcome-cta-' . preg_replace('/[^a-z0-9_-]/i', '-', $block->getIdentifier());

if (($content['look'] ?? '') === 'intro'):
    $facts = [];
    foreach ((array)($content['facts'] ?? []) as $row) {
        $title = is_array($row) ? trim((string)($row['title'] ?? '')) : '';
        if ($title !== '') {
            $facts[] = ['title' => $title, 'text' => trim((string)($row['text'] ?? ''))];
        }
    }
    $facts = array_slice($facts, 0, 4);
    ?>
<section class="elme-welcome-intro mb-12 pt-10 lg:mb-18 lg:pt-16"
         aria-labelledby="<?= $escaper->escapeHtmlAttr($headingId) ?>">
    <h2 id="<?= $escaper->escapeHtmlAttr($headingId) ?>" class="elme-welcome-intro__lead">
        <?= /* @noEscape */ $headingHtml ?>
    </h2>
    <?php if ($text !== ''): ?>
        <p class="elme-welcome-intro__text"><?= $escaper->escapeHtml($text) ?></p>
    <?php endif; ?>
    <?php if ($facts): ?>
        <ul class="elme-welcome-intro__facts">
            <?php foreach ($facts as $fact): ?>
                <li class="elme-welcome-intro__fact">
                    <span class="elme-welcome-intro__fact-title"><?= $escaper->escapeHtml($fact['title']) ?></span>
                    <?php if ($fact['text'] !== ''): ?>
                        <span class="elme-welcome-intro__fact-text"><?= $escaper->escapeHtml($fact['text']) ?></span>
                    <?php endif; ?>
                </li>
            <?php endforeach; ?>
        </ul>
    <?php endif; ?>
</section>
    <?php
    return;
endif;
?>
<section class="elme-welcome-cta mb-10 pt-6 lg:mb-15 lg:pt-12"
         aria-labelledby="<?= $escaper->escapeHtmlAttr($headingId) ?>">
    <h1 id="<?= $escaper->escapeHtmlAttr($headingId) ?>"
        class="elme-welcome-cta__heading text-balance font-heading font-normal text-ink">
        <?= /* @noEscape */ $headingHtml ?>
    </h1>
    <?php if ($text !== '' || $isGuest): ?>
        <div class="mt-6 grid gap-5 border-t border-border pt-5
                    md:grid-cols-[1fr_auto] md:items-end md:gap-x-16 lg:mt-10 lg:pt-7">
            <?php if ($text !== ''): ?>
                <p class="max-w-120 text-copy text-pretty text-ink-muted lg:text-copy-desktop">
                    <?= $escaper->escapeHtml($text) ?>
                </p>
            <?php endif; ?>
            <?php if ($isGuest): ?>
                <div class="flex flex-col gap-3 sm:flex-row sm:flex-wrap">
                    <?php if ($showButton): ?>
                        <a href="<?= $escaper->escapeUrl($buttonLink) ?>" class="btn btn-primary sm:min-w-54">
                            <?= $escaper->escapeHtml($buttonLabel) ?>
                        </a>
                    <?php endif; ?>
                    <a href="<?= $escaper->escapeUrl($block->getUrl('customer/account/login')) ?>"
                       class="btn btn-secondary sm:min-w-40">
                        <?= $escaper->escapeHtml(__('Log in')) ?>
                    </a>
                </div>
            <?php endif; ?>
        </div>
    <?php endif; ?>
</section>
