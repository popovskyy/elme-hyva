<?php
/**
 * Content Studio type `proof_pillars` (FE-61): image + trade-proof pillars with one link each.
 *
 * @var \Bart\ContentStudio\Block\Entry $block
 * @var \Magento\Framework\Escaper $escaper
 * @var \Hyva\Theme\Model\ViewModelRegistry $viewModels
 */

use Elme\Theme\ViewModel\ProofPillars;

$proof = $block->getTypeViewModel();
if (!$proof instanceof ProofPillars) {
    return;
}

$content = $block->getContent();
$heading = $proof->getHeading($content);
$image = $proof->getImage($content);
$items = $proof->getItems($content);

if ($heading === '' || $image === null || !$items) {
    return;
}

$headingId = 'proof-pillars-' . preg_replace('/[^a-z0-9_-]/i', '-', $block->getIdentifier());
?>
<section class="elme-proof-pillars -mx-(--entry-bleed) mb-10 flex flex-col lg:mb-15 lg:flex-row"
         aria-labelledby="<?= $escaper->escapeHtmlAttr($headingId) ?>">
    <div class="mb-6 lg:mb-0 lg:w-1/2 lg:shrink-0">
        <img src="<?= $escaper->escapeUrl($image['src']) ?>"
             alt="<?= $escaper->escapeHtmlAttr($image['alt']) ?>"
             width="<?= (int) $image['width'] ?>"
             height="<?= (int) $image['height'] ?>"
             loading="lazy"
             decoding="async"
             class="block h-auto w-full">
    </div>
    <div class="flex flex-col justify-center px-5 text-left
                lg:w-1/2 lg:max-w-160 lg:pr-5 lg:pl-18">
        <h2 id="<?= $escaper->escapeHtmlAttr($headingId) ?>"
            class="mb-6 text-title-section text-ink lg:mb-8 lg:text-title-section-desktop">
            <?= $escaper->escapeHtml($heading) ?>
        </h2>
        <ul class="m-0 list-none p-0">
            <?php foreach ($items as $item): ?>
                <li class="border-b border-border py-5 first:pt-0 last:border-b-0 last:pb-0
                           lg:py-5.5 lg:last:pb-0">
                    <h3 class="mb-2 text-h5 font-normal text-ink lg:text-h5-desktop">
                        <?= $escaper->escapeHtml($item['title']) ?>
                    </h3>
                    <?php if ($item['text'] !== ''): ?>
                        <p class="m-0 mb-3 text-copy text-ink lg:text-copy-desktop">
                            <?= $escaper->escapeHtml($item['text']) ?>
                        </p>
                    <?php endif; ?>
                    <?php if ($item['link'] !== ''): ?>
                        <a href="<?= $escaper->escapeUrl($item['link']) ?>"
                           class="text-copy font-medium text-primary underline-offset-4 hover:underline
                                  lg:text-copy-desktop">
                            <?= $escaper->escapeHtml($item['link_label']) ?>
                        </a>
                    <?php endif; ?>
                </li>
            <?php endforeach; ?>
        </ul>
    </div>
</section>
