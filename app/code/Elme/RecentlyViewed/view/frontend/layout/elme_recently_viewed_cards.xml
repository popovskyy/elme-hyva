<?xml version="1.0"?>
<!--
/**
 * Isolated handle for GET /recently_viewed/products/cards — FE-19 tiles only, no page chrome.
 */
-->
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <update handle="catalog_list_item"/>
    <body>
        <block class="Magento\Framework\View\Element\FormKey" name="formkey"/>
        <block class="Elme\RecentlyViewed\Block\Cards"
               name="elme.recently.viewed.cards"
               template="Elme_RecentlyViewed::cards.phtml"/>
    </body>
</page>
