<?xml version="1.0"?>
<!--
/**
 * FE-24: register viewed product in browser storage (no prices). Strip UI ships on PLP;
 * FE-30 places Elme_RecentlyViewed::strip-products.phtml on the PDP (below).
 * Replace Hyvä register that stored catalog prices in localStorage.
 */
-->
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceBlock name="recently_viewed_products.default_widget_pdp" remove="true"/>
        <referenceBlock name="recently_viewed_products.register_view" remove="true"/>

        <!-- FE-30: last block of the page (after Instagram and Our Difference), so its late AJAX fill moves nothing
             below it; the product on the page is left out -->
        <referenceContainer name="content">
            <block class="Magento\Framework\View\Element\Template"
                   name="elme.recently.viewed.products"
                   template="Elme_RecentlyViewed::strip-products.phtml"
                   after="elme.our.difference">
                <arguments>
                    <argument name="exclude_current_product" xsi:type="boolean">true</argument>
                </arguments>
            </block>
        </referenceContainer>

        <referenceContainer name="after.body.start">
            <block class="Magento\Framework\View\Element\Template"
                   name="elme.recently.viewed.storage"
                   template="Elme_RecentlyViewed::js/storage.phtml"/>
        </referenceContainer>
        <referenceContainer name="before.body.end">
            <block class="Magento\Framework\View\Element\Template"
                   name="elme.recently.viewed.register.product"
                   template="Elme_RecentlyViewed::register-product.phtml"/>
        </referenceContainer>
    </body>
</page>
