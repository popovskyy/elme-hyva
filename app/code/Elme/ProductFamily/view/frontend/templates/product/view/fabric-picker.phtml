<?php
/**
 * Elme FE-85: "Select Color:" fabric picker of the PDP for a colour axis that has made-to-order options
 * (sofas and other upholstery). A collapsed field (current fabric, thumbnail + name) opens a panel with the
 * fabrics in two groups, "Quick Ship" and "Made To Order: With you in 14 weeks" + an info icon whose text is the
 * CMS block pdp_make_to_order_info_tooltip. An empty group is not printed. Every fabric is a link to the sibling
 * product page (swatch = navigation, as FE-28); the current one is marked and not a link.
 * Fed by family.phtml: `axis` (ProductFamily::getAxes()) and `picker` (ProductFamily::getFabricPicker()).
 * Look: web/tailwind/elme/product/fabric-picker.css. Lead time: Stores > Configuration > Elme > Catalog.
 */

declare(strict_types=1);

use Elme\ProductFamily\Model\FabricGroups;
use Hyva\Theme\Model\ViewModelRegistry;
use Hyva\Theme\ViewModel\HyvaCsp;
use Hyva\Theme\ViewModel\LucideIcons;
use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;

/** @var Template $block */
/** @var Escaper $escaper */
/** @var ViewModelRegistry $viewModels */

$axis = $block->getData('axis');
$picker = $block->getData('picker');
if (!is_array($axis) || !is_array($picker) || !$picker['groups']) {
    return;
}

/** @var LucideIcons $lucideIcons */
$lucideIcons = $viewModels->require(LucideIcons::class);
/** @var HyvaCsp $hyvaCsp */
$hyvaCsp = $viewModels->require(HyvaCsp::class);

$uid = 'elme-fabric-' . preg_replace('/[^a-z0-9_-]/i', '', (string) $axis['code']);
$labelId = $uid . '-label';
$panelId = $uid . '-panel';
$infoId = $uid . '-info';

$selected = $picker['selected'];
$selectedLabel = $selected ? (string) $selected['label'] : '';
// the admin text of the info icon; no text, no icon. Page Builder wraps even an empty block in a <style> tag,
// so style and script elements do not count as text.
$infoHtml = trim((string) $block->getChildHtml('product.info.family.fabric.info'));
$hasInfo = trim(strip_tags((string) preg_replace('#<(style|script)\b[^>]*>.*?</\1>#is', '', $infoHtml))) !== '';
$groupTitles = [
    FabricGroups::QUICK_SHIP => (string) __('Quick Ship:'),
    FabricGroups::MADE_TO_ORDER => (string) __('Made To Order:'),
];

/** The fabric: its image, else its colour, else the first letters of the name. */
$renderFill = static function (array $option, string $class, int $size, bool $lazy) use ($escaper): string {
    if ($option['image'] !== '') {
        return '<img src="' . $escaper->escapeUrl($option['image']) . '" alt="" width="' . $size . '" height="' . $size . '"'
            . ($lazy ? ' loading="lazy"' : '') . ' class="' . $class . '">';
    }
    if ($option['color'] !== '') {
        return '<span class="' . $class . '" style="background-color: ' . $escaper->escapeHtmlAttr($option['color']) . '"></span>';
    }

    return '<span class="' . $class . ' elme-fabric__fill--text" aria-hidden="true">'
        . $escaper->escapeHtml(mb_substr((string) $option['label'], 0, 2)) . '</span>';
};
?>
<div class="elme-fabric"
     x-data="initElmeFabricPicker"
     @keydown.escape.window="onEscape"
     @click.window="onWindowClick"
     @focusin.window="onWindowFocus">
    <p class="elme-family__label" id="<?= /* @noEscape */ $labelId ?>">
        <span class="elme-family__name"><?= $escaper->escapeHtml(__('Select %1:', $axis['label'])) ?></span>
        <?php if ($selectedLabel !== ''): ?>
            <span class="elme-family__value"><?= $escaper->escapeHtml($selectedLabel) ?></span>
        <?php endif; ?>
    </p>

    <button type="button"
            class="elme-fabric__trigger"
            x-ref="trigger"
            aria-haspopup="true"
            aria-controls="<?= /* @noEscape */ $panelId ?>"
            aria-expanded="false"
            :aria-expanded="open"
            aria-labelledby="<?= /* @noEscape */ $labelId ?>"
            @click="toggle">
        <?php if ($selected): ?>
            <?= /* @noEscape */ $renderFill($selected, 'elme-fabric__thumb', 112, false) ?>
        <?php endif; ?>
        <span class="elme-fabric__current"><?= $escaper->escapeHtml($selectedLabel !== '' ? $selectedLabel : __('Choose')) ?></span>
        <?= $lucideIcons->chevronDownHtml('elme-fabric__chevron', 20, 20, ['aria-hidden' => 'true']) ?>
    </button>

    <div class="elme-fabric__panel"
         id="<?= /* @noEscape */ $panelId ?>"
         role="group"
         aria-labelledby="<?= /* @noEscape */ $labelId ?>"
         x-show="open"
         x-cloak>
        <?php foreach ($picker['groups'] as $group): ?>
            <section class="elme-fabric__group elme-fabric__group--<?= $escaper->escapeHtmlAttr(str_replace('_', '-', $group['code'])) ?>">
                <div class="elme-fabric__group-head">
                    <h3 class="elme-fabric__group-title"><?= $escaper->escapeHtml($groupTitles[$group['code']] ?? '') ?></h3>
                    <?php if ($group['code'] === FabricGroups::MADE_TO_ORDER && ($group['leadTime'] !== '' || $hasInfo)): ?>
                        <p class="elme-fabric__lead">
                            <?php if ($group['leadTime'] !== ''): ?>
                                <span><?= $escaper->escapeHtml($group['leadTime']) ?></span>
                            <?php endif; ?>
                            <?php if ($hasInfo): ?>
                                <button type="button"
                                        class="elme-fabric__info-btn"
                                        x-ref="infoBtn"
                                        aria-controls="<?= /* @noEscape */ $infoId ?>"
                                        aria-expanded="false"
                                        :aria-expanded="infoOpen"
                                        aria-label="<?= $escaper->escapeHtmlAttr(__('About Quick Ship and Made To Order')) ?>"
                                        @click="toggleInfo">
                                    <?= $lucideIcons->infoHtml('', 18, 18, ['aria-hidden' => 'true']) ?>
                                </button>
                            <?php endif; ?>
                        </p>
                    <?php endif; ?>
                </div>
                <?php if ($group['code'] === FabricGroups::MADE_TO_ORDER && $hasInfo): ?>
                    <div class="elme-fabric__note"
                         id="<?= /* @noEscape */ $infoId ?>"
                         x-show="infoOpen"
                         x-cloak>
                        <?= /* @noEscape */ $infoHtml ?>
                    </div>
                <?php endif; ?>

                <ul class="elme-fabric__list" role="list">
                    <?php foreach ($group['options'] as $option): ?>
                        <?php
                        $label = (string) $option['label'];
                        $state = $option['selected'] ? ' is-selected' : ($option['available'] ? '' : ' is-unavailable');
                        $itemClass = 'elme-fabric__item' . $state;
                        $inner = '<span class="elme-fabric__swatch">'
                            . $renderFill($option, 'elme-fabric__img', 112, true)
                            . '</span>'
                            . '<span class="elme-fabric__name">' . $escaper->escapeHtml($label) . '</span>';
                        ?>
                        <li>
                            <?php if ($option['selected']): ?>
                                <span class="<?= /* @noEscape */ $itemClass ?>" aria-current="true">
                                    <?= /* @noEscape */ $inner ?>
                                    <span class="sr-only"><?= $escaper->escapeHtml(__(', selected')) ?></span>
                                </span>
                            <?php else: ?>
                                <a href="<?= $escaper->escapeUrl($option['url']) ?>"
                                   class="<?= /* @noEscape */ $itemClass ?>"
                                   <?php if ($option['note'] !== ''): ?>
                                   title="<?= $escaper->escapeHtmlAttr($label . ' - ' . $option['note']) ?>"
                                   <?php endif; ?>>
                                    <?= /* @noEscape */ $inner ?>
                                    <?php if ($option['note'] !== ''): ?>
                                        <span class="sr-only">, <?= $escaper->escapeHtml(lcfirst($option['note'])) ?></span>
                                    <?php endif; ?>
                                </a>
                            <?php endif; ?>
                        </li>
                    <?php endforeach; ?>
                </ul>
            </section>
        <?php endforeach; ?>
    </div>

    <script>
        function initElmeFabricPicker() {
            return {
                open: false,
                infoOpen: false,
                observer: null,

                init() {
                    // The panel hangs under its field: once the field has scrolled out of view there is nothing
                    // to anchor it to, so close it rather than leave it open out of sight.
                    if (typeof IntersectionObserver === 'function') {
                        this.observer = new IntersectionObserver((entries) => {
                            entries.forEach((entry) => {
                                if (!entry.isIntersecting) {
                                    this.close();
                                }
                            });
                        });
                        this.observer.observe(this.$refs.trigger);
                    }
                },

                toggle() {
                    if (this.open) {
                        this.close();
                    } else {
                        this.open = true;
                    }
                },

                close() {
                    this.open = false;
                    this.infoOpen = false;
                },

                toggleInfo() {
                    this.infoOpen = !this.infoOpen;
                },

                // Esc closes the info note first, then the panel, and hands focus back to where it came from
                onEscape() {
                    if (this.infoOpen) {
                        this.infoOpen = false;
                        if (this.$refs.infoBtn) {
                            this.$refs.infoBtn.focus();
                        }
                    } else if (this.open) {
                        this.close();
                        this.$refs.trigger.focus();
                    }
                },

                onWindowClick() {
                    if (this.open && !this.$root.contains(this.$event.target)) {
                        this.close();
                    }
                },

                // keyboard: tabbing past the last fabric leaves the picker, so it closes
                onWindowFocus() {
                    if (this.open && !this.$root.contains(this.$event.target)) {
                        this.close();
                    }
                }
            };
        }

        window.addEventListener('alpine:init', () => Alpine.data('initElmeFabricPicker', initElmeFabricPicker), {once: true});
    </script>
    <?php $hyvaCsp->registerInlineScript() ?>
</div>
