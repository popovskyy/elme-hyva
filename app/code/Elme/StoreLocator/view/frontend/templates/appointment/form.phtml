            <script>
                function initElmeAppointmentForm() {
                    const WEEKDAYS = ['sunday', 'monday', 'tuesday', 'wednesday', 'thursday', 'friday', 'saturday'];

                    return {
                        schedule: {},
                        openDays: {},
                        dayNames: {},
                        showroom: '',
                        dateError: '',
                        submitting: false,
                        submitIdleLabel: '<?= $escaper->escapeJs(__('Request appointment')) ?>',
                        submitBusyLabel: '<?= $escaper->escapeJs(__('Sending...')) ?>',
                        openPrefix: '<?= $escaper->escapeJs(__('Open')) ?>',

                        init() {
                            const data = this.$root.dataset;
                            this.schedule = JSON.parse(data.schedule || '{}');
                            this.openDays = JSON.parse(data.openDays || '{}');
                            this.dayNames = JSON.parse(data.dayNames || '{}');
                            this.showroom = this.$refs.showroom.value;
                            this.refreshSlots();
                        },

                        isSubmitting() {
                            return this.submitting;
                        },

                        submitLabel() {
                            return this.submitting ? this.submitBusyLabel : this.submitIdleLabel;
                        },

                        openDaysLabel() {
                            const label = this.openDays[this.showroom] || '';
                            return label ? this.openPrefix + ' ' + label : '';
                        },

                        onShowroomChange() {
                            this.showroom = this.$event.target.value;
                            this.refreshSlots();
                        },

                        onDateChange() {
                            this.refreshSlots();
                        },

                        slotsFor(value) {
                            const showroom = this.schedule[this.showroom];
                            const match = /^(\d{4})-(\d{2})-(\d{2})$/.exec(value || '');
                            if (!showroom || !match) {
                                return null;
                            }
                            if (Object.prototype.hasOwnProperty.call(showroom.holidays, value)) {
                                return { slots: showroom.holidays[value], holiday: true };
                            }
                            const day = WEEKDAYS[new Date(Date.UTC(+match[1], +match[2] - 1, +match[3])).getUTCDay()];

                            return { slots: showroom.days[day] || [], holiday: false, day: day };
                        },

                        refreshSlots() {
                            const dateInput = this.$refs.date;
                            const timeSelect = this.$refs.time;
                            const result = this.slotsFor(dateInput.value);
                            const allowed = result ? result.slots : null;

                            Array.from(timeSelect.options).forEach((option) => {
                                if (option.value === '') {
                                    return;
                                }
                                const off = allowed !== null && allowed.indexOf(option.value) === -1;
                                option.disabled = off;
                                option.hidden = off;
                            });
                            if (timeSelect.selectedOptions[0] && timeSelect.selectedOptions[0].disabled) {
                                timeSelect.value = '';
                            }

                            this.dateError = '';
                            if (result && result.slots.length === 0) {
                                const data = this.$root.dataset;
                                this.dateError = result.holiday
                                    ? data.closedDate
                                    : data.closedDay.replace('%1', this.dayNames[result.day] || result.day);
                            }
                            dateInput.setCustomValidity(this.dateError);
                        },

                        onSubmit() {
                            if (this.submitting) {
                                this.$event.preventDefault();
                                return;
                            }
                            const form = this.$event.target;
                            if (!form.checkValidity()) {
                                this.$event.preventDefault();
                                form.reportValidity();
                                return;
                            }
                            this.submitting = true;
                        }
                    };
                }
                window.addEventListener(
                    'alpine:init',
                    () => Alpine.data('initElmeAppointmentForm', initElmeAppointmentForm),
                    { once: true }
                );
            </script>
