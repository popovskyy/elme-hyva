<script>
    function initElmeStoreLocator() {
        return {
            locations: [],
            visibleKeys: [],
            query: '',
            state: '',
            message: '',
            origin: null,
            selectedKey: '',

            init() {
                try {
                    this.locations = JSON.parse(this.$root.dataset.locations || '[]');
                } catch (e) {
                    this.locations = [];
                }
                this.visibleKeys = this.locations.map(function (loc) { return loc.url_key; });
                this.selectedKey = this.visibleKeys[0] || '';
                this.$watch('selectedKey', () => this.syncMap());
                this.syncMap();
            },

            hasMessage() {
                return this.message !== '';
            },

            isEmpty() {
                return this.visibleKeys.length === 0;
            },

            setQuery() {
                this.query = this.$event.target.value;
            },

            setStateFilter() {
                const next = this.$el.dataset.state || '';
                this.state = this.state === next ? '' : next;
                this.applyFilters();
            },

            isStatePressed() {
                return this.state === (this.$el.dataset.state || '');
            },

            stateFilterClass() {
                return {
                    'border-ink bg-sand-light font-medium': this.isStatePressed()
                };
            },

            isCardVisible() {
                const key = this.$el.dataset.urlKey;
                return this.visibleKeys.indexOf(key) !== -1;
            },

            cardHighlightClass() {
                return {
                    'ring-1 ring-ink': this.selectedKey === this.$el.dataset.urlKey
                };
            },

            selectCard() {
                const key = this.$el.dataset.urlKey;
                if (key) {
                    this.selectedKey = key;
                }
            },

            hasDistance() {
                const key = this.$el.dataset.urlKey;
                const loc = this.findByKey(key);
                return !!(loc && loc.distance_km !== null && loc.distance_km !== undefined);
            },

            cardDistanceLabel() {
                const loc = this.findByKey(this.$el.dataset.urlKey);
                if (!loc || loc.distance_km === null || loc.distance_km === undefined) {
                    return '';
                }
                const km = loc.distance_km;
                if (km < 1) {
                    return Math.round(km * 1000) + ' m';
                }
                return (Math.round(km * 10) / 10) + ' km';
            },

            findByKey(key) {
                return this.locations.find(function (loc) { return loc.url_key === key; }) || null;
            },

            search() {
                this.message = '';
                const q = (this.query || '').trim();
                if (q === '') {
                    this.clearDistances();
                    this.applyFilters();
                    return;
                }

                const postcode = q.match(/^\d{4}$/);
                let originLoc = null;

                if (postcode) {
                    originLoc = this.locations.find(function (loc) { return loc.postcode === q; }) || null;
                }
                if (!originLoc) {
                    const needle = q.toLowerCase();
                    originLoc = this.locations.find(function (loc) {
                        return (loc.city || '').toLowerCase().indexOf(needle) !== -1
                            || (loc.name || '').toLowerCase().indexOf(needle) !== -1
                            || (loc.postcode || '') === q;
                    }) || null;
                }

                if (!originLoc || originLoc.lat === null || originLoc.lng === null) {
                    this.message = <?= /* @noEscape */ json_encode((string) __('No location matches that suburb or postcode. Try 3130, Blackburn, Tarneit, St Marys or Richlands.')) ?>;
                    this.clearDistances();
                    this.applyFilters();
                    return;
                }

                this.origin = { lat: originLoc.lat, lng: originLoc.lng };
                this.sortByDistance();
                this.applyFilters();
                if (this.visibleKeys.length) {
                    this.selectedKey = this.visibleKeys[0];
                }
            },

            useCurrentLocation() {
                this.message = '';
                if (!navigator.geolocation) {
                    this.message = <?= /* @noEscape */ json_encode((string) __('Your browser does not support location services. Search by suburb or postcode instead.')) ?>;
                    return;
                }

                navigator.geolocation.getCurrentPosition(
                    (pos) => {
                        this.origin = {
                            lat: pos.coords.latitude,
                            lng: pos.coords.longitude
                        };
                        this.sortByDistance();
                        this.applyFilters();
                        if (this.visibleKeys.length) {
                            this.selectedKey = this.visibleKeys[0];
                        }
                    },
                    () => {
                        this.message = <?= /* @noEscape */ json_encode((string) __('Location access was denied. Search by suburb or postcode, or filter by state.')) ?>;
                    },
                    { enableHighAccuracy: false, timeout: 10000 }
                );
            },

            clearDistances() {
                this.origin = null;
                this.locations.forEach(function (loc) { loc.distance_km = null; });
            },

            sortByDistance() {
                if (!this.origin) {
                    return;
                }
                const origin = this.origin;
                this.locations.forEach((loc) => {
                    if (loc.lat === null || loc.lng === null) {
                        loc.distance_km = null;
                        return;
                    }
                    loc.distance_km = this.haversine(origin.lat, origin.lng, loc.lat, loc.lng);
                });
                this.locations.sort(function (a, b) {
                    const da = a.distance_km === null ? Number.MAX_VALUE : a.distance_km;
                    const db = b.distance_km === null ? Number.MAX_VALUE : b.distance_km;
                    return da - db;
                });
            },

            applyFilters() {
                const state = this.state;
                this.visibleKeys = this.locations
                    .filter(function (loc) { return !state || loc.state === state; })
                    .map(function (loc) { return loc.url_key; });

                // Re-order DOM list to match distance sort when searching.
                const list = this.$root.querySelector('.elme-locator__list');
                if (list) {
                    this.locations.forEach((loc) => {
                        const el = list.querySelector('[data-url-key="' + loc.url_key + '"]');
                        if (el) {
                            list.appendChild(el);
                        }
                    });
                }

                if (this.visibleKeys.indexOf(this.selectedKey) === -1) {
                    this.selectedKey = this.visibleKeys[0] || '';
                }
                this.syncMap();
            },

            syncMap() {
                const loc = this.findByKey(this.selectedKey) || this.locations[0];
                if (!loc) {
                    return;
                }
                this.$dispatch('elme-locator-map', { src: loc.map_embed_url });
            },

            haversine(lat1, lng1, lat2, lng2) {
                const toRad = Math.PI / 180;
                const dLat = (lat2 - lat1) * toRad;
                const dLng = (lng2 - lng1) * toRad;
                const a = Math.sin(dLat / 2) * Math.sin(dLat / 2)
                    + Math.cos(lat1 * toRad) * Math.cos(lat2 * toRad)
                    * Math.sin(dLng / 2) * Math.sin(dLng / 2);
                return 6371 * 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));
            }
        };
    }

    function initElmeDeferredMap() {
        return {
            loaded: false,
            mapSrc: '',

            onMapEvent() {
                const detail = this.$event.detail || {};
                if (detail.src) {
                    this.mapSrc = detail.src;
                }
            },

            isLoaded() {
                return this.loaded && this.mapSrc !== '';
            },

            isNotLoaded() {
                return !this.loaded;
            },

            loadMap() {
                this.loaded = true;
            }
        };
    }

    window.addEventListener('alpine:init', () => {
        Alpine.data('initElmeStoreLocator', initElmeStoreLocator);
        Alpine.data('initElmeDeferredMap', initElmeDeferredMap);
    }, { once: true });
</script>
<?php $hyvaCsp->registerInlineScript() ?>
