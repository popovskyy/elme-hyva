<script>
    function initElmeLocationMap() {
        return {
            loaded: false,
            mapSrc: '',

            init() {
                this.mapSrc = this.$root.dataset.mapSrc || '';
            },

            isLoaded() {
                return this.loaded && this.mapSrc !== '';
            },

            isNotLoaded() {
                return !this.loaded;
            },

            loadMap() {
                this.loaded = true;
            }
        };
    }
    function initElmeLocationSchedule() {
        return {
            week: 0,
            labels: [],
            todayIso: '',

            init() {
                try {
                    this.labels = JSON.parse(this.$root.dataset.labels || '[]');
                } catch (e) {
                    this.labels = [];
                }
                this.todayIso = this.storeToday(this.$root.dataset.timezone || '');
                // A cached page can be a few days old: open the week that holds today.
                const row = this.todayIso
                    ? this.$root.querySelector('[data-iso="' + this.todayIso + '"]')
                    : null;
                const table = row ? row.closest('[data-week]') : null;
                if (table) {
                    this.week = parseInt(table.dataset.week, 10) || 0;
                }
            },

            storeToday(timeZone) {
                try {
                    const parts = new Intl.DateTimeFormat('en-CA', {
                        timeZone: timeZone || undefined,
                        year: 'numeric',
                        month: '2-digit',
                        day: '2-digit'
                    }).formatToParts(new Date());
                    const part = (type) => (parts.find((p) => p.type === type) || {}).value || '';
                    return part('year') + '-' + part('month') + '-' + part('day');
                } catch (e) {
                    return '';
                }
            },

            isToday() {
                return this.todayIso !== '' && this.$el.dataset.iso === this.todayIso;
            },

            dayClass() {
                const today = this.isToday();
                return { 'bg-sand-light': today, 'font-semibold': today };
            },

            ariaCurrent() {
                return this.isToday() ? 'date' : false;
            },

            isWeekShown() {
                return parseInt(this.$el.dataset.week, 10) === this.week;
            },

            weekLabel() {
                return this.labels[this.week] || '';
            },

            isFirstWeek() {
                return this.week === 0;
            },

            isLastWeek() {
                return this.week >= this.labels.length - 1;
            },

            prevWeek() {
                if (this.week > 0) {
                    this.week--;
                }
            },

            nextWeek() {
                if (this.week < this.labels.length - 1) {
                    this.week++;
                }
            }
        };
    }

    window.addEventListener('alpine:init', () => {
        Alpine.data('initElmeLocationMap', initElmeLocationMap);
        Alpine.data('initElmeLocationSchedule', initElmeLocationSchedule);
    }, { once: true });
</script>
<?php $hyvaCsp->registerInlineScript() ?>
