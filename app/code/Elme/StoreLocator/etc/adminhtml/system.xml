<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <tab id="elme" translate="label" sortOrder="400">
            <label>Elme</label>
        </tab>
        <section id="elme_storelocator" translate="label" sortOrder="90" showInDefault="1"
                 showInWebsite="1" showInStore="0">
            <label>Showroom Locator</label>
            <tab>elme</tab>
            <resource>Elme_StoreLocator::location</resource>
            <group id="maps" translate="label" sortOrder="10" showInDefault="1" showInWebsite="1"
                   showInStore="0">
                <label>Google Maps</label>
                <field id="api_key" translate="label comment" type="text" sortOrder="10"
                       showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>API Key</label>
                    <comment>Optional Google Maps Embed API key. Keys are usually locked to the live domain, so leave empty on local and staging: the map then uses the keyless embed.</comment>
                </field>
            </group>
        </section>
    </system>
</config>
