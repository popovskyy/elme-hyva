<div class="studio-topbar<?= $block->isEmbedded() ? ' studio-topbar--embedded' : '' ?>">
    <?php
    /*
     * The module's own "back" sits on the left, where a back control is
     * expected and its chevron points that way - back to the listing, the
     * one place inside Content Studio this page could have come from. Not
     * shown on the listing itself: it is the page the link points at.
     *
     * Leaving the module entirely (to core Magento admin) is a rarer, less
     * urgent action, so it sits on the *right* as a quieter text link rather
     * than competing with this for the primary top-left spot - that spot
     * used to be "Magento Admin", and it read as the only way back anywhere,
     * including into the module itself, which it is not.
     *
     * Neither is rendered when the editor is framed in another admin form:
     * both would navigate the *frame*, leaving the author looking at the grid
     * or the dashboard inside a modal with no way back. See isEmbedded().
     */
    ?>
    <?php if ($block->isBackLinkVisible()): ?>
        <a class="studio-topbar__exit" href="<?= $escaper->escapeUrl($block->getListUrl()) ?>">
            <svg class="studio-icon studio-topbar__exit-icon" aria-hidden="true">
                <use href="#studio-icon-back"></use>
            </svg>
            <span>Back to Content Studio</span>
        </a>
    <?php endif; ?>

    <span class="studio-topbar__title studio-topbar__center">
        <svg class="studio-icon studio-topbar__mark" aria-hidden="true"><use href="#studio-icon-mark"></use></svg>
        <span>Content Studio</span>
    </span>

    <?php if (!$block->isEmbedded()): ?>
        <a class="studio-topbar__admin-exit" href="<?= $escaper->escapeUrl($block->getDashboardUrl()) ?>">
            <span>Magento Admin</span>
            <svg class="studio-icon studio-topbar__admin-exit-icon" aria-hidden="true">
                <use href="#studio-icon-external"></use>
            </svg>
        </a>
    <?php endif; ?>
</div>
