<?xml version="1.0" encoding="UTF-8"?>
<!--
    Edit form of the "Content Studio" Page Builder type. Same shape as
    Page Builder's pagebuilder_block_form: a chooser button that opens a grid
    in a modal, and a hidden field that takes the picked row. The picked value
    is the entry identifier, which the mass converter writes into the widget
    directive.
-->
<form xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd"
      extends="pagebuilder_base_form">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">bart_content_studio_pagebuilder_form.bart_content_studio_pagebuilder_form_data_source</item>
        </item>
        <item name="label" xsi:type="string" translate="true">Content Studio</item>
    </argument>
    <settings>
        <deps>
            <dep>bart_content_studio_pagebuilder_form.bart_content_studio_pagebuilder_form_data_source</dep>
        </deps>
        <namespace>bart_content_studio_pagebuilder_form</namespace>
    </settings>
    <dataSource name="bart_content_studio_pagebuilder_form_data_source">
        <argument name="data" xsi:type="array">
            <item name="js_config" xsi:type="array">
                <item name="component" xsi:type="string">Magento_PageBuilder/js/form/provider</item>
            </item>
        </argument>
        <dataProvider name="bart_content_studio_pagebuilder_form_data_source"
                      class="Magento\PageBuilder\Model\ContentType\DataProvider">
            <settings>
                <requestFieldName/>
                <primaryFieldName/>
            </settings>
        </dataProvider>
    </dataSource>
    <fieldset name="appearance_fieldset" sortOrder="10"
              component="Magento_PageBuilder/js/form/element/dependent-fieldset">
        <settings>
            <label translate="true">Appearance</label>
            <additionalClasses>
                <class name="admin__fieldset-visual-select-large">true</class>
            </additionalClasses>
            <collapsible>false</collapsible>
            <opened>true</opened>
            <imports>
                <link name="hideFieldset">${$.name}.appearance:options</link>
                <link name="hideLabel">${$.name}.appearance:options</link>
            </imports>
        </settings>
        <field name="appearance" formElement="select" sortOrder="10"
               component="Magento_PageBuilder/js/form/element/dependent-visual-select">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="default" xsi:type="string">default</item>
                </item>
            </argument>
            <settings>
                <additionalClasses>
                    <class name="admin__field-wide">true</class>
                    <class name="admin__field-visual-select-container">true</class>
                </additionalClasses>
                <dataType>text</dataType>
                <validation>
                    <rule name="required-entry" xsi:type="boolean">true</rule>
                </validation>
                <elementTmpl>Magento_PageBuilder/form/element/visual-select</elementTmpl>
            </settings>
            <formElements>
                <select>
                    <settings>
                        <!-- Page Builder's own one-option ("Default") source -->
                        <options class="AppearanceSourceBlock"/>
                    </settings>
                </select>
            </formElements>
        </field>
    </fieldset>
    <fieldset name="general" sortOrder="20">
        <settings>
            <label/>
        </settings>
        <component component="Magento_PageBuilder/js/form/element/block-chooser" name="entry_chooser" sortOrder="10">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="template" xsi:type="string">Bart_ContentStudio/form/element/entry-chooser</item>
                    <item name="requestParameter" xsi:type="string">identifier</item>
                    <item name="dataUrlConfigPath" xsi:type="string">content_types.content_studio.additional_data.chooserConfig.dataUrl</item>
                    <item name="modalName" xsi:type="string">ns = ${ $.ns }, index = modal</item>
                    <item name="buttonTitle" xsi:type="string" translate="true">Select Entry</item>
                    <item name="displayMetadata" xsi:type="boolean">true</item>
                    <item name="messages" xsi:type="array">
                        <item name="UNKOWN_ERROR" xsi:type="string" translate="true">Sorry, the entry could not be loaded. Please try again.</item>
                        <item name="UNKNOWN_SELECTION" xsi:type="string" translate="true">The selected entry no longer exists.</item>
                    </item>
                </item>
            </argument>
            <settings>
                <imports>
                    <link name="id">${ $.ns }.${ $.ns }.general.identifier:value</link>
                </imports>
            </settings>
        </component>
        <field name="identifier" formElement="hidden" sortOrder="20">
            <settings>
                <dataType>text</dataType>
                <imports>
                    <link name="value">${ $.ns }.${ $.ns }.modal.bart_content_studio_pagebuilder_select_grid.columns.ids:lastSelected</link>
                </imports>
            </settings>
        </field>
    </fieldset>
    <modal name="modal" sortOrder="30">
        <settings>
            <listens>
                <link name="bart_content_studio_pagebuilder_select_grid.bart_content_studio_pagebuilder_select_grid.columns.ids:lastSelected">closeModal</link>
            </listens>
            <modalClass>pagebuilder-block-modal</modalClass>
            <options>
                <option name="title" xsi:type="string" translate="true">Select Content Studio Entry</option>
            </options>
        </settings>
        <insertListing name="bart_content_studio_pagebuilder_select_grid" sortOrder="10">
            <settings>
                <externalData>identifier</externalData>
                <externalProvider>${ $.ns }.bart_content_studio_pagebuilder_select_grid_data_source</externalProvider>
                <loading>false</loading>
                <selectionsProvider>${ $.ns }.${ $.ns }.columns.ids</selectionsProvider>
                <autoRender>true</autoRender>
                <dataScope>identifier</dataScope>
                <ns>bart_content_studio_pagebuilder_select_grid</ns>
                <dataLinks>
                    <imports>false</imports>
                    <exports>true</exports>
                </dataLinks>
                <listens>
                    <link name="bart_content_studio_pagebuilder_select_grid.bart_content_studio_pagebuilder_select_grid.columns.ids:lastSelected">save</link>
                </listens>
            </settings>
        </insertListing>
    </modal>
</form>
