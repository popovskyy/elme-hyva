    "magento/framework": "*",
    "magento/module-backend": "*",
    "magento/module-cms": "*",
    "magento/module-email": "*",
    "magento/module-import-export": "*",
    "magento/module-media-storage": "*",
    "magento/module-page-builder": "*",
    "magento/module-page-cache": "*",
    "magento/module-store": "*",
    "magento/module-ui": "*",
    "magento/module-widget": "*"
