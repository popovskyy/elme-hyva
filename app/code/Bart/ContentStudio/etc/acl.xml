<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Acl/etc/acl.xsd">
    <acl>
        <resources>
            <resource id="Magento_Backend::admin">
                <resource id="Magento_Backend::content">
                    <resource id="Magento_Backend::content_elements">
                        <resource id="Bart_ContentStudio::entry"
                                  title="Content Studio" translate="title" sortOrder="90">
                            <resource id="Bart_ContentStudio::entry_save"
                                      title="Save Entry" translate="title" sortOrder="10"/>
                            <resource id="Bart_ContentStudio::entry_delete"
                                      title="Delete Entry" translate="title" sortOrder="20"/>
                            <resource id="Bart_ContentStudio::entry_export"
                                      title="Export Entries" translate="title" sortOrder="30"/>
                            <resource id="Bart_ContentStudio::entry_import"
                                      title="Import Entries" translate="title" sortOrder="40"/>
                        </resource>
                    </resource>
                </resource>
            </resource>
        </resources>
    </acl>
</config>
