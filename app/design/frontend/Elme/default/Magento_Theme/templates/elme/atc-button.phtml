<?php
/**
 * FE-70: AJAX add to cart; FE-111: its motion (look: elme/add-to-cart.css + elme/motion-burst.css).
 *
 * Opt in with the class `btn-atc` on a submit button of an add to cart form (PLP tile form, PDP
 * #product_addtocart_form via form="…"). One delegated submit listener, no Alpine, no per-button
 * handlers (CSP-safe, same pattern as btn-ripple.phtml).
 *
 * Flow: submit -> button goes to "sending" at once (aria-busy; the cart icon crossfades to a small
 * spinner, the label stays) -> POST with X-Requested-With, so Magento's cart/add answers JSON -> read
 * the "messages" section (cart/add puts its result there) -> "success" only when the server confirmed
 * it with its success message: the check springs in with "Added" (1.6s), a ring + dots burst over it
 * and, 140ms later, a round product thumbnail (a primary dot without an image) flies to the header
 * cart (window.elmeFly, elme/fly.phtml). Otherwise the button shakes, goes back to idle and the error
 * goes to the toast stack. Reduced motion: plain crossfades, no burst, no flight.
 *
 * Header (html/header.phtml): `elme-cart-landing` as soon as a flight is coming (the row slides back
 * in and the new count waits), `elme-cart-landed` when it arrives (icon squash, number rolls). No
 * flight (mobile menu or a dialog open, icon off-screen) = landed at once. The count itself always
 * comes from the server (section quick_order).
 *
 * Another control may press the button for the customer (PDP sticky bar): it sets
 * button.elmeAtcOrigin = itself around button.click(). The states then play on that control too, and
 * the burst and the flight start from it.
 *
 * Requests run one after another, so quick clicks on many tiles never race on the quote and every
 * result belongs to the right button. Clicks are never blocked: the button just shows its place in
 * the queue. A second click on a button that is still sending is ignored (accidental double add).
 * Section data (mini-cart) reloads once the queue is empty, so that reload never takes the messages
 * of an add that is still running. No fetch/FormData, or a button without the class: the form posts
 * the old way.
 */

declare(strict_types=1);

use Hyva\Theme\Model\ViewModelRegistry;
use Hyva\Theme\ViewModel\HyvaCsp;
use Hyva\Theme\ViewModel\LucideIcons;
use Magento\Framework\Escaper;

/** @var Escaper $escaper */
/** @var ViewModelRegistry $viewModels */

/** @var HyvaCsp $hyvaCsp */
$hyvaCsp = $viewModels->require(HyvaCsp::class);
/** @var LucideIcons $lucideIcons */
$lucideIcons = $viewModels->require(LucideIcons::class);
?>
<template id="elme-atc-stage">
    <span class="btn-atc__stage" aria-hidden="true">
        <span class="btn-atc__spin elme-spinner"></span>
        <span class="btn-atc__done">
            <span class="btn-atc__check"><?= $lucideIcons->checkHtml('', 24, 24) ?></span>
            <span class="btn-atc__done-label"><?= $escaper->escapeHtml(__('Added')) ?></span>
        </span>
    </span>
</template>
<div class="sr-only" role="status" aria-live="polite" id="elme-atc-status"></div>
<script>
    (function () {
        const SELECTOR = '.btn-atc';
        const HOLD_MS = 1600;
        // just enough that a fast answer does not flash the spinner
        const MIN_SENDING_MS = 300;
        // --transition-duration-slow: the error shake
        const SHAKE_MS = 300;
        // the item leaves while the burst plays (same as the heart)
        const FLY_DELAY_MS = 140;
        // the header row slides back in (--transition-duration-fast) before the cart icon is measured
        const REVEAL_MS = 220;
        const CART_ICON = '#menu-cart-icon .elme-header__icon';
        const IMAGE = '.elme-card__media img, .elme-look-thumb img, .elme-sticky-atc__thumb';
        const TEXT = {
            added: '<?= $escaper->escapeJs(__('Added to cart')) ?>',
            failed: '<?= $escaper->escapeJs(__('We couldn\'t add this item to your cart. Please try again.')) ?>'
        };

        const queue = [];
        let running = false;
        const reduced = () => window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        function findButton(form, submitter) {
            if (submitter) {
                return submitter.matches(SELECTOR) ? submitter : null;
            }
            // Enter in a qty field: no submitter in older browsers
            const inside = form.querySelector(SELECTOR);
            if (inside) {
                return inside;
            }
            return form.id
                ? document.querySelector(SELECTOR + '[form="' + CSS.escape(form.id) + '"]')
                : null;
        }

        function ensureStage(btn) {
            if (btn.querySelector('.btn-atc__stage')) {
                return;
            }
            const tpl = document.getElementById('elme-atc-stage');
            if (tpl) {
                btn.appendChild(tpl.content.cloneNode(true));
            }
        }

        // Where the idle cart icon sits (from the button centre, unscaled: the press scale may still
        // run), so the spinner and the check take its spot; icon-only buttons (label hidden at this
        // breakpoint) drop the "Added" text.
        function measure(btn) {
            const rect = btn.getBoundingClientRect();
            const scale = btn.offsetWidth ? rect.width / btn.offsetWidth : 1;
            const icon = btn.querySelector(':scope > svg');
            const label = btn.querySelector(':scope > span:not(.btn-atc__stage, .btn-ripple)');
            btn.toggleAttribute('data-atc-compact', !label || label.getClientRects().length === 0);
            let iconX = 0;
            let size = 0;
            if (icon) {
                const box = icon.getBoundingClientRect();
                iconX = (box.left + box.width / 2 - (rect.left + rect.width / 2)) / scale;
                size = box.width / scale;
                btn.style.setProperty('--atc-icon-size', Math.round(size) + 'px');
            }
            btn.style.setProperty('--atc-icon-x', Math.round(iconX) + 'px');
            // check + "Added" are centred in the stage: move them so the check sits on the icon
            const done = btn.querySelector('.btn-atc__done');
            const doneX = done ? iconX + (done.offsetWidth - size) / 2 : iconX;
            btn.style.setProperty('--atc-done-x', Math.round(doneX) + 'px');
        }

        function setState(btn, state) {
            if (state === 'sending') {
                ensureStage(btn);
                measure(btn);
            }
            btn.dataset.atcState = state;
            if (state === 'sending') {
                btn.setAttribute('aria-busy', 'true');
            } else {
                btn.removeAttribute('aria-busy');
            }
        }

        // the state now on every control of the job, back to idle after `ms` (each keeps its own timer)
        function show(views, state, ms) {
            views.forEach((view) => {
                clearTimeout(view.atcTimer);
                setState(view, state);
                if (ms) {
                    view.atcTimer = setTimeout(() => setState(view, 'idle'), ms);
                }
            });
        }

        // which burst colours read on the control right now: charcoal fill, sage hover fill, or light
        function burstTone(el) {
            const color = getComputedStyle(el).backgroundColor || '';
            const parts = (color.match(/[\d.]+/g) || []).map(Number);
            if (parts.length < 3 || parts[3] === 0) {
                return '';
            }
            const unit = color.indexOf('color(') === 0 ? 1 : 255;
            const lum = (0.2126 * parts[0] + 0.7152 * parts[1] + 0.0722 * parts[2]) / unit;
            if (lum < 0.3) {
                return 'elme-burst--on-dark';
            }
            return lum < 0.8 ? 'elme-burst--on-mid' : '';
        }

        function cartTarget() {
            if (document.documentElement.classList.contains('elme-mobile-menu-open')
                || document.querySelector('dialog[open]')) {
                return null;
            }
            return window.elmeFly.target(document.querySelector(CART_ICON));
        }

        // a loaded image of this product next to the control (its URL is reused: no new request)
        function sourceImage(origin) {
            const selector = origin.getAttribute('data-atc-image');
            const scope = origin.closest('.elme-card, .elme-look-card, .elme-sticky-atc');
            const img = selector
                ? document.querySelector(selector)
                : (scope ? scope.querySelector(IMAGE) : null);
            return img && img.complete && img.naturalWidth ? img : null;
        }

        function flyer(origin) {
            const body = document.createElement('span');
            body.className = 'elme-fly__body';
            const img = sourceImage(origin);
            if (img) {
                const copy = document.createElement('img');
                copy.src = img.currentSrc || img.src;
                copy.alt = '';
                copy.decoding = 'async';
                body.appendChild(copy);
            }
            return {body: body, className: img ? 'elme-fly--thumb' : 'elme-fly--thumb elme-fly--dot'};
        }

        function landed() {
            window.dispatchEvent(new CustomEvent('elme-cart-landed'));
        }

        // the burst on the check, then the item flies to the header cart
        function celebrate(origin, headerWasHidden) {
            const from = window.elmeFly.target(origin);
            if (from) {
                const check = origin.querySelector('.btn-atc__check');
                const box = check ? check.getBoundingClientRect() : from;
                window.elmeFly.burst(box.left + box.width / 2, box.top + box.height / 2, burstTone(origin));
            }
            setTimeout(() => {
                const to = cartTarget();
                if (!to || !origin.isConnected || !window.elmeFly.target(origin)) {
                    landed();
                    return;
                }
                const item = flyer(origin);
                window.elmeFly(origin, to, {className: item.className, content: item.body, onLand: landed});
            }, headerWasHidden ? Math.max(FLY_DELAY_MS, REVEAL_MS) : FLY_DELAY_MS);
        }

        function announce(text) {
            const status = document.getElementById('elme-atc-status');
            if (!status) {
                return;
            }
            status.textContent = '';
            setTimeout(() => { status.textContent = text; }, 50);
        }

        function toast(type, text) {
            window.dispatchEvent(new CustomEvent('elme-toast', { detail: { type: type, text: text } }));
        }

        // Section messages may hold HTML (links); the toast shows plain text.
        function plainText(html) {
            const doc = new DOMParser().parseFromString(String(html || ''), 'text/html');
            return (doc.body.textContent || '').trim();
        }

        function isCartUrl(url) {
            try {
                return /\/checkout\/cart\/?$/.test(new URL(url, window.location.href).pathname);
            } catch (e) {
                return false;
            }
        }

        // cart/add leaves its result in the session messages; reading the section takes them out,
        // so the in-page message bar does not repeat "You added … to your shopping cart."
        async function takeMessages() {
            try {
                const response = await fetch(BASE_URL + 'customer/section/load/?sections=messages', {
                    credentials: 'same-origin',
                    headers: { 'X-Requested-With': 'XMLHttpRequest' }
                });
                const data = response.ok ? await response.json() : null;
                return (data && data.messages && data.messages.messages) || [];
            } catch (e) {
                return [];
            }
        }

        async function send(job) {
            let json = null;
            try {
                const response = await fetch(job.url, {
                    method: 'POST',
                    body: job.body,
                    credentials: 'same-origin',
                    headers: { 'X-Requested-With': 'XMLHttpRequest', 'Accept': 'application/json' }
                });
                const type = response.headers.get('content-type') || '';
                // a redirect to HTML (expired form key) is a failure, not a success
                if (response.ok && type.indexOf('json') !== -1) {
                    json = await response.json();
                }
            } catch (e) {
                json = null;
            }

            const messages = await takeMessages();

            const problems = messages.filter((m) => m && m.type !== 'success' && plainText(m.text));
            const backUrl = json && json.backUrl;
            // cart/add answers {} also when it did not add anything (product gone): only its success
            // message, or the redirect to the cart (admin "redirect to cart" = Yes), confirms the add
            const confirmed = messages.some((m) => m && m.type === 'success')
                || Boolean(backUrl && isCartUrl(backUrl));
            const ok = json !== null
                && confirmed
                && !problems.some((m) => m.type === 'error');

            problems.forEach((m) => toast(m.type === 'error' || !ok ? 'error' : m.type, plainText(m.text)));
            if (!ok && !problems.length) {
                toast('error', TEXT.failed);
            }

            return { ok: ok, redirect: ok && backUrl ? backUrl : null };
        }

        function finish(job, result) {
            const wait = Math.max(0, MIN_SENDING_MS - (Date.now() - job.startedAt));
            const flies = result.ok && !result.redirect && !reduced() && Boolean(window.elmeFly);
            let headerWasHidden = false;
            if (flies) {
                headerWasHidden = Boolean(document.querySelector('.page-header.is-hidden'));
                // before run() reloads the sections: the header holds the new count until this lands
                window.dispatchEvent(new CustomEvent('elme-cart-landing'));
            }
            setTimeout(() => {
                job.btn.atcPending = false;
                if (!result.ok) {
                    show(job.views, reduced() ? 'idle' : 'error', reduced() ? 0 : SHAKE_MS);
                    return;
                }
                show(job.views, 'success', result.redirect ? 0 : HOLD_MS);
                announce(TEXT.added);
                // Admin "After adding a product redirect to Shopping Cart" = Yes
                if (result.redirect) {
                    window.location.assign(result.redirect);
                    return;
                }
                if (flies) {
                    celebrate(job.origin, headerWasHidden);
                }
            }, wait);
        }

        async function run() {
            if (running) {
                return;
            }
            running = true;
            while (queue.length) {
                const job = queue.shift();
                finish(job, await send(job));
            }
            running = false;
            window.dispatchEvent(new CustomEvent('reload-customer-section-data'));
        }

        document.addEventListener('submit', (event) => {
            const form = event.target;
            if (event.defaultPrevented || !(form instanceof HTMLFormElement)) {
                return;
            }
            const btn = findButton(form, event.submitter);
            if (!btn || !window.fetch || !window.FormData || !window.BASE_URL) {
                return;
            }
            const origin = btn.elmeAtcOrigin && btn.elmeAtcOrigin.isConnected ? btn.elmeAtcOrigin : btn;
            btn.elmeAtcOrigin = null;
            event.preventDefault();
            if (btn.atcPending) {
                return;
            }
            btn.atcPending = true;
            const views = origin === btn ? [btn] : [btn, origin];
            show(views, 'sending', 0);
            // read the form now: qty or options changed later belong to the next click
            queue.push({
                btn: btn,
                origin: origin,
                views: views,
                url: form.action,
                body: new FormData(form),
                startedAt: Date.now()
            });
            run();
        });
    })();
</script>
<?php $hyvaCsp->registerInlineScript() ?>
