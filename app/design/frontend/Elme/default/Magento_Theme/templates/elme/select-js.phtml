            ></span>
            <img
                class="elme-select__media"
                x-show="showTriggerImage"
                :src="triggerImage"
                alt=""
                width="20"
                height="20"
                x-cloak
            >
            <span
                class="elme-select__icon"
                x-show="showTriggerIcon"
                x-html="triggerIconHtml"
                x-cloak
            ></span>
            <span class="elme-select__value" :class="valueClasses" x-text="displayLabel"></span>
        </button>
        <span class="elme-select__spinner" x-show="isLoading" x-cloak aria-hidden="true"></span>
        <svg
            class="elme-select__chevron"
            xmlns="http://www.w3.org/2000/svg"
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            aria-hidden="true"
            x-show="isNotLoading"
            x-cloak
        >
            <path d="m6 9 6 6 6-6"/>
        </svg>
    </div>

    <div
        class="elme-select__panel"
        x-ref="panel"
        x-show="isDesktopOpen"
        x-cloak
        @keydown="onPanelKeydown"
        :style="panelStyle"
    >
        <div class="elme-select__search" x-show="isSearchable" x-cloak>
            <label class="sr-only" :for="searchId"><?= $escaper->escapeHtml(__('Search options')) ?></label>
            <input
                type="search"
                class="elme-select__search-input"
                x-ref="search"
                :id="searchId"
                :value="query"
                @input="onSearchInput"
                @keydown="onSearchKeydown"
                autocomplete="off"
                placeholder="<?= $escaper->escapeHtmlAttr(__('Search')) ?>"
            >
        </div>
        <ul
            class="elme-select__list"
            x-ref="listbox"
            role="listbox"
            :id="listboxId"
            :aria-multiselectable="isMultiple"
            :aria-label="listboxLabel"
        >
            <template x-for="row in visibleRows" :key="row.key">
                <li
                    :class="rowClasses"
                    :id="optionDomId"
                    :role="rowRole"
                    :aria-selected="isOptionSelected"
                    :aria-disabled="isOptionDisabled"
                    :data-option-id="row.id"
                    @click="selectOption"
                    @mousemove="activateOption"
                >
                    <span x-show="isRowGroup" x-text="rowLabel"></span>
                    <span class="elme-select__swatch" x-show="optionHasSwatch" :style="optionSwatchStyle" x-cloak></span>
                    <img class="elme-select__media" x-show="optionHasImage" :src="optionImage" alt="" width="20" height="20" x-cloak>
                    <span class="elme-select__icon" x-show="optionHasIcon" x-html="optionIconHtml" x-cloak></span>
                    <span class="elme-select__option-label" x-show="isRowOption" x-html="optionLabelHtml"></span>
                    <svg
                        class="elme-select__check"
                        xmlns="http://www.w3.org/2000/svg"
                        width="16"
                        height="16"
                        viewBox="0 0 24 24"
