<?php
/**
 * FE-06: Contact Us link in the header chrome (desktop; on mobile it lives in the drawer footer).
 */

declare(strict_types=1);

use Hyva\Theme\Model\ViewModelRegistry;
use Hyva\Theme\ViewModel\LucideIcons;
use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;

/** @var Template $block */
/** @var Escaper $escaper */
/** @var ViewModelRegistry $viewModels */

/** @var LucideIcons $lucideIcons */
$lucideIcons = $viewModels->require(LucideIcons::class);

$contactUrl = $block->getUrl('contact');
?>
<a
    href="<?= $escaper->escapeUrl($contactUrl) ?>"
    class="elme-header__action elme-header__contact hidden lg:inline-flex"
>
    <span class="elme-header__icon" aria-hidden="true">
        <?= $lucideIcons->messageSquareHtml('', 22, 22, ['aria-hidden' => 'true']) ?>
    </span>
    <span class="elme-header__label elme-header__label--tip-2xl"><?= $escaper->escapeHtml(__('Contact Us')) ?></span>
</a>
