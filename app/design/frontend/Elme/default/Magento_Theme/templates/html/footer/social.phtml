<?php
/**
 * FE-10: footer social icons (CMS block footer_social). Accessible names: "Elme Living on …".
 */

declare(strict_types=1);

use Elme\Theme\ViewModel\Footer;
use Hyva\Theme\Model\ViewModelRegistry;
use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;

/** @var Template $block */
/** @var Escaper $escaper */
/** @var ViewModelRegistry $viewModels */

$footer = $viewModels->require(Footer::class);
$links = $footer->getSocialLinks();
if ($links === []) {
    return;
}

/**
 * Simple filled brand marks (currentColor) — Lucide has no brand icons.
 *
 * @param string $network
 * @return string
 */
$iconSvg = static function (string $network): string {
    $common = 'class="elme-footer__social-icon block w-5 h-5" width="20" height="20" viewBox="0 0 24 24" aria-hidden="true" focusable="false"';
    return match (strtolower($network)) {
        'facebook' => '<svg ' . $common . ' fill="currentColor"><path d="M14 13.5h2.5l1-4H14v-2c0-1.03 0-2 2-2h1.5V2.14C17.17 2.09 16.02 2 14.83 2 12.05 2 10 3.79 10 7.29V9.5H7v4h3V22h4v-8.5z"/></svg>',
        'instagram' => '<svg ' . $common . ' fill="none" stroke="currentColor" stroke-width="1.75"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg>',
        'pinterest' => '<svg ' . $common . ' fill="currentColor"><path d="M12 2C6.5 2 2 6.5 2 12c0 4.2 2.6 7.8 6.3 9.2-.1-.8-.2-2 0-2.9.2-.8 1.3-5.5 1.3-5.5s-.3-.7-.3-1.6c0-1.5.9-2.6 2-2.6.9 0 1.4.7 1.4 1.5 0 .9-.6 2.3-.9 3.5-.3 1.1.5 1.9 1.5 1.9 1.8 0 3.2-1.9 3.2-4.7 0-2.4-1.8-4.2-4.3-4.2-2.9 0-4.7 2.2-4.7 4.5 0 .9.3 1.8.8 2.3.1.1.1.2.1.3l-.3 1.2c0 .2-.1.2-.3.1-1.3-.6-2.1-2.5-2.1-4 0-3.3 2.4-6.3 6.9-6.3 3.6 0 6.4 2.6 6.4 6 0 3.6-2.3 6.5-5.4 6.5-1.1 0-2.1-.6-2.4-1.2l-.7 2.5c-.2.9-.9 2-1.3 2.7.1 0 .2.1.3.1C10.3 21.8 11.1 22 12 22c5.5 0 10-4.5 10-10S17.5 2 12 2z"/></svg>',
        'linkedin' => '<svg ' . $common . ' fill="currentColor"><path d="M6.5 8.5H3V21h3.5V8.5zM4.8 3C3.5 3 2.5 4 2.5 5.3c0 1.2 1 2.2 2.3 2.2h0c1.3 0 2.3-1 2.3-2.2C7 4 6.1 3 4.8 3zM21 21h-3.5v-6.6c0-1.6-.6-2.7-2.1-2.7-1.1 0-1.8.8-2.1 1.5-.1.3-.1.6-.1.9V21H9.8s.05-10.4 0-11.5H13.3v1.6c.5-.7 1.3-1.8 3.3-1.8 2.4 0 4.2 1.6 4.2 5V21z"/></svg>',
        'tiktok' => '<svg ' . $common . ' fill="currentColor"><path d="M19.6 7.2a5.7 5.7 0 0 1-3.3-1.1v7.2a5.6 5.6 0 1 1-5.6-5.6c.3 0 .6 0 .9.1v2.8a2.8 2.8 0 1 0 2 2.7V2.5h2.8c.1 1.5.7 2.9 1.7 4a5.7 5.7 0 0 0 1.5.7v0z"/></svg>',
        default => '<svg ' . $common . ' fill="none" stroke="currentColor" stroke-width="1.75"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3a14 14 0 0 1 0 18 14 14 0 0 1 0-18"/></svg>',
    };
};
?>
<ul class="elme-footer__social links-list list-none m-0 p-0 flex flex-wrap items-center gap-5
           justify-center md:justify-start w-full"
    data-footer-social-rendered>
    <?php foreach ($links as $item): ?>
        <?php
        $network = (string) $item['network'];
        $aria = $footer->getSocialAriaLabel($network, (string) $item['label']);
        ?>
        <li class="m-0 p-0">
            <a class="elme-footer__social-link inline-flex items-center justify-center
                      min-w-11 min-h-11 text-ink hover:text-link-hover
                      focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2
                      focus-visible:outline-primary"
               href="<?= $escaper->escapeUrl($item['href']) ?>"
               target="_blank"
               rel="noopener noreferrer"
               aria-label="<?= $escaper->escapeHtmlAttr($aria) ?>">
                <?= /* @noEscape */ $iconSvg($network) ?>
            </a>
        </li>
    <?php endforeach; ?>
</ul>
