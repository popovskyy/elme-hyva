<?php
/**
 * Home page scroll motion (styles in web/tailwind/elme/home-motion.css). Marks the homepage sections
 * and the items inside them, shows what is already on screen, and reveals the rest once as it
 * scrolls in. Without this script, or without IntersectionObserver, nothing is hidden.
 *
 * @var \Magento\Framework\View\Element\Template $block
 * @var \Magento\Framework\Escaper $escaper
 * @var \Hyva\Theme\Model\ViewModelRegistry $viewModels
 */

declare(strict_types=1);

use Hyva\Theme\ViewModel\HyvaCsp;

/** @var HyvaCsp $hyvaCsp */
$hyvaCsp = $viewModels->require(HyvaCsp::class);
?>
<script>
    (() => {
        const main = document.querySelector('#maincontent');

        if (!main || !('IntersectionObserver' in window)) {
            return;
        }

        const sections = main.querySelectorAll(
            '.elme-category-tiles, .elme-welcome-cta, .elme-promo-split, .elme-catalogue-covers,'
            + ' .elme-usp-strip, .elme-our-difference, .elme-need-assistance, .elme-collage'
        );
        const groups = '.elme-catalogue-covers li, .elme-usp-strip__items li, .elme-need-assistance__cell';
        const targets = [];

        sections.forEach((section) => {
            if (!section.classList.contains('elme-collage')) {
                section.setAttribute('data-reveal', '');
            }
            targets.push(section);
        });
        main.querySelectorAll(groups).forEach((item) => {
            item.setAttribute('data-reveal', '');
            item.style.setProperty('--i', String(Array.prototype.indexOf.call(item.parentElement.children, item)));
            targets.push(item);
        });

        const observer = new IntersectionObserver((entries) => {
            entries.forEach((entry) => {
                if (entry.isIntersecting) {
                    entry.target.classList.add('is-in');
                    observer.unobserve(entry.target);
                }
            });
        }, {rootMargin: '0px 0px -8% 0px', threshold: 0.12});

        targets.forEach((target) => {
            if (target.getBoundingClientRect().top < window.innerHeight) {
                target.classList.add('is-in');
            } else {
                observer.observe(target);
            }
        });
        document.documentElement.classList.add('elme-motion');
    })();
</script>
<?php $hyvaCsp->registerInlineScript() ?>
