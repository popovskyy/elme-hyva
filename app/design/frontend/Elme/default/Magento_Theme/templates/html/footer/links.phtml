<?php
/**
 * FE-10: footer Shop / Service / Help columns — accordion on mobile, open columns from md.
 */

declare(strict_types=1);

use Elme\Theme\ViewModel\Footer;
use Hyva\Theme\Model\ViewModelRegistry;
use Hyva\Theme\ViewModel\HyvaCsp;
use Hyva\Theme\ViewModel\LucideIcons;
use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;

/** @var Template $block */
/** @var Escaper $escaper */
/** @var ViewModelRegistry $viewModels */
/** @var HyvaCsp $hyvaCsp */

$footer = $viewModels->require(Footer::class);
/** @var LucideIcons $lucideIcons */
$lucideIcons = $viewModels->require(LucideIcons::class);
$columns = $footer->getColumns();
?>
<nav class="elme-footer__links flex-1 min-w-0 w-full"
     aria-label="<?= $escaper->escapeHtmlAttr(__('Footer')) ?>">
    <div class="elme-footer__columns flex flex-col md:flex-row md:flex-wrap md:justify-between
                md:gap-x-8 md:gap-y-7 lg:px-16 xl:px-36 md:pl-8 md:pr-10">
        <?php foreach ($columns as $index => $column): ?>
            <?php
            $title = (string) $column['title'];
            $panelId = 'elme-footer-col-' . $index;
            ?>
            <div class="elme-footer__column relative w-full md:w-auto md:min-w-30 md:mb-7
                        border-b border-border md:border-0 py-4 md:py-0"
                 x-data="initElmeFooterColumn">
                <h3 class="elme-footer__column-title hidden md:block m-0 mb-7
                           font-heading font-normal text-h2 leading-4 tracking-wide text-ink">
                    <?= $escaper->escapeHtml($title) ?>
                </h3>
                <button type="button"
                        class="elme-footer__column-trigger md:hidden flex items-center justify-between
                               gap-3 w-full min-h-11 m-0 p-0 text-left bg-transparent border-0
                               font-heading font-normal text-h2 leading-4 tracking-wide text-ink
                               cursor-pointer
                               focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2
                               focus-visible:outline-primary"
                        @click="toggleOpen"
                        :aria-expanded="open"
                        aria-controls="<?= $escaper->escapeHtmlAttr($panelId) ?>">
                    <span><?= $escaper->escapeHtml($title) ?></span>
                    <span class="elme-footer__column-chevron inline-flex shrink-0 text-ink
                                 transition-transform duration-200 ease-out"
                          :class="chevronClass"
                          aria-hidden="true">
                        <?= $lucideIcons->chevronDownHtml('', 20, 20, ['aria-hidden' => 'true']) ?>
                    </span>
                </button>
                <ul id="<?= $escaper->escapeHtmlAttr($panelId) ?>"
                    class="elme-footer__column-panel list-none m-0 p-0"
                    :class="panelClass">
                    <?php foreach ($column['links'] as $link): ?>
                        <li class="elme-footer__link-item m-0 mb-4 last:mb-0">
                            <a class="elme-footer__link inline-flex items-center min-h-11 md:min-h-0
                                      text-body leading-4 text-ink no-underline
                                      hover:text-link-hover
                                      focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2
                                      focus-visible:outline-primary"
                               href="<?= $escaper->escapeUrl($link['href']) ?>"
                                <?php if (!empty($link['external'])): ?>
                                    target="_blank"
                                    rel="noopener noreferrer"
                                <?php endif; ?>>
                                <?= $escaper->escapeHtml($link['label']) ?>
                            </a>
                        </li>
                    <?php endforeach; ?>
                </ul>
            </div>
        <?php endforeach; ?>
    </div>
</nav>
<script>
    function initElmeFooterColumn() {
        return hyva.createBooleanObject('open', false, {
            panelClass() {
                return {
                    'is-open': this.open()
                };
            },
            chevronClass() {
                return {
                    'is-open': this.open()
                };
            }
        });
    }
    window.addEventListener(
        'alpine:init',
        () => Alpine.data('initElmeFooterColumn', initElmeFooterColumn),
        {once: true}
    );
</script>
<?php $hyvaCsp->registerInlineScript() ?>
