<?php
/**
 * FE-13: Need assistance? - phone / email / showroom from StoreContact (store config).
 * Placed via CMS block need_assistance or layout. Three equal cells in one row where the block is wide
 * (home, docs/design/homepage-options.html D1), stacked where it is narrow (help page side column);
 * shared-blocks.css switches on the block's own width, not the viewport.
 */

declare(strict_types=1);

use Elme\Theme\ViewModel\StoreContact;
use Hyva\Theme\Model\ViewModelRegistry;
use Hyva\Theme\ViewModel\LucideIcons;
use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;

/** @var Template $block */
/** @var Escaper $escaper */
/** @var ViewModelRegistry $viewModels */

$contact = $viewModels->require(StoreContact::class);
$lucide = $viewModels->require(LucideIcons::class);

[$street, $suburbLine] = $contact->getShowroomAddressLines();
$iconAttributes = ['aria-hidden' => 'true'];
?>
<section class="elme-need-assistance" aria-labelledby="elme-need-assistance-heading">
    <h2 id="elme-need-assistance-heading" class="elme-need-assistance__title">
        <?= $escaper->escapeHtml(__('Need assistance?')) ?>
    </h2>
    <ul class="elme-need-assistance__cells">
        <li class="elme-need-assistance__cell">
            <span class="elme-need-assistance__label">
                <?= $lucide->phoneHtml('elme-need-assistance__icon', 18, 18, $iconAttributes) ?>
                <?= $escaper->escapeHtml(__('Call us')) ?>
            </span>
            <a class="elme-need-assistance__value"
               href="<?= $escaper->escapeUrl($contact->getPhoneTelHref()) ?>">
                <?= $escaper->escapeHtml($contact->getPhoneDisplay()) ?>
            </a>
        </li>
        <li class="elme-need-assistance__cell">
            <span class="elme-need-assistance__label">
                <?= $lucide->mailHtml('elme-need-assistance__icon', 18, 18, $iconAttributes) ?>
                <?= $escaper->escapeHtml(__('Email us')) ?>
            </span>
            <a class="elme-need-assistance__value"
               href="<?= $escaper->escapeUrl($contact->getEmailMailtoHref()) ?>">
                <?= $escaper->escapeHtml($contact->getEmail()) ?>
            </a>
        </li>
        <li class="elme-need-assistance__cell">
            <span class="elme-need-assistance__label">
                <?= $lucide->mapPinHtml('elme-need-assistance__icon', 18, 18, $iconAttributes) ?>
                <?= $escaper->escapeHtml(__('Visit our Showroom')) ?>
            </span>
            <a class="elme-need-assistance__value"
               href="<?= $escaper->escapeUrl($contact->getMapsUrl()) ?>"
               target="_blank"
               rel="noopener noreferrer">
                <?= $escaper->escapeHtml($street) ?><br>
                <?= $escaper->escapeHtml($suburbLine) ?>
            </a>
        </li>
    </ul>
</section>
