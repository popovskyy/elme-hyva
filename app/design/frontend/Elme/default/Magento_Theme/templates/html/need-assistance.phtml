<?php
/**
 * FE-13: Need assistance? - phone / email / showroom from StoreContact (store config).
 * Placed via CMS block need_assistance or layout. Three cells in a row where the block is wide, stacked
 * where it is narrow (help page side column); shared-blocks.css switches on the block's own width.
 * Each cell is one link, icon included. On the home page it is a dark band
 * (docs/design/home-middle-options.html, B). Hovering a cell eases its icon: the phone tilts,
 * the envelope opens, the pin settles and the ground ripples. It eases back on leave.
 */

declare(strict_types=1);

use Elme\Theme\ViewModel\StoreContact;
use Hyva\Theme\Model\ViewModelRegistry;
use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;

/** @var Template $block */
/** @var Escaper $escaper */
/** @var ViewModelRegistry $viewModels */

$contact = $viewModels->require(StoreContact::class);

[$street, $suburbLine] = $contact->getShowroomAddressLines();
$email = $contact->getEmail();
?>
<section class="elme-need-assistance" aria-labelledby="elme-need-assistance-heading">
    <div class="elme-need-assistance__inner">
        <h2 id="elme-need-assistance-heading" class="elme-need-assistance__title">
            <?= $escaper->escapeHtml(__('Need assistance?')) ?>
