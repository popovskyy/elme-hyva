<script>
    function initHeader() {
        return {
            searchOpen: false,
            cartLoaded: false,
            cartBumped: false,
            qoCount: 0,
            qoBumped: false,
            isCartOpen: false,
            pageHeader: null,
            promo: null,
            promoH: 0,
            rowH: 0,
            stuck: false,
            headerHidden: false,
            scrollAnchor: 0,
            scrollQueued: false,
            holdUntil: 0,
            desktopMq: window.matchMedia('(min-width: 1025px)'), // = lg: the row never hides there
            isMac: /Mac|iPhone|iPad|iPod/.test(navigator.userAgentData?.platform || navigator.platform || ''),

            init() {
                this.pageHeader = this.$root.closest('.page-header');
                this.promo = this.pageHeader ? this.pageHeader.querySelector('.header-promo') : null;
                this.measure();
                if ('ResizeObserver' in window) {
                    const observer = new ResizeObserver(() => this.measure());
                    observer.observe(this.$root);
                    if (this.promo) {
                        observer.observe(this.promo);
                    }
                }
                window.addEventListener('scroll', () => this.queueScroll(), {passive: true});
                window.addEventListener('hashchange', () => this.holdShown());
                document.addEventListener('click', (event) => this.onLinkClick(event), true);
                this.desktopMq.addEventListener('change', () => this.setHidden(false));
                // Keyboard users tabbing into a hidden row get it back
                this.$root.addEventListener('focusin', () => this.setHidden(false));
            },

            /**
             * Sticky is pure CSS (.page-header position: sticky; top: -promo height). JS measures
             * --elme-promo-h for that top and, below lg, hides the row on scroll down (.is-hidden).
             * On <html>: --elme-header-offset = row height while the row is shown, 0px while hidden
             * (scroll-padding-top, sticky bars under the header); --elme-header-row-bottom = where the
             * row ends on screen (toasts). --elme-header-bottom belongs to the desktop mega menu.
             */
            measure() {
                this.promoH = this.promo ? this.promo.offsetHeight : 0;
                this.rowH = this.$root.offsetHeight;
                if (this.pageHeader) {
                    this.pageHeader.style.setProperty('--elme-promo-h', this.promoH + 'px');
                }
                this.onScroll(true);
            },

            // Read scrollY once per frame
            queueScroll() {
                if (this.scrollQueued) {
                    return;
                }
                this.scrollQueued = true;
                requestAnimationFrame(() => {
                    this.scrollQueued = false;
                    this.onScroll();
                });
            },

            onScroll(force) {
                const y = window.scrollY;
                const stuck = y > this.promoH;
                if (stuck !== this.stuck || force === true) {
                    this.stuck = stuck;
                    if (this.pageHeader) {
                        this.pageHeader.classList.toggle('is-stuck', stuck);
                    }
                    this.syncOffsets();
                }
                this.updateHidden(y);
            },

            updateHidden(y) {
                // iOS rubber band: scrollY runs below 0 or past the end while bouncing
                const maxY = document.documentElement.scrollHeight - window.innerHeight;
                if (y < 0 || y > maxY + 1) {
                    return;
                }
                const now = performance.now();
                if (now < this.holdUntil) {
                    this.holdUntil = Math.max(this.holdUntil, now + 150);
                }
                if (this.desktopMq.matches || y <= this.promoH + this.rowH || now < this.holdUntil) {
                    this.setHidden(false);
                    this.scrollAnchor = y;
                    return;
                }
                // The anchor follows the furthest point in the current direction; ~8px back flips it
                if (this.headerHidden) {
                    if (y > this.scrollAnchor) {
                        this.scrollAnchor = y;
                    } else if (this.scrollAnchor - y > 8) {
                        this.setHidden(false);
                        this.scrollAnchor = y;
                    }
                    return;
                }
                if (y < this.scrollAnchor || this.keepShown()) {
                    this.scrollAnchor = y;
                } else if (y - this.scrollAnchor > 8) {
                    this.setHidden(true);
                    this.scrollAnchor = y;
                }
            },

            keepShown() {
                if (this.searchOpen
                    || document.documentElement.classList.contains('elme-mobile-menu-open')
                    || document.querySelector('dialog[open]')
                    || this.$root.querySelector('[aria-expanded="true"]')) {
                    return true;
                }
                const active = document.activeElement;
                return !!active && this.$root.contains(active) && active.matches(':focus-visible');
            },

            setHidden(hidden) {
                if (hidden === this.headerHidden) {
                    return;
                }
                this.headerHidden = hidden;
                if (this.pageHeader) {
                    this.pageHeader.classList.toggle('is-hidden', hidden);
                }
                this.syncOffsets();
            },

            syncOffsets() {
                const offset = this.headerHidden ? 0 : this.rowH;
                const style = document.documentElement.style;
                style.setProperty('--elme-header-offset', offset + 'px');
                style.setProperty('--elme-header-row-bottom', (this.stuck ? offset : this.promoH + this.rowH) + 'px');
            },

            // Anchor jumps (smooth scroll) keep the row shown, so the target lines up under it
            holdShown() {
                this.holdUntil = performance.now() + 400;
                this.setHidden(false);
            },

            onLinkClick(event) {
                const link = event.target.closest ? event.target.closest('a[href*="#"]') : null;
                if (link && link.hash && link.pathname === window.location.pathname) {
                    this.holdShown();
                }
            },

            // BE-16: the cart is the Quick Order cart (section quick_order); the quote's "cart" section is not
            getData() {
                const data = this.$event.detail.data || {};
                if (data.quick_order) {
                    this.applyQoCount(data.quick_order.summary_count);
                }
            },

            // The Quick Order cart client dispatches `elme-qo-count` with {count} after each change
            setQoCount() {
                this.applyQoCount((this.$event.detail || {}).count);
            },

            applyQoCount(value) {
                const count = parseInt(value, 10) || 0;
                const previous = this.qoCount;
                const bumped = this.cartLoaded && count > previous;
                this.qoCount = count;
                // Added to cart while the row is hidden: bring it back, then bump the count once it is in view
                if (this.cartLoaded && count !== previous && this.headerHidden) {
                    this.setHidden(false);
                    const delay = window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 0 : 200;
                    setTimeout(() => {
                        this.cartBumped = bumped;
                        this.qoBumped = bumped;
                    }, delay);
                } else {
                    this.cartBumped = bumped;
                    this.qoBumped = bumped;
                }
                this.cartLoaded = true;
            },

            summaryCount() {
                return this.qoCount;
            },

            hasSummaryCount() {
                return !!this.summaryCount();
            },

            hasQoCount() {
                return !!this.qoCount;
            },

            qoCountLabel() {
                return this.qoCount;
            },

            cartBadgeClass() {
                return {'is-bumped': this.cartBumped};
            },

            qoBadgeClass() {
                return {'is-bumped': this.qoBumped};
            },

            clearBump() {
                this.cartBumped = false;
                this.qoBumped = false;
            },

            countLabel(count) {
                if (!count) {
                    return '<?= $escaper->escapeJs(__('empty')) ?>';
                }
                return Math.abs(count) > 1
                    ? hyva.str('<?= $escaper->escapeJs(__('%1 items')) ?>', count)
                    : hyva.str('<?= $escaper->escapeJs(__('%1 item')) ?>', count);
            },

            cartAriaLabel() {
                return '<?= $escaper->escapeJs(__('Cart')) ?>, ' + this.countLabel(this.summaryCount());
            },

            qoAriaLabel() {
                return '<?= $escaper->escapeJs(__('Quick Order')) ?>, ' + this.countLabel(this.qoCount);
            },

            toggleCart() {
                this.isCartOpen = this.$event.detail?.isOpen ?? true;
                this.$dispatch('toggle-cart', {isOpen: this.isCartOpen});
            },

            focusMobileSearch() {
                this.$nextTick(() => {
                    const input = document.getElementById('search-mobile');
                    if (input) {
                        input.focus();
                        input.select();
                    }
                });
            },

            toggleSearch() {
                this.searchOpen = !this.searchOpen;
                if (this.searchOpen) {
                    this.focusMobileSearch();
                }
            },

            searchClose() {
                this.searchOpen = false;
                const toggle = [...this.$root.querySelectorAll('[data-elme-search-toggle]')]
                    .find((el) => el.offsetParent !== null);
                if (toggle) {
                    toggle.focus();
                }
            },

            searchEscape() {
                if (this.searchOpen) {
                    this.searchClose();
                }
            },

            // Ctrl K / ⌘K: the desktop field when it is visible, else the mobile search panel
            searchShortcut() {
                const e = this.$event;
                const modifier = this.isMac ? e.metaKey : e.ctrlKey;
                if (!modifier || e.altKey || e.shiftKey || (e.key || '').toLowerCase() !== 'k') {
                    return;
                }
                e.preventDefault();
                const desktop = document.getElementById('search');
                if (desktop && desktop.offsetParent !== null) {
                    desktop.focus();
                    desktop.select();
                    return;
                }
                this.searchOpen = true;
                this.focusMobileSearch();
            }
        }
    }

    window.addEventListener('alpine:init', () => {
        Alpine.data('initHeader', initHeader);
    }, {once: true})
</script>
<?php $hyvaCsp->registerInlineScript() ?>

