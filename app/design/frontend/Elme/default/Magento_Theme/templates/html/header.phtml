<script>
    function initHeader() {
        return {
            searchOpen: false,
            cart: {},
            qoCount: 0,
            isCartOpen: false,
            stuck: false,
            pageHeader: null,
            promo: null,

            init() {
                this.pageHeader = this.$root.closest('header.page-header');
                this.promo = this.pageHeader
                    ? this.pageHeader.querySelector('.header-promo')
                    : null;
                this.onScroll();
                window.addEventListener('scroll', () => this.onScroll(), {passive: true});
                window.addEventListener('resize', () => this.onResize(), {passive: true});
            },

            onResize() {
                if (this.stuck) {
                    this.applyStickyOffset();
                } else {
                    this.updateScrollPadding();
                }
            },

            onScroll() {
                const promoH = this.promo ? this.promo.offsetHeight : 0;
                if (window.scrollY > promoH) {
                    this.stick();
                } else {
                    this.unstick();
                }
            },

            stick() {
                if (!this.pageHeader || this.stuck) {
                    return;
                }
                this.stuck = true;
                this.pageHeader.classList.add('is-sticky');
                this.$nextTick(() => this.applyStickyOffset());
            },

            unstick() {
                if (!this.pageHeader || !this.stuck) {
                    this.updateScrollPadding();
                    return;
                }
                this.stuck = false;
                this.pageHeader.classList.remove('is-sticky');
                document.body.style.paddingTop = '';
                this.updateScrollPadding();
            },

            applyStickyOffset() {
                const h = Math.ceil(this.$root.getBoundingClientRect().height);
                document.body.style.paddingTop = h + 'px';
                document.documentElement.style.scrollPaddingTop = h + 'px';
            },

            updateScrollPadding() {
                const promoH = this.promo && !this.stuck ? this.promo.offsetHeight : 0;
                const h = Math.ceil(this.$root.getBoundingClientRect().height) + promoH;
                document.documentElement.style.scrollPaddingTop = h + 'px';
            },

            getData() {
                const data = this.$event.detail.data || {};
                this.cart = data.cart ?? {};
                const qo = data.quickorder ?? data['elme-qo-cart'] ?? data.qo_cart ?? null;
                if (qo && typeof qo === 'object') {
                    this.qoCount = qo.summary_count ?? qo.count ?? qo.items_qty ?? 0;
                }
            },

            summaryCount() {
                return this.cart.summary_count || 0;
            },

            hasSummaryCount() {
                return !!this.summaryCount();
            },

            hasQoCount() {
                return !!this.qoCount;
            },

            qoCountLabel() {
                return this.qoCount || 0;
            },

            cartAriaLabel() {
                return '<?= $escaper->escapeJs($showMiniCart ? __('Toggle minicart') : __('View cart')) ?>, ' +
                    (this.isCartEmpty() ? '<?= $escaper->escapeJs(__('Cart is empty')) ?>' : (
                        Math.abs(this.summaryCount()) > 1 ?
                            hyva.str('<?= $escaper->escapeJs(__('%1 items')) ?>', this.summaryCount()) :
                            hyva.str('<?= $escaper->escapeJs(__('%1 item')) ?>', this.summaryCount())
                    ));
            },

            isCartEmpty() {
                return !this.cart.summary_count;
            },

            toggleCart() {
                this.isCartOpen = this.$event.detail?.isOpen ?? true;
                this.$dispatch('toggle-cart', {isOpen: this.isCartOpen});
            },

            focusMobileSearch() {
                this.$nextTick(() => {
                    const input = document.getElementById('search-mobile');
                    if (input) {
                        input.focus();
                        input.select();
                    }
                });
            },

            toggleSearch() {
                this.searchOpen = !this.searchOpen;
                if (this.searchOpen) {
                    this.focusMobileSearch();
                }
            },

            toggleSearchOpen() {
                this.searchOpen = true;
                this.focusMobileSearch();
            },

            searchClose() {
                this.searchOpen = false;
                if (this.$refs.searchButton) {
                    this.$refs.searchButton.focus();
                }
            },

            searchEscape() {
                this.searchClose();
            },

            isMac: /Mac|iPod|iPhone|iPad/.test(navigator.platform),

            textShortcutModifier() {
                return this.isMac ? '⌘ K' : 'Ctrl+K';
            },

            searchShortcut(e) {
                const modifier = this.isMac ? e.metaKey : e.ctrlKey;
                if (modifier && e.key === 'k') {
                    e.preventDefault();
                    this.toggleSearchOpen();
                }
            }
        }
    }

    window.addEventListener('alpine:init', () => {
        Alpine.data('initHeader', initHeader);
    }, {once: true})
</script>
<?php $hyvaCsp->registerInlineScript() ?>

