<script>
    function initHeader() {
        return {
            searchOpen: false,
            cart: {},
            cartLoaded: false,
            cartBumped: false,
            qoCount: 0,
            qoBumped: false,
            isCartOpen: false,
            pageHeader: null,
            promo: null,
            promoH: 0,
            rowH: 0,
            stuck: false,
            isMac: /Mac|iPhone|iPad|iPod/.test(navigator.userAgentData?.platform || navigator.platform || ''),

            init() {
                this.pageHeader = this.$root.closest('.page-header');
                this.promo = this.pageHeader ? this.pageHeader.querySelector('.header-promo') : null;
                this.measure();
                if ('ResizeObserver' in window) {
                    const observer = new ResizeObserver(() => this.measure());
                    observer.observe(this.$root);
                    if (this.promo) {
                        observer.observe(this.promo);
                    }
                }
                window.addEventListener('scroll', () => this.onScroll(), {passive: true});
            },

            /**
             * Sticky is pure CSS (.page-header position: sticky; top: -promo height). JS only measures:
             * --elme-promo-h for that top, --elme-header-h for scroll-padding-top (anchors), and
             * --elme-header-offset for toasts.
             */
            measure() {
                this.promoH = this.promo ? this.promo.offsetHeight : 0;
                this.rowH = this.$root.offsetHeight;
                if (this.pageHeader) {
                    this.pageHeader.style.setProperty('--elme-promo-h', this.promoH + 'px');
                }
                document.documentElement.style.setProperty('--elme-header-h', this.rowH + 'px');
                this.onScroll(true);
            },

            onScroll(force) {
                const stuck = window.scrollY > this.promoH;
                if (stuck === this.stuck && force !== true) {
                    return;
                }
                this.stuck = stuck;
                if (this.pageHeader) {
                    this.pageHeader.classList.toggle('is-stuck', stuck);
                }
                const offset = (stuck ? this.rowH : this.promoH + this.rowH) + 16;
                document.documentElement.style.setProperty('--elme-header-offset', offset + 'px');
            },

            getData() {
                const data = this.$event.detail.data || {};
                const previous = this.summaryCount();
                this.cart = data.cart || {};
                this.cartBumped = this.cartLoaded && this.summaryCount() > previous;
                this.cartLoaded = true;
                // FE-41: Quick Order cart count, if it ships as a customer-data section
                if (data.quick_order) {
                    this.applyQoCount(data.quick_order.summary_count);
                }
            },

            // FE-41: or the Quick Order mini-cart dispatches `elme-qo-count` with {count}
            setQoCount() {
                this.applyQoCount((this.$event.detail || {}).count);
            },

            applyQoCount(value) {
                const count = parseInt(value, 10) || 0;
                this.qoBumped = count > this.qoCount;
                this.qoCount = count;
            },

            summaryCount() {
                return this.cart.summary_count || 0;
            },

            hasSummaryCount() {
                return !!this.summaryCount();
            },

            hasQoCount() {
                return !!this.qoCount;
            },

            qoCountLabel() {
                return this.qoCount;
            },

            cartBadgeClass() {
                return {'is-bumped': this.cartBumped};
            },

            qoBadgeClass() {
                return {'is-bumped': this.qoBumped};
            },

            clearBump() {
                this.cartBumped = false;
                this.qoBumped = false;
            },

            countLabel(count) {
                if (!count) {
                    return '<?= $escaper->escapeJs(__('empty')) ?>';
                }
                return Math.abs(count) > 1
                    ? hyva.str('<?= $escaper->escapeJs(__('%1 items')) ?>', count)
                    : hyva.str('<?= $escaper->escapeJs(__('%1 item')) ?>', count);
            },

            cartAriaLabel() {
                return '<?= $escaper->escapeJs(__('Cart')) ?>, ' + this.countLabel(this.summaryCount());
            },

            qoAriaLabel() {
                return '<?= $escaper->escapeJs(__('Quick Order')) ?>, ' + this.countLabel(this.qoCount);
            },

            toggleCart() {
                this.isCartOpen = this.$event.detail?.isOpen ?? true;
                this.$dispatch('toggle-cart', {isOpen: this.isCartOpen});
            },

            focusMobileSearch() {
                this.$nextTick(() => {
                    const input = document.getElementById('search-mobile');
                    if (input) {
                        input.focus();
                        input.select();
                    }
                });
            },

            toggleSearch() {
                this.searchOpen = !this.searchOpen;
                if (this.searchOpen) {
                    this.focusMobileSearch();
                }
            },

            searchClose() {
                this.searchOpen = false;
                const toggle = [...this.$root.querySelectorAll('[data-elme-search-toggle]')]
                    .find((el) => el.offsetParent !== null);
                if (toggle) {
                    toggle.focus();
                }
            },

            searchEscape() {
                if (this.searchOpen) {
                    this.searchClose();
                }
            },

            // Ctrl K / ⌘K: the desktop field when it is visible, else the mobile search panel
            searchShortcut() {
                const e = this.$event;
                const modifier = this.isMac ? e.metaKey : e.ctrlKey;
                if (!modifier || e.altKey || e.shiftKey || (e.key || '').toLowerCase() !== 'k') {
                    return;
                }
                e.preventDefault();
                const desktop = document.getElementById('search');
                if (desktop && desktop.offsetParent !== null) {
                    desktop.focus();
                    desktop.select();
                    return;
                }
                this.searchOpen = true;
                this.focusMobileSearch();
            }
        }
    }

    window.addEventListener('alpine:init', () => {
        Alpine.data('initHeader', initHeader);
    }, {once: true})
</script>
<?php $hyvaCsp->registerInlineScript() ?>

