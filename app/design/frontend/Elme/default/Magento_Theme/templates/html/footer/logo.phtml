<?php
/**
 * FE-10: footer store logo, the same one-line mark as the header (images/logo.svg).
 */

declare(strict_types=1);

use Elme\Theme\ViewModel\Footer;
use Hyva\Theme\Model\ViewModelRegistry;
use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;

/** @var Template $block */
/** @var Escaper $escaper */
/** @var ViewModelRegistry $viewModels */

$footer = $viewModels->require(Footer::class);
$homeUrl = $block->getUrl('');
$alt = (string) __('Elme Living');
?>
<a class="elme-footer__logo inline-block md:mb-0
          focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
   href="<?= $escaper->escapeUrl($homeUrl) ?>"
   title="<?= $escaper->escapeHtmlAttr($alt) ?>"
   aria-label="<?= $escaper->escapeHtmlAttr(__('Store logo')) ?>">
    <img class="elme-footer__logo-img block w-44 h-auto"
         src="<?= $escaper->escapeUrl($footer->getLogoUrl()) ?>"
         alt="<?= $escaper->escapeHtmlAttr($alt) ?>"
         width="180"
         height="38"
         loading="lazy"
         decoding="async"/>
</a>
