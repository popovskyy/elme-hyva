<?php
/**
 * FE-06: account control in the header. FE-07: icon only below lg (label stays the accessible name).
 * Guest → login (UX-02 owns the wording: change $guestLabel only). Logged in: first name from private
 * content + account menu. The name is never baked into FPC HTML.
 */

declare(strict_types=1);

use Hyva\Theme\Model\ViewModelRegistry;
use Hyva\Theme\ViewModel\HyvaCsp;
use Hyva\Theme\ViewModel\LucideIcons;
use Magento\Customer\Block\Account\Customer;
use Magento\Customer\Model\Account\Redirect;
use Magento\Framework\Escaper;

/** @var Customer $block */
/** @var Escaper $escaper */
/** @var HyvaCsp $hyvaCsp */
/** @var ViewModelRegistry $viewModels */

/** @var LucideIcons $lucideIcons */
$lucideIcons = $viewModels->require(LucideIcons::class);

$loggedIn = $block->customerLoggedIn();
$loginUrl = $block->getUrl('customer/account/login');
$guestLabel = __('Log in/Sign up');
?>

<?php if (!$loggedIn): ?>
    <a
        id="customer-menu-login"
        class="elme-header__action elme-header__login"
        href="<?= $escaper->escapeUrl($loginUrl) ?>"
    >
        <span class="elme-header__icon" aria-hidden="true">
            <?= $lucideIcons->userRoundHtml('', 22, 22, ['aria-hidden' => 'true']) ?>
        </span>
        <span class="elme-header__label"><?= $escaper->escapeHtml($guestLabel) ?></span>
    </a>
    <script>
        // Back to this page after login
        document.getElementById('customer-menu-login').addEventListener('click', () => {
            hyva.setCookie('<?= $escaper->escapeJs(Redirect::LOGIN_REDIRECT_URL) ?>', window.location.href, 1);
        });
    </script>
    <?php $hyvaCsp->registerInlineScript() ?>
<?php else: ?>
    <div
        class="relative elme-header__account shrink-0"
        x-data="initCustomerMenu"
        x-bind="eventListeners"
        @private-content-loaded.window="onPrivateContentLoaded"
    >
        <button
            type="button"
            id="customer-menu"
            class="elme-header__action"
            x-ref="trigger"
            @click="toggleOpen"
            :aria-expanded="open"
            aria-haspopup="true"
            aria-controls="customer-menu-panel"
        >
            <span class="elme-header__icon" aria-hidden="true">
                <?= $lucideIcons->userRoundHtml('', 22, 22, ['aria-hidden' => 'true']) ?>
            </span>
            <span class="elme-header__label">
                <span class="max-w-24 truncate" x-text="displayName"><?= $escaper->escapeHtml(__('Account')) ?></span>
                <span class="elme-header__chevron" aria-hidden="true">
                    <?= $lucideIcons->chevronDownHtml('', 12, 12, ['aria-hidden' => 'true']) ?>
                </span>
            </span>
        </button>
        <nav
            id="customer-menu-panel"
            class="elme-account-menu absolute end-0 top-full z-40 mt-2 w-56 py-2
                   bg-surface border border-border shadow-lg"
            aria-label="<?= $escaper->escapeHtmlAttr(__('My Account')) ?>"
            x-show="open"
            x-transition:enter="transition ease-out duration-150"
            x-transition:enter-start="opacity-0 scale-95 -translate-y-1"
            x-transition:enter-end="opacity-100 scale-100 translate-y-0"
            x-transition:leave="transition ease-out duration-150"
            x-transition:leave-start="opacity-100 scale-100 translate-y-0"
            x-transition:leave-end="opacity-0 scale-95 -translate-y-1"
            x-cloak
        >
            <p class="px-4 pt-1 pb-2 mb-2 border-b border-border text-note text-ink-muted" x-show="hasName">
                <?= $escaper->escapeHtml(__('Signed in as')) ?>
                <span class="block text-body text-ink font-medium truncate" x-text="fullName"></span>
            </p>
            <?= $block->getChildHtml('header.customer.logged.in.links') ?>
        </nav>
    </div>
    <script>
        function initCustomerMenu() {
            return hyva.createBooleanObject('open', false, {
                firstname: '',
                fullname: '',
                onPrivateContentLoaded() {
                    const customer = this.$event.detail.data.customer || {};
                    this.firstname = customer.firstname || '';
                    this.fullname = customer.fullname || this.firstname;
                },
                displayName() {
                    return this.firstname || '<?= $escaper->escapeJs(__('Account')) ?>';
                },
                fullName() {
                    return this.fullname;
                },
                hasName() {
                    return !!this.fullname;
                },
                eventListeners: {
                    ['@pageshow.window'](event) {
                        if (event.persisted) {
                            this.setOpenFalse()
                        }
                    },
                    ['@keyup.escape']() {
                        if (this.open) {
                            this.setOpenFalse();
                            this.$refs.trigger.focus();
                        }
                    },
                    ['@click.outside']() {
                        this.setOpenFalse()
                    }
                }
            })
        }
        window.addEventListener('alpine:init', () => Alpine.data('initCustomerMenu', initCustomerMenu), {once: true})
    </script>
    <?php $hyvaCsp->registerInlineScript() ?>
<?php endif; ?>
