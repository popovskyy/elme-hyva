               id="business_terms_and_conditions"
               class="checkbox"
               required
               data-validate='{"required":true}'
               aria-required="true">
        <label for="business_terms_and_conditions" class="label">
            <?= /* @noEscape */ __(
                'I agree to Elme Living <a href="%1" target="_blank" rel="noopener noreferrer">Terms &amp; Conditions</a>',
