$termsUrl = $block->getUrl('', ['_direct' => 'terms-conditions-of-trade']);
?>
<fieldset class="fieldset elme-register-terms my-6">
    <legend class="sr-only"><?= $escaper->escapeHtml(__('Terms & Conditions')) ?></legend>
    <div class="field choice required">
        <input type="checkbox"
               name="business_terms_and_conditions"
