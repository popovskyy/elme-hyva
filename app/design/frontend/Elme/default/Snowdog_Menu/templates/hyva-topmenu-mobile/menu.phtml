<?php
/**
 * FE-09: Elme mobile menu drawer — drill-down panels, Back + View all, footer links.
 */

declare(strict_types=1);

use Hyva\Theme\Model\ViewModelRegistry;
use Hyva\Theme\ViewModel\HyvaCsp;
use Hyva\Theme\ViewModel\LucideIcons;
use Magento\Framework\Escaper;
use Snowdog\Menu\Block\Menu;

/** @var Menu $block */
/** @var Escaper $escaper */
/** @var ViewModelRegistry $viewModels */
/** @var HyvaCsp $hyvaCsp */

$menu = $block->getMenu();
if (!$menu) {
    return;
}

/** @var LucideIcons $lucideIcons */
$lucideIcons = $viewModels->require(LucideIcons::class);

$menuClass = $menu->getCssClass() ?: 'main-menu';
?>
<nav class="<?= $escaper->escapeHtmlAttr($menuClass) ?> elme-mobile-nav lg:hidden"
     x-data="initElmeMobileMenu"
     x-bind="menuListeners"
     aria-label="<?= $escaper->escapeHtmlAttr(__('Main menu')) ?>">
    <button type="button"
            class="elme-mobile-nav__burger inline-flex items-center justify-center
                   min-w-11 min-h-11 p-0 text-ink bg-transparent border-0
                   focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2
                   focus-visible:outline-primary"
            x-ref="openBtn"
            @click="openMenu"
            :aria-expanded="open"
            aria-haspopup="dialog"
            aria-controls="elme-mobile-menu"
            aria-label="<?= $escaper->escapeHtmlAttr(__('Open menu')) ?>">
        <?= $lucideIcons->menuHtml('', 24, 24, ['aria-hidden' => 'true']) ?>
    </button>

    <dialog id="elme-mobile-menu"
            class="elme-mobile-menu"
            x-ref="drawer"
            @click="onDialogClick"
            @cancel.prevent="closeMenu"
            aria-label="<?= $escaper->escapeHtmlAttr(__('Main menu')) ?>">
        <div class="elme-mobile-menu__shell elme-drawer elme-drawer-start flex flex-col h-full min-h-0"
             @click="stopShellClick"
             role="document">
            <div class="elme-mobile-menu__panels relative flex-1 min-h-0 overflow-hidden">
                <div class="elme-mobile-menu__panel elme-mobile-menu__panel--root is-active flex flex-col h-full"
                     data-panel-id="root">
                    <div class="elme-drawer__header shrink-0">
                        <p class="elme-drawer__title" id="elme-mobile-menu-title">
                            <?= $escaper->escapeHtml(__('Menu')) ?>
                        </p>
                        <button type="button"
                                class="inline-flex items-center justify-center min-w-11 min-h-11 p-0
                                       text-ink bg-transparent border-0
                                       focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2
                                       focus-visible:outline-primary"
                                @click="closeMenu"
                                aria-label="<?= $escaper->escapeHtmlAttr(__('Close menu')) ?>">
                            <?= $lucideIcons->xHtml('', 24, 24, ['aria-hidden' => 'true']) ?>
                        </button>
                    </div>

                    <div class="elme-drawer__body flex-1 min-h-0 !pt-0 !px-0">
                        <ul class="<?= $escaper->escapeHtmlAttr($menuClass) ?>__list elme-mobile-menu__list">
                            <?php foreach ($block->getNodes() as $node): ?>
                                <?php
                                $childrenLevel = $node->getLevel() + 1;
                                $children = $block->getNodes($childrenLevel, $node);
                                $node->setIsParent((bool) $children);
                                $nodeId = (string) $node->getId();
                                $titleRaw = (string) $node->getTitle();
                                $cleanTitle = trim((string) preg_replace('/\{.*?\}/', '', $titleRaw));
                                $extraClasses = trim((string) $node->getClasses());
                                $parentClass = $children ? ' ' . $menuClass . '__item--parent' : '';
                                $slug = strtolower((string) preg_replace(
                                    '/[^a-z0-9]+/i',
                                    '-',
                                    $cleanTitle
                                ));
                                $itemClass = trim(
                                    $menuClass . '__item' . $parentClass
                                    . ($extraClasses ? ' ' . $extraClasses : '')
                                    . ($slug ? ' ' . $slug : '')
                                );
                                ?>
                                <li class="<?= $escaper->escapeHtmlAttr($itemClass) ?>"
                                    data-node-id="<?= $escaper->escapeHtmlAttr($nodeId) ?>">
                                    <?php if ($children): ?>
                                        <button type="button"
                                                class="<?= $escaper->escapeHtmlAttr($menuClass) ?>__link elme-mobile-menu__row"
                                                data-node-id="<?= $escaper->escapeHtmlAttr($nodeId) ?>"
                                                @click="openPanel"
                                                aria-haspopup="true">
                                            <span class="<?= $escaper->escapeHtmlAttr($menuClass) ?>__item-text">
                                                <?= $escaper->escapeHtml($cleanTitle) ?>
                                            </span>
                                            <span class="elme-mobile-menu__chevron" aria-hidden="true">
                                                <?= $lucideIcons->chevronRightHtml('', 20, 20, ['aria-hidden' => 'true']) ?>
                                            </span>
                                        </button>
                                        <?= /* @noEscape */ $block->renderSubmenu($children, $node, $childrenLevel) ?>
                                    <?php else: ?>
                                        <?= /* @noEscape */ $block->renderMenuNode($node) ?>
                                    <?php endif; ?>
                                </li>
                            <?php endforeach; ?>
                        </ul>
                    </div>

                    <div class="elme-drawer__footer elme-mobile-menu__footer shrink-0">
                        <?= $block->getChildHtml('mobile.menu.footer') ?>
                    </div>
                </div>
            </div>
        </div>
    </dialog>
</nav>
<script>
    function initElmeMobileMenu() {
        return {
            open: false,
            stack: [],

            menuListeners: {
                ['@keydown.window.escape']() {
                    if (!this.open) {
                        return;
                    }
                    this.closeMenu();
                }
            },

            openMenu() {
                this.open = true;
                this.stack = [];
                this.syncPanels();
                if (this.$refs.drawer && !this.$refs.drawer.open) {
                    this.$refs.drawer.showModal();
                }
                document.documentElement.classList.add('elme-mobile-menu-open');
                this.$nextTick(() => {
                    if (this.$refs.drawer) {
                        hyva.trapFocus(this.$refs.drawer);
                    }
                });
            },

            closeMenu() {
                if (!this.open && !(this.$refs.drawer && this.$refs.drawer.open)) {
                    return;
                }
                this.open = false;
                this.stack = [];
                this.syncPanels();
                document.documentElement.classList.remove('elme-mobile-menu-open');
                if (this.$refs.drawer && this.$refs.drawer.open) {
                    this.$refs.drawer.close();
                }
                hyva.releaseFocus();
                this.$nextTick(() => {
                    if (this.$refs.openBtn) {
                        this.$refs.openBtn.focus();
                    }
                });
            },

            onDialogClick() {
                // Full-viewport dialog: clicks on the dimmed area (not the shell) close.
                if (this.$event.target === this.$refs.drawer) {
                    this.closeMenu();
                }
            },

            stopShellClick() {
                this.$event.stopPropagation();
            },

            openPanel() {
                const id = this.$el.dataset.nodeId;
                if (!id) {
                    return;
                }
                this.stack.push(id);
                this.syncPanels();
                this.$nextTick(() => {
                    const panel = this.$root.querySelector(
                        '.elme-mobile-menu__panel[data-panel-id="' + id + '"]'
                    );
                    const focusable = panel && panel.querySelector(
                        'button:not([disabled]), a[href]:not([tabindex="-1"])'
                    );
                    if (focusable) {
                        focusable.focus();
                    }
                });
            },

            goBack() {
                if (!this.stack.length) {
                    return;
                }
                this.stack.pop();
                this.syncPanels();
            },

            syncPanels() {
                const stack = this.stack;
                const top = stack.length ? stack[stack.length - 1] : null;
                this.$root.querySelectorAll('.elme-mobile-menu__panel').forEach((panel) => {
                    const id = panel.getAttribute('data-panel-id');
                    const isRoot = id === 'root';
                    const isTop = top === null ? isRoot : id === top;
                    const isAncestor = !isRoot && stack.indexOf(id) !== -1;
                    panel.classList.toggle('is-active', isTop);
                    panel.classList.toggle('is-open', isAncestor || isTop);
                    panel.hidden = !(isTop || isAncestor || isRoot);
                    if (isRoot) {
                        panel.hidden = false;
                        panel.classList.toggle('is-covered', top !== null);
                    }
                });
            }
        };
    }

    window.addEventListener(
        'alpine:init',
        () => Alpine.data('initElmeMobileMenu', initElmeMobileMenu),
        {once: true}
    );
</script>
<?php $hyvaCsp->registerInlineScript() ?>
