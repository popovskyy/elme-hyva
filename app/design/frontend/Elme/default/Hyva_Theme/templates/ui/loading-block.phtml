<?php
/**
 * Elme: in-panel loading overlay.
 * Parent Alpine component must expose isLoading.
 */

declare(strict_types=1);

use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;

/** @var Template $block */
/** @var Escaper $escaper */
?>
<template x-if="isLoading">
    <div class="elme-loader elme-loader--overlay" role="status" aria-live="polite" aria-busy="true">
        <span class="elme-spinner" aria-hidden="true"></span>
        <span class="sr-only"><?= $escaper->escapeHtml(__('Loading…')) ?></span>
    </div>
</template>
