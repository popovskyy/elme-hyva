<?php
/**
 * Canonical link of a public CMS content page: absolute self URL without a query string (ContentPage).
 * Magento prints none for CMS pages; FE-55 may replace this with a site-wide one.
 */

declare(strict_types=1);

use Elme\Theme\ViewModel\ContentPage;
use Hyva\Theme\Model\ViewModelRegistry;
use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;

/** @var Template $block */
/** @var Escaper $escaper */
/** @var ViewModelRegistry $viewModels */

$page = $viewModels->require(ContentPage::class);
?>
<link rel="canonical" href="<?= $escaper->escapeUrl($page->getCanonicalUrl()) ?>"/>
