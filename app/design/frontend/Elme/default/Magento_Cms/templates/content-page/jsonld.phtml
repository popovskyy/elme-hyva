<?php
/**
 * Page-level JSON-LD of a public CMS content page: WebPage (or the `schema_type` block argument, e.g.
 * ContactPage) + BreadcrumbList. Never paste JSON-LD into CMS HTML.
 * FE-67 Become a Stockist adds HowTo into the same @graph (help handle loads after the page-id
 * layout, so the page-specific jsonld template override is not reliable here).
 */

declare(strict_types=1);

use Elme\Theme\ViewModel\BecomeStockist;
use Elme\Theme\ViewModel\ContentPage;
use Hyva\Theme\Model\ViewModelRegistry;
use Magento\Framework\View\Element\Template;

/** @var Template $block */
/** @var ViewModelRegistry $viewModels */

$page = $viewModels->require(ContentPage::class);
$schemaType = (string)($block->getData('schema_type') ?: 'WebPage');
$json = $page->getIdentifier() === 'become-a-stockist'
    ? $viewModels->require(BecomeStockist::class)->getJsonLdScript()
    : $page->getJsonLdScript($schemaType);
?>
<script type="application/ld+json"><?= /* @noEscape */ $json ?></script>
