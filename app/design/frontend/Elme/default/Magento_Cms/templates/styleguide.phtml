<script>
    // Demo only: fakes an 800ms add-to-cart request, then shows "Added" for 1.5s
    function initElmeStyleguideAddDemo() {
        return {
            state: 'idle',
            announcement: '',
            timer: null,

            add() {
                clearTimeout(this.timer);
                this.state = 'loading';
                this.announcement = '';
                this.timer = setTimeout(() => this.done(), 800);
            },

            done() {
                this.state = 'done';
                this.announcement = '<?= $escaper->escapeJs(__('Added to cart')) ?>';
                this.timer = setTimeout(() => {
                    this.state = 'idle';
                }, 1500);
            },

            isLoading() {
                return this.state === 'loading';
            },

            buttonClasses() {
                return {'is-done': this.state === 'done'};
            }
        }
    }

    window.addEventListener('alpine:init', () => Alpine.data('initElmeStyleguideAddDemo', initElmeStyleguideAddDemo), {once: true});
</script>
