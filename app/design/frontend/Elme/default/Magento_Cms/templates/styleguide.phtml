<script>
    function initElmeStyleguideFeedback() {
        return {
            toastSuccess() {
                this.$dispatch('elme-toast', {
                    type: 'success',
                    text: '<?= $escaper->escapeJs(__('Saved to your shopping list.')) ?>'
                });
            },
            toastError() {
                this.$dispatch('elme-toast', {
                    type: 'error',
                    text: '<?= $escaper->escapeJs(__('Could not update your cart. Please try again.')) ?>'
                });
            },
            toastNotice() {
                this.$dispatch('elme-toast', {
                    type: 'notice',
                    text: '<?= $escaper->escapeJs(__('Add $120.00 more to place your order.')) ?>'
                });
            },
            toastWarning() {
                this.$dispatch('elme-toast', {
                    type: 'warning',
                    text: '<?= $escaper->escapeJs(__('Only 4 left in stock for this finish.')) ?>'
                });
            }
        }
    }

    function initElmeStyleguideLoader() {
        return {
            pageLoading: false,
            timer: null,
            flashPageLoader() {
                clearTimeout(this.timer);
                this.pageLoading = true;
                this.timer = setTimeout(() => {
                    this.pageLoading = false;
                }, 1200);
            }
        }
    }

    window.addEventListener('alpine:init', () => {
        Alpine.data('initElmeStyleguideFeedback', initElmeStyleguideFeedback);
        Alpine.data('initElmeStyleguideLoader', initElmeStyleguideLoader);
    }, {once: true});
</script>
