declare(strict_types=1);

use Elme\ThirdParty\ViewModel\Config as ThirdPartyConfig;
use Hyva\Theme\Model\ViewModelRegistry;
use Hyva\Theme\ViewModel\HyvaCsp;
use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;

/** @var Template $block */
/** @var Escaper $escaper */
/** @var HyvaCsp $hyvaCsp */
/** @var ViewModelRegistry $viewModels */

/** @var ThirdPartyConfig $thirdParty */
$thirdParty = $viewModels->require(ThirdPartyConfig::class);
$companyId = $thirdParty->getKlaviyoPublicApiKey();
$listId = $thirdParty->getOutletListId();

if ($companyId === '' || $listId === '') {
    return;
}

$privacyUrl = $block->getUrl('privacy-policy');
$actionUrl = $block->getUrl('elme_third_party/outlet/subscribe');
?>
<section class="elme-outlet-signup container py-8 lg:py-12"
         aria-labelledby="elme-outlet-signup-heading"
         x-data="initElmeOutletSignup">
    <div class="mx-auto w-full max-w-md rounded-sm bg-primary px-5 py-8 text-white lg:px-8 lg:py-10">
        <h2 id="elme-outlet-signup-heading"
            class="m-0 mb-6 text-center font-heading text-h3 font-medium text-white lg:text-h3-desktop">
            <?= $escaper->escapeHtml(__('Sign Up For Outlet Updates')) ?>
        </h2>

        <div class="mb-0 text-center text-copy text-white"
             role="status"
             aria-live="polite"
             x-show="isSuccess"
             x-cloak>
            <p class="m-0" x-text="message"></p>
        </div>

        <form class="elme-outlet-signup__form flex flex-col gap-4"
              action="<?= $escaper->escapeUrl($actionUrl) ?>"
              method="post"
              novalidate
              x-show="isFormVisible"
              @submit.prevent="submitForm">
            <?= $block->getBlockHtml('formkey') ?>
            <div class="field">
                <label class="sr-only" for="elme-outlet-first-name">
                    <?= $escaper->escapeHtml(__('First Name')) ?>
                </label>
                <input id="elme-outlet-first-name"
                       class="form-input w-full border-0 bg-white text-ink"
                       type="text"
                       name="first_name"
                       required
                       autocomplete="given-name"
                       placeholder="<?= $escaper->escapeHtmlAttr(__('First Name')) ?>"
                       :aria-invalid="isInvalid"
                       @input="clearError">
            </div>
            <div class="field">
                <label class="sr-only" for="elme-outlet-last-name">
                    <?= $escaper->escapeHtml(__('Last Name')) ?>
                </label>
                <input id="elme-outlet-last-name"
                       class="form-input w-full border-0 bg-white text-ink"
                       type="text"
                       name="last_name"
                       required
                       autocomplete="family-name"
                       placeholder="<?= $escaper->escapeHtmlAttr(__('Last Name')) ?>"
                       :aria-invalid="isInvalid"
                       @input="clearError">
            </div>
            <div class="field">
                <label class="sr-only" for="elme-outlet-email">
                    <?= $escaper->escapeHtml(__('Email')) ?>
                </label>
                <input id="elme-outlet-email"
                       class="form-input w-full border-0 bg-white text-ink"
                       type="email"
                       name="email"
                       required
                       autocomplete="email"
                       inputmode="email"
                       spellcheck="false"
                       placeholder="<?= $escaper->escapeHtmlAttr(__('Email')) ?>"
                       :aria-invalid="isInvalid"
                       @input="clearError">
            </div>
            <div class="field">
                <label class="sr-only" for="elme-outlet-phone">
                    <?= $escaper->escapeHtml(__('Phone Number')) ?>
                </label>
                <input id="elme-outlet-phone"
                       class="form-input w-full border-0 bg-white text-ink"
                       type="tel"
                       name="phone"
