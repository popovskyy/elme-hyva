            <?= $escaper->escapeHtml(__(
                'JavaScript is required to sign up for outlet updates. Enable JavaScript or contact us.'
            )) ?>
        </p>
    </noscript>
</section>
<script>
    function initElmeOutletSignup() {
        const emailPattern = /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/;

        return {
            status: '',
            message: '',

            isLoading() {
                return this.status === 'loading';
            },
            isNotLoading() {
                return this.status !== 'loading';
            },
            isInvalid() {
                return this.status === 'invalid';
            },
            isSuccess() {
                return this.status === 'success';
            },
            isFormVisible() {
                return this.status !== 'success';
            },
            statusClass() {
                return {
                    'text-error-text': this.status === 'invalid' || this.status === 'error',
                    'text-success-text': this.status === 'success',
                    'text-white': this.status === 'loading' || this.status === ''
                };
            },
            clearError() {
                if (this.status === 'invalid' || this.status === 'error') {
                    this.status = '';
                    this.message = '';
                }
            },
            validate(form) {
                const first = form.elements.first_name;
                const last = form.elements.last_name;
                const email = form.elements.email;
                const phone = form.elements.phone;

                first.value = first.value.trim();
                last.value = last.value.trim();
                email.value = email.value.trim();
                phone.value = phone.value.trim();

                if (first.value === '') {
                    first.focus();
                    return '<?= $escaper->escapeJs(__('Please enter your first name.')) ?>';
                }
                if (last.value === '') {
                    last.focus();
                    return '<?= $escaper->escapeJs(__('Please enter your last name.')) ?>';
                }
                if (email.value === '' || !email.validity.valid || !emailPattern.test(email.value)) {
                    email.focus();
                    return '<?= $escaper->escapeJs(__('Please enter a valid email address.')) ?>';
                }
                if (phone.value === '') {
                    phone.focus();
                    return '<?= $escaper->escapeJs(__('Please enter a valid phone number.')) ?>';
                }
                return '';
            },
            submitForm() {
                if (this.isLoading()) {
                    return;
                }
                const form = this.$root.querySelector('form');
                const error = this.validate(form);
                if (error) {
                    this.status = 'invalid';
                    this.message = error;
                    return;
                }

                const body = new FormData(form);
                body.set('form_key', hyva.getFormKey());
                this.status = 'loading';
                this.message = '';

                fetch(form.action, {
                    method: 'POST',
                    body,
                    headers: {'X-Requested-With': 'XMLHttpRequest'}
                })
                    .then((response) => response.json().then((data) => ({ok: response.ok, data})))
                    .then((result) => {
                        if (result.data && result.data.success) {
                            this.status = 'success';
                            this.message = String(result.data.message || '');
                            return;
                        }
                        this.status = 'error';
                        this.message = String(
                            (result.data && result.data.message)
                            || '<?= $escaper->escapeJs(__('Something went wrong with the signup. Please try again.')) ?>'
                        );
                    })
                    .catch(() => {
                        this.status = 'error';
                        this.message = '<?= $escaper->escapeJs(__(
                            'Something went wrong with the signup. Please try again.'
                        )) ?>';
                    });
            }
        };
    }

    window.addEventListener(
        'alpine:init',
        () => Alpine.data('initElmeOutletSignup', initElmeOutletSignup),
        {once: true}
    );
</script>
<?php $hyvaCsp->registerInlineScript() ?>
