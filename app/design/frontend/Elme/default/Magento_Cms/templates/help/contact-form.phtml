<script>
    function initElmeContactForm() {
        return {
            maxLength: 200,
            messageLength: 0,
            submitting: false,
            sent: false,
            submitIdleLabel: '<?= $escaper->escapeJs(__('Submit')) ?>',
            submitBusyLabel: '<?= $escaper->escapeJs(__('Sending…')) ?>',
            charsLeftSuffix: '<?= $escaper->escapeJs(__('characters left')) ?>',
            headingForm: '<?= $escaper->escapeJs(__('Send us a message')) ?>',
            headingSent: '<?= $escaper->escapeJs(__('Message sent')) ?>',

            init() {
                const root = this.$root;
                this.maxLength = parseInt(root.dataset.maxLength || '200', 10);
                this.messageLength = Math.min(
                    parseInt(root.dataset.initialLength || '0', 10),
                    this.maxLength
                );
                this.sent = root.dataset.sent === '1';
            },

            isSuccessHidden() {
                return !this.sent;
            },

            isFormHidden() {
                return this.sent;
            },

            isSubmitting() {
                return this.submitting;
            },

            headingLabel() {
                return this.sent ? this.headingSent : this.headingForm;
            },

            remainingLabel() {
                const left = Math.max(0, this.maxLength - this.messageLength);
                return left + ' ' + this.charsLeftSuffix;
            },

            submitLabel() {
                return this.submitting ? this.submitBusyLabel : this.submitIdleLabel;
            },

            onMessageInput() {
                const el = this.$event.target;
                let value = el.value || '';
                if (value.length > this.maxLength) {
                    value = value.slice(0, this.maxLength);
                    el.value = value;
                }
                this.messageLength = value.length;
            },

            onSubmit() {
                if (this.submitting) {
                    this.$event.preventDefault();
                    return;
                }
                const form = this.$event.target;
                if (form && typeof form.checkValidity === 'function' && !form.checkValidity()) {
                    this.$event.preventDefault();
                    form.reportValidity();
                    return;
                }
                this.submitting = true;
            },

            showFormAgain() {
                this.sent = false;
                if (window.history && window.history.replaceState) {
                    const url = new URL(window.location.href);
                    url.searchParams.delete('sent');
                    url.searchParams.delete('topic');
                    window.history.replaceState({}, '', url.pathname + url.search + '#elme-contact-form');
                }
            }
        };
    }
    window.addEventListener(
        'alpine:init',
        () => Alpine.data('initElmeContactForm', initElmeContactForm),
        { once: true }
    );
</script>
<?php $hyvaCsp->registerInlineScript() ?>
