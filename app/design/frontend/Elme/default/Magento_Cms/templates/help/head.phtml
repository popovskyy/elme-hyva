<?php
/**
 * FE-45: Open Graph / Twitter for help pages (FE-55 may later supply a default og:image).
 */

declare(strict_types=1);

use Elme\Theme\ViewModel\HelpPages;
use Hyva\Theme\Model\ViewModelRegistry;
use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;

/** @var Template $block */
/** @var Escaper $escaper */
/** @var ViewModelRegistry $viewModels */

$help = $viewModels->require(HelpPages::class);
if (!$help->isHelpPage()) {
    return;
}

$title = $help->getMetaTitle();
$description = $help->getMetaDescription();
$url = $help->getCanonicalUrl();
?>
<meta property="og:type" content="<?= $escaper->escapeHtmlAttr($help->getOgType()) ?>"/>
<meta property="og:locale" content="<?= $escaper->escapeHtmlAttr($help->getOgLocale()) ?>"/>
<meta property="og:url" content="<?= $escaper->escapeUrl($url) ?>"/>
<meta property="og:title" content="<?= $escaper->escapeHtmlAttr($title) ?>"/>
<?php if ($description !== ''): ?>
<meta property="og:description" content="<?= $escaper->escapeHtmlAttr($description) ?>"/>
<?php endif; ?>
<meta name="twitter:card" content="summary"/>
<meta name="twitter:title" content="<?= $escaper->escapeHtmlAttr($title) ?>"/>
<?php if ($description !== ''): ?>
<meta name="twitter:description" content="<?= $escaper->escapeHtmlAttr($description) ?>"/>
<?php endif; ?>
