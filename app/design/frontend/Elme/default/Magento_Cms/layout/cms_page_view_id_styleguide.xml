<?xml version="1.0"?>
<!-- /styleguide: every UI kit component and state on one page for QA; noindex, not linked anywhere -->
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <head>
        <!-- cms_page is removed below, and with it the title it sets from the CMS page -->
        <title>Style guide</title>
        <meta name="robots" content="NOINDEX,NOFOLLOW"/>
    </head>
    <body>
        <referenceBlock name="cms_page" remove="true"/>
        <!-- the head title would also render as a second H1; the template has its own -->
        <referenceBlock name="page.main.title" remove="true"/>
        <referenceContainer name="content">
            <block name="elme.styleguide" template="Magento_Cms::styleguide.phtml"/>
            <!-- FE-13: shared CMS blocks for visual QA -->
            <block class="Magento\Cms\Block\Block"
                   name="elme.styleguide.our.difference"
                   after="elme.styleguide">
                <arguments>
                    <argument name="block_id" xsi:type="string">our_difference</argument>
                </arguments>
            </block>
            <block class="Magento\Cms\Block\Block"
                   name="elme.styleguide.need.assistance"
                   after="elme.styleguide.our.difference">
                <arguments>
                    <argument name="block_id" xsi:type="string">need_assistance</argument>
                </arguments>
            </block>
        </referenceContainer>
        <referenceContainer name="before.body.end">
            <block name="elme.qty-stepper.js" template="Magento_Theme::elme/qty-stepper-js.phtml"/>
        </referenceContainer>
    </body>
</page>
