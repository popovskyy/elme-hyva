<?xml version="1.0"?>
<!-- /styleguide: every UI kit component and state on one page for QA; noindex, not linked anywhere -->
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <head>
        <meta name="robots" content="NOINDEX,NOFOLLOW"/>
    </head>
    <body>
        <referenceBlock name="cms_page" remove="true"/>
        <referenceContainer name="content">
            <block name="elme.styleguide" template="Magento_Cms::styleguide.phtml"/>
        </referenceContainer>
        <referenceContainer name="before.body.end">
            <block name="elme.qty-stepper.js" template="Magento_Theme::elme/qty-stepper-js.phtml"/>
        </referenceContainer>
    </body>
</page>
