<?xml version="1.0"?>
<!-- FE-13: shared CMS blocks above the footer on the home page (also on PDP / styleguide).
     Home scroll motion: Magento_Theme::html/home-motion.phtml. -->
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceContainer name="content">
            <!-- FE-12: curated Instagram slider before Our Difference (production order). -->
            <block class="Bart\ContentStudio\Block\Entry"
                   name="elme.instagram.slider"
                   after="-">
                <arguments>
                    <argument name="identifier" xsi:type="string">home-instagram-slider</argument>
                </arguments>
            </block>
            <block class="Magento\Cms\Block\Block"
                   name="elme.our.difference"
                   after="elme.instagram.slider">
                <arguments>
                    <argument name="block_id" xsi:type="string">our_difference</argument>
                </arguments>
            </block>
            <block class="Magento\Cms\Block\Block"
                   name="elme.need.assistance"
                   after="elme.our.difference">
                <arguments>
                    <argument name="block_id" xsi:type="string">need_assistance</argument>
                </arguments>
            </block>
        </referenceContainer>
        <referenceContainer name="before.body.end">
            <block class="Magento\Framework\View\Element\Template"
                   name="elme.home.motion"
                   template="Magento_Theme::html/home-motion.phtml"/>
        </referenceContainer>
    </body>
</page>
