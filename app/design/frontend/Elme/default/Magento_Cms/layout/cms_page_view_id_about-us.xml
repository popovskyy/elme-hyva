<?xml version="1.0"?>
<!--
/**
 * FE-61: About us — banner + breadcrumbs, Content Studio sections, FE-13 foot, JSON-LD / OG.
 */
-->
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <update handle="elme_content_page_seo"/>
    <head>
        <!-- FE-100: Fraunces for About hero -->
        <font src="fonts/fraunces/fraunces-latin-soft-normal.woff2"/>
    </head>
    <body>
        <referenceBlock name="content.page.jsonld">
            <arguments>
                <argument name="schema_type" xsi:type="string">AboutPage</argument>
            </arguments>
        </referenceBlock>

        <referenceContainer name="content">
            <block class="Magento\Cms\Block\Block"
                   name="elme.about.our.difference"
                   after="-">
                <arguments>
                    <argument name="block_id" xsi:type="string">our_difference</argument>
                </arguments>
            </block>
            <block class="Magento\Cms\Block\Block"
                   name="elme.about.need.assistance"
                   after="elme.about.our.difference">
                <arguments>
                    <argument name="block_id" xsi:type="string">need_assistance</argument>
                </arguments>
            </block>
        </referenceContainer>
    </body>
</page>
