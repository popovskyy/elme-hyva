<?xml version="1.0"?>
<!--
/**
 * FE-45 Help page shell: two-column layout, curated side nav, assistance strip, JSON-LD / OG.
 * Applied via Elme\Theme\Observer\AddHelpPageHandle on curated help identifiers.
 */
-->
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <update handle="elme_content_page_seo"/>
    <body>
        <!-- Title lives in main so mobile (sidebar order -1) shows Help control above the H1 -->
        <move element="page.main.title" destination="main" before="-"/>

        <referenceBlock name="page.main.title">
            <arguments>
                <argument name="css_class" xsi:type="string">elme-help__title mb-4 md:mb-6</argument>
                <argument name="wrapper_css_classes" xsi:type="string">elme-help__title-wrap</argument>
            </arguments>
            <block name="help.on.this.page"
                   as="help.on.this.page"
                   template="Magento_Cms::help/on-this-page.phtml"
                   after="-"/>
        </referenceBlock>

        <referenceContainer name="sidebar.main">
            <block name="help.sidebar"
                   template="Magento_Cms::help/sidebar.phtml"
                   before="-">
                <block name="help.menu"
                       as="menu"
                       template="Magento_Cms::help/menu.phtml"/>
                <block name="help.assistance"
                       as="assistance"
                       template="Magento_Theme::html/need-assistance.phtml"/>
            </block>
        </referenceContainer>

        <referenceContainer name="sidebar.additional" remove="true"/>
    </body>
</page>
