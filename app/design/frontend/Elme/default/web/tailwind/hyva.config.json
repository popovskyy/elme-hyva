{
  "notice": [
    "This is a complementary config file for Tailwind v4 and is not a replacement for the Tailwind v3 config file.",
    "For usage, see the docs: https://docs.hyva.io/hyva-themes/working-with-tailwindcss/using-hyva-modules/"
  ],
  "tailwind": {
    "include": [
      {
        "src": "vendor/hyva-themes/magento2-default-theme"
      },
      {
        "src": "app/code/Elme/LoginOnly"
      },
      {
        "src": "app/code/Elme/Checkout"
      },
      {
        "src": "app/code/Elme/Theme"
      },
      {
        "src": "app/code/Elme/QuickOrder"
      },
      {
        "src": "app/code/Elme/RecentlyViewed"
      },
      {
        "src": "app/code/Elme/StoreLocator"
      },
      {
        "src": "app/code/Bart/ContentStudio/view/frontend"
      },
      {
        "src": "app/code/Bart/ContentStudio/Controller/Adminhtml/Entry/PreviewFrame.php"
      }
    ],
    "exclude": [
      {
        "src": "vendor/snowdog/module-menu",
        "comment": "Snowdog TW source uses hover:snowdog-menu-text-hover (@apply) which fails on Tailwind v4; Elme ships its own menu CSS (FE-08/FE-09)"
      }
    ]
  },
  "tokens": {
    "values": {
      "color": {
        "primary": "#3A3935",
        "on-primary": "#FFFFFF",
        "secondary": "#ADBBA1",
        "on-secondary": "#3A3935",
        "tertiary": "#D4C8B3",
        "accent": "#98A8BB",
        "accent-dark": "#68839C",
        "ink": "#3A3935",
        "ink-muted": "#676F78",
        "ink-subtle": "#6D7074",
        "link-hover": "#5F6E67",
        "page": "#F5F4EF",
        "surface": "#FFFFFF",
        "surface-muted": "#F8F8F8",
        "sand-light": "#E1DBD1",
        "sand-faint": "#FAF9F4",
        "cool-light": "#ECEFF1",
        "border": "#CAC9C9",
        "border-light": "#D3D6D9",
        "divider": "#DCDCDC",
        "placeholder": "#646D76",
        "success": "#00BC37",
        "success-light": "#C5EAD6",
        "olive": "#647455",
        "warning": "#F2B20C",
        "warning-light": "#FDDCC7",
        "error": "#FF5942",
        "error-strong": "#CA280A",
        "error-light": "#FFC3B8",
        "promo": "#CB4867",
        "toast-success": "#E2E8DB",
        "toast-success-mark": "#5D6C4F",
        "toast-error": "#F1DDD5",
        "toast-error-mark": "#A5473B",
        "toast-warning": "#EEE6D6",
        "toast-warning-mark": "#7A5F34",
        "toast-help": "#E1E7EC",
        "toast-help-mark": "#4E6579"
      },
      "text": {
        "display": "2.25rem",
        "display--line-height": "1.15",
        "display-desktop": "3.5rem",
        "h1": "1.75rem",
        "h1--line-height": "1.2",
        "h1-desktop": "2.5rem",
        "h2": "1.375rem",
        "h2--line-height": "1.25",
        "h2-desktop": "1.75rem",
        "h3": "1.125rem",
        "h3--line-height": "1.25",
        "h3-desktop": "1.375rem",
        "h4": "1rem",
        "h4--line-height": "1.25",
        "h4-desktop": "1.125rem",
        "body": "1rem",
        "body--line-height": "1.5",
        "copy": "0.875rem",
        "copy--line-height": "1.45",
        "copy-desktop": "0.9375rem",
        "note": "0.8125rem",
        "note--line-height": "1.4",
        "label": "0.6875rem",
        "label--line-height": "1.4"
      },
      "category-banner": {
        "content-max": "36rem",
        "height": "15rem",
        "height-desktop": "28rem",
        "radius": "1rem"
      },
      "breakpoint": {
        "sm": "480px",
        "md": "768px",
        "lg": "1025px",
        "xl": "1280px",
        "2xl": "1440px",
        "3xl": "1920px"
      },
      "container": {
        "max-width": "1920px",
        "gutter": "20px",
        "gutter-desktop": "40px"
      },
      "aside": {
        "width": "240px",
        "width-desktop": "288px"
      },
      "help": {
        "main-max": "42.5rem",
        "content-max": "52rem",
        "shell-max": "79rem"
      },
      "content": {
        "measure": "50rem"
      },
      "radius": {
        "xs": "0px",
        "sm": "0px",
        "md": "0px",
        "lg": "0px",
        "xl": "0px",
        "2xl": "0px",
        "3xl": "0px",
        "4xl": "0px",
        "menu": "0px",
        "menu-promo": "0px"
      },
      "form": {
        "radius": "1px",
        "stroke": "#8A8888",
        "bg": "transparent",
        "color": "#3A3935",
        "active-color": "#3A3935",
        "py": "14px",
        "px": "12px",
        "height": "50px"
      },
      "btn": {
        "min-height": "50px",
        "padding-x": "24px",
        "font-size": "0.9375rem",
        "letter-spacing": "0.5px"
      },
      "ease": {
        "out-quad": "cubic-bezier(.25, .46, .45, .94)",
        "out-cubic": "cubic-bezier(.215, .61, .355, 1)",
        "out-quart": "cubic-bezier(.165, .84, .44, 1)",
        "out-quint": "cubic-bezier(.23, 1, .32, 1)",
        "out-expo": "cubic-bezier(.19, 1, .22, 1)",
        "out-back": "cubic-bezier(.34, 1.56, .64, 1)",
        "in-out-cubic": "cubic-bezier(.645, .045, .355, 1)",
        "in-out-quart": "cubic-bezier(.77, 0, .175, 1)",
        "in-quart": "cubic-bezier(.895, .03, .685, .22)"
      },
      "transition-duration": {
        "micro": "120ms",
        "fast": "180ms",
        "base": "240ms",
        "slow": "300ms"
      }
    }
  },
  "fonts": [
    {
      "provider": "local",
      "name": "Figtree",
      "cssVariable": "--font-sans",
      "fallbacks": [
        "ui-sans-serif",
        "system-ui",
        "sans-serif"
      ],
      "preload": false,
      "variants": [
        {
          "weight": "300",
          "style": "normal",
          "src": "figtree/Figtree-Light.woff2"
        },
        {
          "weight": "400",
          "style": "normal",
          "src": "figtree/Figtree-Regular.woff2"
        },
        {
          "weight": "500",
          "style": "normal",
          "src": "figtree/Figtree-Medium.woff2"
        },
        {
          "weight": "600",
          "style": "normal",
          "src": "figtree/Figtree-SemiBold.woff2"
        },
        {
          "weight": "700",
          "style": "normal",
          "src": "figtree/Figtree-Bold.woff2"
        },
        {
          "weight": "800",
          "style": "normal",
          "src": "figtree/Figtree-ExtraBold.woff2"
        }
      ]
    },
    {
      "provider": "local",
      "name": "FigtreeHeading",
      "cssVariable": "--font-heading",
      "fallbacks": [
        "ui-sans-serif",
        "system-ui",
        "sans-serif"
      ],
      "variants": [
        {
          "weight": "400",
          "style": "normal",
          "src": "figtree/Figtree-Medium.woff2"
        },
        {
          "weight": "400",
          "style": "italic",
          "src": "figtree/Figtree-MediumItalic.woff2"
        }
      ]
    }
  ]
}
