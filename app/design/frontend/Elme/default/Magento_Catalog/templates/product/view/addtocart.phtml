declare(strict_types=1);

/**
 * Elme: copy of Hyvä 1.5.3. FE-70: "Add to Cart" carries btn-atc (AJAX add + animated sending / Added
 * states, see Magento_Theme::elme/atc-button.phtml). "Update item" (cart item configure) keeps the
 * normal post, because updateItemOptions answers with a redirect. FE-27 rebuilds the buy box and must
 * keep btn-atc on its add to cart button.
 */

use Hyva\Theme\Model\ViewModelRegistry;
use Hyva\Theme\ViewModel\LucideIcons;
use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;

/** @var Template $block */
/** @var Escaper $escaper */
/** @var ViewModelRegistry $viewModels */

/** @var LucideIcons $lucideIcons */
$lucideIcons = $viewModels->require(LucideIcons::class);

$isCartConfigure = (bool) $block->getData('is_cart_configure');
$buttonLabel = $isCartConfigure
    ? __('Update item')
    : __('Add to Cart');
?>

<button
    type="submit"
    form="product_addtocart_form"
    aria-label="<?= $escaper->escapeHtmlAttr($buttonLabel) ?>"
    class="btn btn-primary<?= $isCartConfigure ? '' : ' btn-atc' ?>"
    id="product-addtocart-button"
    data-addto="cart"
>
    <?= $lucideIcons->shoppingCartHtml('', 24, 24, ['aria-hidden' => 'true']); ?>
    <span class="hidden sm:block md:hidden lg:block"><?= $escaper->escapeHtml($buttonLabel) ?></span>
</button>

<?= $block->getChildHtml('', true) ?>
