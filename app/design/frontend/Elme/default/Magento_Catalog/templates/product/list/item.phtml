declare(strict_types=1);

/**
 * Elme FE-19: the shared product card (PLP, search, carousels, wishlist), built on Hyvä 1.5.3's tile.
 *
 * White image tile with one badge (Sale / New), name (2 lines), SKU, price, stock
 * label. Logged in, when "Quick order on PLP" is on (Stores > Configuration > Elme > Catalog),
 * a qty stepper in MOQ multiples and Add to Cart. With that switch off, neither is on the tile.
 *
 * FE-53: guests get "Sign in to see pricing" (Elme\LoginOnly\Plugin\PriceRenderPlugin) and no form; logged-in
 * customers get a price placeholder that loads their own price after render. FE-70: the Add to Cart button
 * keeps btn-atc (AJAX + animation, Magento_Theme::elme/atc-button.phtml). Look: web/tailwind/elme/product-card.css.
 * No core wishlist heart, compare or review summary. Those get custom Elme features later.
 */

use Elme\LoginOnly\ViewModel\LoginOnly;
use Elme\QtyRules\Model\QtyRules;
use Elme\Theme\ViewModel\ProductTile;
use Hyva\Theme\Model\ViewModelRegistry;
use Hyva\Theme\ViewModel\BlockJsDependencies;
use Hyva\Theme\ViewModel\LucideIcons;
use Hyva\Theme\ViewModel\ProductListItem;
use Hyva\Theme\ViewModel\ProductPage;
use Magento\Catalog\Block\Product\View;
use Magento\Catalog\Helper\Output as CatalogOutputHelper;
use Magento\Catalog\ViewModel\Product\OptionsData as ProductOptionsData;
use Magento\Framework\Escaper;

// phpcs:disable Magento2.Templates.ThisInTemplate.FoundThis
// phpcs:disable Magento2.Templates.ThisInTemplate.FoundHelper
// phpcs:disable Generic.Files.LineLength.TooLong

/** @var View $block */
/** @var Escaper $escaper */
/** @var ViewModelRegistry $viewModels */

/** @var ProductPage $productViewModel */
$productViewModel = $viewModels->require(ProductPage::class);
/** @var ProductListItem $productListItemViewModel */
$productListItemViewModel = $viewModels->require(ProductListItem::class);
/** @var CatalogOutputHelper $catalogOutputHelper */
$catalogOutputHelper = $this->helper(CatalogOutputHelper::class);
/** @var LucideIcons $lucideIcons */
$lucideIcons = $viewModels->require(LucideIcons::class);
/** @var ProductOptionsData $productOptionsViewmodel */
$productOptionsViewmodel = $viewModels->require(ProductOptionsData::class);
/** @var LoginOnly $loginOnly */
$loginOnly = $viewModels->require(LoginOnly::class);
/** @var ProductTile $tile */
$tile = $viewModels->require(ProductTile::class);
/** @var QtyRules $qtyRulesViewModel */
$qtyRulesViewModel = $viewModels->require(QtyRules::class);

/** @var Magento\Catalog\Model\Product $product */
if (! ($product = $block->getData('product'))) {
    return;
}
$imageDisplayArea = $block->getData('image_display_area');
$viewIsGrid = $block->getData('view_mode') !== 'list';
$showDescription = $block->getData('show_description');
$hideDetails = $block->getData('hide_details') ?: false;
$productType = $product->getTypeId();
$isProductGroupedOrBundle = $productType === 'bundle' || $productType === 'grouped';
// Elme: only logged-in customers can buy, so only they get the add to cart form
$canAddToCart = $product->isSaleable() && $loginOnly->isLoggedIn();
$productId = (int) $product->getId();
$productUrl = $product->getProductUrl();
$options = $productOptionsViewmodel->getOptionsData($product);
$productName = $catalogOutputHelper->productAttribute($product, $product->getName(), 'name');
$imageCustomAttributes = $product->getData('image_custom_attributes')
    ?? $block->getData('image_custom_attributes')
    ?? [];

$badge = $tile->getBadge($product);
$stockLevel = $tile->getStockLevel($product);
$showStepper = $canAddToCart && !$isProductGroupedOrBundle && $tile->isQuickOrderEnabled();
// Quick order off: no stepper and no Add to Cart (ticket FE-19). Configure stays for grouped/bundle.
$showForm = $canAddToCart && ($showStepper || $isProductGroupedOrBundle);
$qtyRules = $canAddToCart && !$isProductGroupedOrBundle ? $qtyRulesViewModel->getMinAndStep($product) : null;

$jsDependencies = $viewModels->require(BlockJsDependencies::class);
$jsDependencies->setBlockTemplateDependency($block, 'Magento_Catalog::product/list/js/price-box.phtml');
if ($showStepper) {
    $jsDependencies->setBlockTemplateDependency($block, 'Magento_Catalog::product/list/js/qty-stepper.phtml');
}

$dataAttributes = '';
foreach ($block->getData('product_data_attributes') ?? [] as $attribute => $include) {
    if ($include) {
        $dataAttributes .= sprintf(
            ' data-%s="%s"',
            $escaper->escapeHtmlAttr($attribute),
            $escaper->escapeHtmlAttr($product->getData($attribute))
        );
    }
}
$cardClass = 'item product product-item elme-card group relative flex h-full w-full flex-col bg-surface'
    . ($viewIsGrid ? '' : ' md:flex-row');
?>
<?php if ($showForm): ?>
<form method="post"
      action="<?= $escaper->escapeUrl($productViewModel->getAddToCartUrl($product, ['useUencPlaceholder' => true])) ?>"
      class="product_addtocart_form <?= /* @noEscape */ $cardClass ?>"
      <?php if ($product->getOptions()): ?>enctype="multipart/form-data"<?php endif; ?>
      <?= /* @noEscape */ $dataAttributes ?>
>
    <?= /* @noEscape */ $block->getBlockHtml('formkey') ?>
    <input type="hidden" name="product" value="<?= $productId ?>">
    <?php foreach ($options as $optionItem): ?>
    <input type="hidden"
           name="<?= $escaper->escapeHtmlAttr($optionItem['name']) ?>"
           value="<?= $escaper->escapeHtmlAttr($optionItem['value']) ?>">
    <?php endforeach; ?>
<?php else: ?>
<div class="<?= /* @noEscape */ $cardClass ?>"<?= /* @noEscape */ $dataAttributes ?>>
<?php endif; ?>

    <div class="elme-card__media relative <?= $viewIsGrid ? '' : 'md:w-2/6 md:shrink-0' ?>">
        <a href="<?= $escaper->escapeUrl($productUrl) ?>"
           class="product photo product-item-photo block aspect-square overflow-hidden bg-surface"
           tabindex="-1"
           aria-hidden="true"
        >
            <?php if ($blockImage = $block->getImage($product, $imageDisplayArea)): ?>
                <?= $blockImage
                    ->setTemplate('Magento_Catalog::product/list/image.phtml')
                    ->setData('custom_attributes', $imageCustomAttributes)
                    ->setProductId($productId)
                    ->toHtml() ?>
            <?php endif; ?>
        </a>

        <?php if ($badge): ?>
            <span class="elme-card__badge elme-card__badge--<?= /* @noEscape */ $badge ?> absolute top-2 left-2 lg:top-3 lg:left-3">
                <?= $escaper->escapeHtml($badge === ProductTile::BADGE_SALE ? __('Sale') : __('New')) ?>
            </span>
        <?php endif; ?>
    </div>

    <div class="product-info flex grow flex-col gap-1 px-3 pt-3 pb-4 lg:px-4 lg:pb-5 <?= $viewIsGrid ? '' : 'md:w-4/6' ?>">
        <a class="product-item-link elme-card__name line-clamp-2 text-copy text-ink hover:underline lg:text-copy-desktop"
           href="<?= $escaper->escapeUrl($productUrl) ?>"
        >
            <?= /* @noEscape */ $productName ?>
        </a>

        <p class="text-note text-ink-muted">
            <span class="sr-only"><?= $escaper->escapeHtml(__('SKU')) ?></span>
            <?= $escaper->escapeHtml($product->getSku()) ?>
        </p>

        <?php if ($showDescription): ?>
            <div class="text-note text-ink-muted">
                <?= /* @noEscape */ $productViewModel->getShortDescriptionForProduct($product) ?>
            </div>
        <?php endif; ?>

        <?php if ($isProductGroupedOrBundle): ?>
            <span class="sr-only">
                <?= $escaper->escapeHtml(__('The price depends on the options chosen on the product page')) ?>
            </span>
        <?php endif; ?>

        <div class="elme-card__price mt-1"
             x-data="initPriceBox()"
             x-defer="intersect"
             @update-prices-<?= $productId ?>.window="updatePrice($event.detail);"
        >
            <?= /* @noEscape */ $productListItemViewModel->getProductPriceHtml($product) ?>
        </div>

        <?php if ($stockLevel): ?>
            <p class="elme-card__stock elme-card__stock--<?= /* @noEscape */ $stockLevel ?> flex items-center gap-1.5 text-note">
                <span class="size-1.5 shrink-0 rounded-full bg-current" aria-hidden="true"></span>
                <?= $escaper->escapeHtml($stockLevel === ProductTile::STOCK_IN ? __('In Stock') : __('Low Stock')) ?>
            </p>
        <?php endif; ?>

        <?php if ($product->isAvailable() && !$hideDetails): ?>
            <?= $block->getProductDetailsHtml($product) ?>
        <?php endif; ?>

        <?php if ($showForm): ?>
        <div class="elme-card__actions mt-auto grid gap-2 pt-3 <?= $showStepper ? '2xl:grid-cols-[auto_1fr]' : '' ?>">
            <?php if ($isProductGroupedOrBundle): ?>
                <a href="<?= $escaper->escapeUrl($productUrl) ?>"
                   class="btn btn-primary w-full text-sm"
                   aria-label="<?= $escaper->escapeHtmlAttr(__('Configure %1 on the product page', $productName)) ?>"
                >
                    <?= $escaper->escapeHtml(__('Configure')) ?>
                </a>
            <?php else: ?>
                <?php if ($showStepper): ?>
                    <?php $min = $qtyRulesViewModel->formatQty($qtyRules['min']); $step = $qtyRulesViewModel->formatQty($qtyRules['step']); ?>
                    <div class="elme-qty"
                         x-data="initElmeQtyStepper"
                         data-min="<?= $escaper->escapeHtmlAttr($min) ?>"
                         data-step="<?= $escaper->escapeHtmlAttr($step) ?>"
                    >
                        <button type="button"
                                class="elme-qty__btn"
                                @click="decrement"
                                :disabled="isAtMin"
                                aria-label="<?= $escaper->escapeHtmlAttr(__('Decrease quantity')) ?>"
                        >
                            <?= $lucideIcons->minusHtml('', 16, 16, ['aria-hidden' => 'true']) ?>
                        </button>
                        <input type="number"
                               name="qty"
                               value="<?= $escaper->escapeHtmlAttr($min) ?>"
                               min="<?= $escaper->escapeHtmlAttr($min) ?>"
                               step="<?= $escaper->escapeHtmlAttr($step) ?>"
                               inputmode="numeric"
                               class="elme-qty__input"
                               x-ref="input"
                               @change="normalize"
                               aria-label="<?= $escaper->escapeHtmlAttr(__('Quantity of %1', $productName)) ?>"
                               <?php if ((float) $step > 1): ?>
                               aria-describedby="elme-moq-<?= $productId ?>"
                               <?php endif; ?>
                        >
                        <button type="button"
                                class="elme-qty__btn"
                                @click="increment"
                                aria-label="<?= $escaper->escapeHtmlAttr(__('Increase quantity')) ?>"
                        >
                            <?= $lucideIcons->plusHtml('', 16, 16, ['aria-hidden' => 'true']) ?>
                        </button>
                    </div>
                <?php endif; ?>
                <?php /* FE-70: btn-atc = AJAX add with the animated sending / Added states (elme/atc-button.phtml) */ ?>
                <button type="submit"
                        class="btn btn-primary btn-atc elme-card__atc w-full text-sm"
                        aria-label="<?= $escaper->escapeHtmlAttr(__('Add to Cart') . ' ' . $productName) ?>"
                        data-addto="cart"
                >
                    <?= $lucideIcons->shoppingCartHtml('', 20, 20, ['aria-hidden' => 'true']) ?>
                    <span><?= $escaper->escapeHtml(__('Add to Cart')) ?></span>
                </button>
            <?php endif; ?>
        </div>
        <?php if ($qtyRules && (float) $qtyRules['step'] > 1): ?>
            <p id="elme-moq-<?= $productId ?>" class="text-note text-ink-muted">
                <?= $escaper->escapeHtml(__('Sold in multiples of %1', $qtyRulesViewModel->formatQty($qtyRules['step']))) ?>
            </p>
        <?php endif; ?>
        <?php endif; ?>
    </div>
<?php if ($showForm): ?>
</form>
<?php else: ?>
</div>
<?php endif; ?>
