<?php
/**
 * FE-18: category PLP header — title + breadcrumbs (+ description) left, image right on lg+;
 * image above the title stack on mobile. Without an image: visible H1 + crumbs (+ description).
 */

declare(strict_types=1);

use Elme\Theme\ViewModel\CategoryBanner;
use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;

/** @var Template $block */
/** @var Escaper $escaper */

/** @var CategoryBanner $banner */
$banner = $block->getData('view_model');
if (!$banner instanceof CategoryBanner || !$banner->getCategory()) {
    return;
}

$name = $banner->getName();
$headingId = $banner->getHeadingId();
$hasImage = $banner->hasImage();
$descriptionHtml = $banner->getDescriptionHtml();
$backgroundColour = $banner->getBackgroundColour();
$sectionClass = $hasImage
    ? 'category-banner category-banner--has-image'
    : 'category-banner category-banner--no-image';
?>
<section class="<?= $escaper->escapeHtmlAttr($sectionClass) ?>"
         aria-labelledby="<?= $escaper->escapeHtmlAttr($headingId) ?>"
    <?php if ($backgroundColour !== ''): ?>
         style="--category-banner-bg: <?= $escaper->escapeHtmlAttr($backgroundColour) ?>"
    <?php endif; ?>>
    <div class="category-banner__wrapper">
        <div class="category-banner__content">
            <?= $block->getChildHtml('breadcrumbs') ?>

            <div class="category-banner__title">
                <h1 id="<?= $escaper->escapeHtmlAttr($headingId) ?>"><?= $escaper->escapeHtml($name) ?></h1>
            </div>

            <?php if ($descriptionHtml !== ''): ?>
                <div class="category-banner__description prose">
                    <?= /* @noEscape */ $descriptionHtml ?>
                </div>
            <?php endif; ?>
        </div>

        <?php if ($hasImage): ?>
            <div class="category-banner__image">
                <?= $block->getChildHtml('banner_image') ?>
            </div>
        <?php endif; ?>
    </div>
</section>
