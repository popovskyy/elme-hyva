# Magento Open Source 2.4.9 + Hyvä — Elme Living
# Whitelist (same as m2-bart-group / shaw): everything else is Magento core scaffolding
# from composer (setup/, lib/, dev/, pub/, *.sample, LICENSE…) or runtime output.
*
!/.gitignore
!/README.md
!/CLAUDE.md
!/composer.json
!/composer.lock
!/auth.json.sample
!/docs
!/docs/**

!/app
!/app/*/
!/app/code/**
!/app/design/**
!/app/etc/config.php
!/app/i18n/**
!/patches
!/patches/**

!/bin
!/bin/clinotty

# Root favicon fallback so /favicon.ico never 404s (browsers request it without the theme path).
!/pub
/pub/**
!/pub/favicon.ico

# PHPUnit Allure config when the suite is run from the repo root (see elme-qa / BE unit tests).
!/allure
!/allure/allure.config.php

!/docker-compose.yml
!/magento-docker
!/magento-docker/**
/magento-docker/certs/

!/.claude
!/.claude/skills
!/.claude/skills/**
!/.claude/settings.json

# Theme build: node_modules and hyva-sources/tokens/fonts output (regenerated by npm run build).
# web/css/styles.css stays committed.
node_modules/
test-results/
/app/design/*/*/*/web/tailwind/generated/
/app/design/*/*/*/web/fonts/generated/

.DS_Store
